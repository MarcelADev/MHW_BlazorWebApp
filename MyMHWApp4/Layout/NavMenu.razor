@using static MHWApp.Library.StaticVariables
@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">@CurrentUrl</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">

        <AuthorizeView>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Start
                    </NavLink>
                </div>
            </NotAuthorized>
            <Authorized>

                @if (mainMenuActive)
                {
                    <div class="nav-item px-3">
                        <p class="userName"><b>@context.User.Identity?.Name</b></p>
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="mainmenu/createsession">
                            <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Create Session
                        </NavLink>
                    </div>

                    if(context.User.IsInRole(ADMIN_ROLE) || context.User.IsInRole(MASTER_ROLE))
                    {
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="edit/categories">
                                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Admin Pages
                            </NavLink>
                        </div>
                    }

                    if (context.User.IsInRole(MASTER_ROLE))
                    {
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="master">
                                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Master Page
                            </NavLink>
                        </div>
                    }
                }
                else if (gamePagesActive)
                {

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="inventory">
                            <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span>@INVENTORY
                        </NavLink>
                    </div>
                }
                else if (adminPagesActive && (context.User.IsInRole(ADMIN_ROLE) || context.User.IsInRole(MASTER_ROLE)))
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="edit/categories">
                            <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span>@ADMIN_CATEGORY
                        </NavLink>
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="edit/gameextensions">
                            <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span>@ADMIN_GAME_EXTENSION
                        </NavLink>
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="edit/inventoryentries">
                            <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span>@ADMIN_INVENTORY_ENTRY
                        </NavLink>
                    </div>
                }
                else if (masterPageActive && context.User.IsInRole(MASTER_ROLE))
                {

                }

                @if(createSessionPageActive || gamePagesActive || adminPagesActive || masterPageActive)
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="mainmenu">
                            <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Return to Menu
                        </NavLink>
                    </div>
                }

                @if(mainMenuActive)
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="logout">
                            <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Logout
                        </NavLink>
                    </div>
                }
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private static string HOME = "Home";

    // Session
    private static string MAIN_MENU = "Menu";
    private static string SESSION_CREATE = "Create Session";

    // Master
    private static string MASTER = "Master Page";

    // Game Pages
    private static string INVENTORY = "Inventory";

    // Admin Pages
    private static string ADMIN_CATEGORY = "Category";
    private static string ADMIN_GAME_EXTENSION = "Game Extension";
    private static string ADMIN_INVENTORY_ENTRY = "Inventory Entry";
    private static string ADMIN = "Admin";

    private bool collapseNavMenu = true;
    private string? CurrentUrl { get; set; }

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private bool mainMenuActive = true;
    private bool createSessionPageActive = false;
    private bool gamePagesActive = false;
    private bool adminPagesActive = false;
    private bool masterPageActive = false;

    protected override void OnInitialized()
    {
        // Subscribe to the LocationChanged event to update the URL dynamically
        NavigationManager.LocationChanged += OnLocationChanged;

        // Set the initial URL
        UpdateCurrentUrl(new Uri(NavigationManager.Uri).AbsolutePath);
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    // This method is triggered when the URL changes
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateCurrentUrl(new Uri(e.Location).AbsolutePath);
    }

    // Update the CurrentUrl based on the current URL
    private void UpdateCurrentUrl(string url)
    {
        CurrentUrl = url switch
        {
            "/" => HOME,
            "/mainmenu" => MAIN_MENU,
            "/mainmenu/createsession" => SESSION_CREATE,
            "/master" => MASTER,
            "/inventory" => INVENTORY,
            "/edit/categories" => ADMIN,
            "/edit/gameextensions" => ADMIN,
            "/edit/inventoryentries" => ADMIN,
            _ => "Unknown",
        };

        mainMenuActive = createSessionPageActive = gamePagesActive = adminPagesActive = masterPageActive = false;

        if (CurrentUrl == MAIN_MENU)
        { 
            mainMenuActive = true; 
        }
        else if (CurrentUrl == SESSION_CREATE)
        {
            createSessionPageActive = true;
        }
        else if (CurrentUrl == MASTER)
		{
			masterPageActive = true;
		}
        else if (CurrentUrl == INVENTORY)
        {
            gamePagesActive = true;
        }
        else if (CurrentUrl == ADMIN)
        {
            adminPagesActive = true;
        }

        StateHasChanged();  // Trigger a re-render
    }

    public void Dispose()
    {
        // Unsubscribe when the component is disposed
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
