@using MHWApp.Library.Model
@using Microsoft.AspNetCore.Components
@using MyMHWApp4.Provider
@inject PlayerProvider playerProvider

<button class="dropDown-button" type="button" @onclick="ToggleDropdown">
    Wähle die Teilnehmer
    <span class="material-symbols-outlined"><img src="~/Images/arrowDown.png" /></span>
</button>

@if (isDropdownOpen && players != null)
{
    <ul class="dropdown-list">
        @foreach(Player player in players){

            <PlayerDropDownComponent 
                IsSelected="selectedPlayers.Contains(player)"
                Player="player"
                AddPlayer="SelectPlayer"
                RemovePlayer="RemoveSelectedPlayer">
            </PlayerDropDownComponent>
        }
    </ul>
}

@code {
    private bool isDropdownOpen = false;
    List<Player>? players;

    List<Player> selectedPlayers = [];

    [Parameter]
    public required EventCallback<List<Player>> SelectedPlayersChanged { get; set; }

    protected override async Task OnInitializedAsync()
    {
        players = await playerProvider.GetPlayersAsync();
        await base.OnInitializedAsync();
    }

    private async Task OnSelectedPlayersChanged(){
        await SelectedPlayersChanged.InvokeAsync(selectedPlayers);
    }

    private void ToggleDropdown()
    {
        isDropdownOpen = !isDropdownOpen;
    }

    public async Task SelectPlayer(Player player)
    {
        if (selectedPlayers.Contains(player)) return;
        selectedPlayers.Add(player);
        await OnSelectedPlayersChanged();
    }

    public async Task RemoveSelectedPlayer(Player player)
    {
        if (!selectedPlayers.Contains(player)) return;
        selectedPlayers.Remove(player);
        await OnSelectedPlayersChanged();
    }
}