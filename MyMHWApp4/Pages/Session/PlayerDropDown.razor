@using MHWApp.Library.Model
@using Microsoft.AspNetCore.Components
@using MyMHWApp4.Provider
@inject PlayerProvider playerProvider

<!-- Button, um das Dropdown anzuzeigen/verstecken -->
<button class="dropDownButton" type="button" @onclick="ToggleDropdown">
    <div class="dropdown"></div>
    Wähle die Teilnehmer
</button>

<!-- Dropdown-Liste -->
@if (isDropdownOpen && players != null)
{
    <ul class="dropdown-list">
        @foreach(Player player in players){

            <PlayerDropDownComponent 
                IsSelected="selectedPlayers.Contains(player)"
                Player="player"
                AddPlayer="SelectPlayer"
                RemovePlayer="RemoveSelectedPlayer">
            </PlayerDropDownComponent>
        }
    </ul>
}

<AuthorizeView>
    <p>@context.User.Identity?.Name</p>
</AuthorizeView>

@foreach (Player player in selectedPlayers)
{
    <p>@player.UserName</p>
}

@code {
    private bool isDropdownOpen = false;
    List<Player>? players;
    List<Player> selectedPlayers = [];

    protected override async Task OnInitializedAsync()
    {
        players = await playerProvider.GetPlayersAsync();
        await base.OnInitializedAsync();
    }

    // Toggle-Funktion für das Dropdown
    private void ToggleDropdown()
    {
        isDropdownOpen = !isDropdownOpen;
    }

    public void SelectPlayer(Player player) 
    {
        if (selectedPlayers.Contains(player)) return;

        selectedPlayers.Add(player);

        StateHasChanged();
    }

    public void RemoveSelectedPlayer(Player player)
    {
        if (!selectedPlayers.Contains(player)) return;

        selectedPlayers.Remove(player);

        StateHasChanged();
    }
}