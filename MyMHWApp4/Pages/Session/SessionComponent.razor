@using MHWApp.Library.Model
@inject NavigationManager NavigationManager

<button class="sessionBox" @onclick="OnClick">
	
	<div class="upperRow">

		<div class="propertyBox">
			<label>Name:</label>
			<p>@Session.Name</p>
		</div>

	</div>

	<div class="lowerRow">

		<div class="propertyBox">
			<label>Weapon:</label>
			<p>Insektengleve</p>
		</div>

		<div class="daysDateContainer">

			<div class="propertyBox">
				<label>Days:</label>
				<p>@Session.DayCount/@Session.MaxDays</p>
			</div>

			<div class="propertyBox">
				<label>Date:</label>
				<p>@Session.MaxDays</p>
			</div>

		</div>
		

	</div>

</button>

@code {
	[Parameter]
	public required Session Session { get; set; }

	private void OnClick() 
	{ 
		NavigationManager.NavigateTo("/inventory");
	}
}
