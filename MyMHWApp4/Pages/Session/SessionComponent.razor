@using MHWApp.Library.Model
@using MyMHWApp4.Provider
@inject NavigationManager navigationManager
@inject ParticipatorProvider participatorProvider

<button class="sessionCard" @onclick="NavigateToInventory">

	<div class="imageContainer">
		<img src="Images/CardPicture.jpg" alt="Image not available" />
	</div>

	<h4>@Session.Name</h4>

	<div class="propertyContainer">
		<div class="labelContainer">
			<label>Weapon:</label>
		</div>
		<p>@participator.WeaponType</p>
	</div>

	<div class="propertyContainer">
		<div class="labelContainer">
			<label>Days:</label>
		</div>
		<p>@Session.DayCount/@Session.MaxDays</p>
	</div>

	<div class="propertyContainer">
		<div class="labelContainer">
			<label>Date:</label>
		</div>
		<p>@Session.Date</p>
	</div>

</button>

@code {
	[Parameter]
	public required Session Session { get; set; }
	Participator? participator = new Participator
	{
		Id = -1,
		PlayerId = -1,
		WeaponTypeId = 2
	};

	protected override async Task OnInitializedAsync()
	{
		await participatorProvider.GetParticipatorAsync(Session.Id);
		base.OnInitializedAsync();
	}

	private void NavigateToInventory() 
	{ 
		navigationManager.NavigateTo("/inventory");
	}
}
