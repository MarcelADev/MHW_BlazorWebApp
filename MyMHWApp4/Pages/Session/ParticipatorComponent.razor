@using MHWApp.Library.Model
@using MyMHWApp4.Pages.GeneralComponents.DropDown
@using MyMHWApp4.Provider
@inject WeaponProvider weaponProvider

<div class="container-participator">

	<p>@PlayerName</p>

	<div class="container-participator-dropdown">
		<DropDown 
		ValuePairList="weaponTypeValuePairs" 
		ChosenValuePair="chosenValuePair"
		ChosenValuePairChanged="HandleChosenValuePairChanged">
		</DropDown>
	</div>
</div>

@code {
	private List<WeaponType> weaponTypes = [];
	private List<ValuePair> weaponTypeValuePairs = [];
	private ValuePair? chosenValuePair = new ValuePair { Id = -1, Value = "Loading ..." };

	[Parameter]
	public required string PlayerName { get; set; }

	[Parameter]
	public required int PlayerId { get; set; }

	[Parameter]
	public required EventCallback<int[]> ChosenWeaponTypeChanged { get; set; }

	protected override async Task OnInitializedAsync()
	{
		weaponTypes = await weaponProvider.GetWeaponTypesAsync();

		foreach(WeaponType wP in weaponTypes){
			weaponTypeValuePairs.Add(new ValuePair { Id = wP.Id, Value = wP.Name });
		}

		chosenValuePair = weaponTypeValuePairs[0];

		OnChosenWeaponTypeChanged(new int[] { PlayerId, chosenValuePair.Id });

		await base.OnInitializedAsync();
	}

	public void HandleChosenValuePairChanged(ValuePair valuePair)
	{
		chosenValuePair = valuePair;
		OnChosenWeaponTypeChanged(new int[] { PlayerId, chosenValuePair.Id });
	}

	private void OnChosenWeaponTypeChanged(int[] id){
		ChosenWeaponTypeChanged.InvokeAsync(id);
	}
}
