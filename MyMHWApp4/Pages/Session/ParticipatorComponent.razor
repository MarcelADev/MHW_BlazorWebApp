@using MHWApp.Library.Model
@using MyMHWApp4.Pages.GeneralComponents.DropDown
@using MyMHWApp4.Provider
@inject WeaponProvider weaponProvider

<div class="container-participator">

	<p>@PlayerName</p>

	<div class="container-participator-dropdown">
		<DropDown 
			@ref="dropDown"
			ValuePairList="IdAndValueList" 
			ChosenTtem="chosenItem"
			ChosenItemChanged="HandleChosenItemChanged">
		</DropDown>
	</div>
</div>

@code {
	public DropDown? dropDown;

	private List<WeaponType> weaponTypeList = [];
	private List<IdAndValue> IdAndValueList = [];

	private IdAndValue? chosenItem = new IdAndValue { Id = -1, Value = "Loading ..." };

	[Parameter]
	public required string PlayerName { get; set; }

	[Parameter]
	public required int PlayerId { get; set; }

	[Parameter]
	public required EventCallback<int[]> ChosenItemChanged { get; set; }

	protected override async Task OnInitializedAsync()
	{
		weaponTypeList = await weaponProvider.GetWeaponTypesAsync();

		foreach(WeaponType wP in weaponTypeList){
			IdAndValueList.Add(new IdAndValue { Id = wP.Id, Value = wP.Name });
		}

		chosenItem = IdAndValueList[0];

		OnChosenItemChanged(new int[] { PlayerId, chosenItem.Id });

		await base.OnInitializedAsync();
	}

	public void HandleChosenItemChanged(IdAndValue valuePair)
	{
		chosenItem = valuePair;
		OnChosenItemChanged(new int[] { PlayerId, chosenItem.Id });
	}

	private void OnChosenItemChanged(int[] id){
		ChosenItemChanged.InvokeAsync(id);
	}
}
