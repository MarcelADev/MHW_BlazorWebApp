@page "/session/create"
@using MHWApp.Library.Model
@using MyMHWApp4.Pages.GeneralComponents
@using MyMHWApp4.Provider
@inject SessionProvider sessionProvider

<header class="container-center header">
    <h2>Create new Session</h2>
</header>

<main class="container-top main">    

    <InputComponentText LabelText="Name:" PlaceHolder="Session Name" PropertyChanged="HandleNameChanged"></InputComponentText>

    <InputComponentNumber LabelText="Max Days:" Input="25" PropertyChanged="HandleMaxDaysChanged"></InputComponentNumber>

    <PlayerDropDown SelectedPlayersChanged="HandleSelectedPlayersChanged"></PlayerDropDown>

    <div class="container-h3"><h3>Participators</h3></div>

    <ul class="participator-list">

        <AuthorizeView>
            <ParticipatorComponent 
            PlayerName="@(context.User.Identity?.Name)" 
            PlayerId="-1"
            ChosenWeaponTypeChanged="HandleChosenWeaponTypeChanged">
            </ParticipatorComponent>
        </AuthorizeView>

        @foreach(Player player in selectedPlayers){
            <ParticipatorComponent 
            PlayerName="player.UserName" 
            PlayerId="player.Id"
            ChosenWeaponTypeChanged="HandleChosenWeaponTypeChanged">
            </ParticipatorComponent>
        }
    </ul>

    <button class="button button-confirm theme-dark" @onclick="OnConfirmButtonClicked">Confirm</button>

</main>

@code {
    private string sessionName = "";
    private int sessionMaxDays = -1;
    private List<Player> selectedPlayers = [];
    private Dictionary<int, int> chosenWeaponTypes = [];

    private void HandleNameChanged(string newName)
    {
        sessionName = newName;
    }

    private void HandleMaxDaysChanged(int newMaxDays){
        sessionMaxDays = newMaxDays;
    }

    private void HandleSelectedPlayersChanged(List<Player> newSelectedPlayers){
        selectedPlayers = newSelectedPlayers;
        StateHasChanged();
    }

    private void HandleChosenWeaponTypeChanged(int[] id) {

        chosenWeaponTypes.Add(id[0], id[1]);        // id[0] -> player id | id[1] -> weapontype id
    }

    private void OnConfirmButtonClicked(){
        //TO DO
    }
}
