@page "/session/create"
@using MHWApp.Library.Model
@using MyMHWApp4.Provider
@inject SessionProvider sessionProvider
@inject PlayerProvider playerProvider

<main class="mainContainer">

    <h2>Create new Session</h2>

    <div>
        <label>Name:</label>
        <br />
        <input placeholder="Session Name" type="text" @bind-value="sessionName" />
    </div>

    <div>
        <label>Maximum Days::</label>
        <br />
        <input placeholder="60" type="number" @bind-value="sessionMaxDays" />
    </div>

    @if(players == null){
        <p>Loading ...</p>
    }
    else if(!players.Any()){
        <p>List is empty</p>
    }
    else {

    }

</main>

@code {
    private string sessionName = "";
    private int sessionMaxDays = -1;
    List<Player> players;

    protected async override Task OnInitializedAsync()
    {
        players = await playerProvider.GetPlayersAsync();
        await base.OnInitializedAsync();
	}
}
