@page "/session/create"
@using MHWApp.Library.Model
@using MyMHWApp4.Pages.GeneralComponents
@using MyMHWApp4.Provider
@using System.Security.Principal
@using MyMHWApp4.Utils
@inject SessionProvider sessionProvider
@inject ParticipatorProvider participatorProvider
@inject PlayerProvider playerProvider
@inject WeaponProvider weaponProvider
@inject NavigationManager navigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<CreateSession> Logger

<header class="container-center header">
    <h2>Create new Session</h2>
</header>

<main class="container-top">

    <div class="form__container">
        @if(!isLoading)
        {
            <EditForm EditContext="editContext" FormName="session" OnValidSubmit="Submit">
                <DataAnnotationsValidator />
				<ValidationSummary />

                <div class="form__field form__field-input">
                    <label for="session-name">Name</label>
                    <InputText name="session-name" @bind-Value="Model!.Name"/>
                </div>

                <div class="form__field form__field-input">
					<label for="session-max-days">Max Days</label>
                    <InputNumber name="session-max-days" @bind-Value="Model!.MaxDays"/>
                </div>

                <Select
                    Label="Select Players"
                    Placeholder="Select"
                    T="Player"
                    Options="@players"
                    OptionNameMapper="(Player player) => player.UserName"
                    OptionValueMapper="(Player player) => player.Id"
                    IsMultiple="@true"
                    ValueListChanged="HandleSelect">
                </Select>

                <div class="form__field">
                    <ParticipatorCard @bind-Value="Model!.UserParticipator" weaponTypes="weaponTypes" />
                </div>

                @for (var i = 0; i < Model!.Participators.Count; i++)
                {
                    var participator = Model!.Participators[i];

                    @if (Model!.PlayerIds.Contains(participator.PlayerId))
                    {
                        <div class="form__field">
                            <ParticipatorCard @bind-Value="participator" weaponTypes="weaponTypes" />
                        </div>
                    }
                }

                <div class=" form__field form__button">
                    <button type="submit" class="btn btn-primary">
                        Create Session
                    </button>
                </div>

            </EditForm>
        }
    </div>

    <InputComponentText @ref="inputName" LabelText="Name:" PlaceHolder="Session Name"></InputComponentText>

    <InputComponentNumber @ref="inputMaxDays" LabelText="Max Days:" DefaultValue="25"></InputComponentNumber>

    <PlayerDropDown SelectedPlayersChanged="HandleSelectedPlayersChanged"></PlayerDropDown>

    <div class="container-h3 margin-h3"><h3>Participators</h3></div>

    <ul class="participator-list">

        <AuthorizeView>
            <ParticipatorComponent 
            PlayerName="@(context.User.Identity?.Name)" 
            PlayerId="-1"
            ChosenItemChanged="HandleChosenWeaponTypeChanged">
            </ParticipatorComponent>
        </AuthorizeView>

        @foreach(Player player in selectedPlayers){
            <ParticipatorComponent 
            PlayerName="@player.UserName" 
            PlayerId="player.Id"
            ChosenItemChanged="HandleChosenWeaponTypeChanged">
            </ParticipatorComponent>
        }
    </ul>

    <button class="button button-confirm theme-dark" @onclick="OnConfirmButtonClicked">Confirm</button>

    @if (errors)
    {
        @foreach (var error in errorList)
        {
            <div class="alert alert-danger">@error</div>
        }
    }

</main>

<footer class="footer"></footer>

@code {

    #region Baustelle
    private bool isLoading = true;
    private bool isFormValid = true;
    private EditContext? editContext;

    [SupplyParameterFromForm]
    private SessionFormModel? Model { get; set; }

    private List<Player> players = [];
    private List<WeaponType> weaponTypes = [];

    private IIdentity? user { get; set; } = null;

    #endregion

    private InputComponentText? inputName;
    private InputComponentNumber? inputMaxDays;

    private List<Player> selectedPlayers = [];
    private Dictionary<int, int> weaponTypeDictionary = [];    // key: player id | value: weapontype id

    private bool errors = false;
    private List<string> errorList = [];

    protected override async Task OnInitializedAsync()
    {
        players = await playerProvider.GetPlayersAsync();
        weaponTypes = await weaponProvider.GetWeaponTypesAsync();

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        user = authState.User.Identity;

        Model ??= new SessionFormModel()
        {
            UserParticipator = new Participator()
            {
                Id = 0,
				SessionId = 0,
                Player = new Player() { UserName = user?.Name },
                PlayerId = 0,
                WeaponType = weaponTypes.First(),
                WeaponTypeId = weaponTypes.First().Id,
            }
        };

        editContext = new(Model);
		editContext.OnFieldChanged += HandleFieldChanged;

        isLoading = false;
        StateHasChanged();
    }

	private void HandleFieldChanged(object? sender, FieldChangedEventArgs e)
	{
        if(editContext is not null)
        {
			isFormValid = !editContext.Validate();
            StateHasChanged();
        }
	}

    private void HandleSelect(List<Player> players)
    {
        Model!.PlayerIds = players.Select(p => p.Id).ToArray();

        Model!.Participators.RemoveAll(pa => !Model!.PlayerIds.Contains(pa.PlayerId));
        Model!.Participators.AddRange(
        players
        .FindAll(p => !Model.Participators.Select(pa => pa.PlayerId).Contains(p.Id))
        .Select(p => new Participator()
            {
				Id = 0,
                SessionId = 0,
                Player = p,
                PlayerId = p.Id,
                WeaponType = weaponTypes.First(),
                WeaponTypeId = weaponTypes.First().Id,
            })
        );
        Model!.Participators.Sort((lhs, rhs) => lhs.Player!.UserName!.CompareTo(rhs.Player!.UserName));
    }

    private void Submit() => Logger.LogInformation($"Hi");

    public void Dispose()
    {
        if (editContext is not null)
        {
            editContext.OnFieldChanged -= HandleFieldChanged;
        }
    }

    private void HandleSelectedPlayersChanged(List<Player> newSelectedPlayers){
        selectedPlayers = newSelectedPlayers;
        StateHasChanged();
    }

    private void HandleChosenWeaponTypeChanged(int[] id) {

        if(weaponTypeDictionary.ContainsKey(id[0]))
        {
            weaponTypeDictionary[id[0]] = id[1];
        }
        else weaponTypeDictionary.Add(id[0], id[1]);        // id[0] -> player id | id[1] -> weapontype id
    }

    private async Task OnConfirmButtonClicked()
    {
        errors = false;
        errorList = [];

        if (string.IsNullOrEmpty(inputName!.Value))
        {
            errors = true;
            errorList.Add("Session Name required");
        }

        if (inputMaxDays!.Value < 1){
            errors = true;
            errorList.Add("Maximum Days must be minimum 1");
        }

        if (errors) return;

        Session newSession = new Session 
        { 
            Id = 0, 
            Name = inputName.Value,
            DayCount = 1,
            MaxDays = inputMaxDays.Value, 
            Date = DateUtils.GetDateString()  
        };

        var createdSession = await sessionProvider.CreateSessionAsync(newSession);

        foreach(var data in weaponTypeDictionary)
        {
			bool isSelf = data.Key == -1;

			Participator participator = new Participator
            { 
                Id = 0,
                PlayerId = data.Key,
                SessionId = createdSession.Id,
                WeaponTypeId = data.Value
            };

            await participatorProvider.CreateParticipatorAsync(participator, isSelf);
        }

        navigationManager.NavigateTo("/session");
    }
}
