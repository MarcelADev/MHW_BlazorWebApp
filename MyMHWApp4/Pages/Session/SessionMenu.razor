@page "/session"
@using MHWApp.Library.Model
@using MyMHWApp4.Provider
@inject SessionProvider sessionProvider

<main class="mainContainer">

<h2>Sessions</h2>

@foreach(Session session in sessions)
{
	<SessionComponent Session="session"></SessionComponent>
}

	<button class="addSessionButton"><b>&#x002B</b> New Session</button>

</main>

@code {
	List<Session> sessions = [];

	protected async override Task OnInitializedAsync()
	{
		sessions = await sessionProvider.GetSessionsAsync();

		await base.OnInitializedAsync();
	}
}
