@page "/session/vu-create"
@using MHWApp.Library.Model
@using MyMHWApp4.Utils
@using MyMHWApp4.Provider
@using System.ComponentModel.DataAnnotations;
@using System.Security.Principal;
@using MyMHWApp4.Pages.Session;
@inject ILogger<VuCreateSession> Logger
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject PlayerProvider playerProvider
@inject WeaponProvider weaponProvider
@inject IJSRuntime JSRuntime

<header class="container-center header">
    <h2>Create new Session</h2>
</header>

<main class="container-top">

    <div class="form__container">
        @if (!isLoading)
        {
            <EditForm EditContext="editContext" FormName="session" OnValidSubmit="Submit">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="form__field form__field-input">
                    <label for="session-name">Name</label>
                    <InputText name="session-name" @bind-Value="Model!.Name" />
                </div>

                <div class="form__field form__field-input">
                    <label for="session-max-days">Max Days</label>
                    <InputNumber name="session-max-days" @bind-Value="Model!.MaxDays" />
                </div>

                <VuSelect
                    Label="Participators" 
                    Placeholder="Select" 
                    T="Player" 
                    Options="@players"
                    OptionNameMapper="(Player player) => player.UserName" 
                    OptionValueMapper="(Player player) => player.Id"
                    IsMultiple="@true" 
                    ValueListChanged="HandleVuSelect">
                </VuSelect>

                <div class="form__field">
                    <VuParticipatorCard @bind-Value="Model!.UserParticipator" weaponTypes="weaponTypes" />
                </div>

                @for (var i = 0; i < Model!.Participators.Count; i++)
                {
                    var participator = Model!.Participators[i];

                    @if (Model!.PlayerIds.Contains(participator.PlayerId))
                    {
                        <div class="form__field">
                            <VuParticipatorCard @bind-Value="participator" weaponTypes="weaponTypes" />
                        </div>
                    }
                }

                <div class=" form__field form__button">
                    <button type="submit" class="btn btn-primary">
                        Create Session
                    </button>
                </div>
            </EditForm>
        }
    </div>

</main>

<footer class="footer"></footer>

@code {

    private bool isLoading = true;
    private bool isFormInvalid = true;
    private EditContext? editContext;
    private string os = "";

    [SupplyParameterFromForm]
    private SessionFormModel? Model { get; set; }

    private IIdentity? user { get; set; } = null;

    private List<Player> players = [];
    private List<WeaponType> weaponTypes = [];

    private List<int> selectedPlayers = new();

    protected override async Task OnInitializedAsync()
    {
        players = await playerProvider.GetPlayersAsync();
        weaponTypes = await weaponProvider.GetWeaponTypesAsync();

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        user = authState.User.Identity;

        Model ??= new SessionFormModel()
            {
                UserParticipator = new Participator()
                {
                    Player = new Player() { UserName = user?.Name },
                    PlayerId = 0,
                    WeaponType = weaponTypes.First(),
                    WeaponTypeId = weaponTypes.First().Id,
                }
            };
        editContext = new(Model);
        editContext.OnFieldChanged += HandleFieldChanged;

        isLoading = false;
        StateHasChanged();
    }

    private void HandleFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        if (editContext is not null)
        {
            isFormInvalid = !editContext.Validate();
            StateHasChanged();
        }
    }

    private void HandleVuSelect(List<Player> players)
    {
        Model!.PlayerIds = players.Select(p => p.Id).ToArray();

        Model!.Participators.RemoveAll(pa => !Model!.PlayerIds.Contains(pa.PlayerId));
        Model!.Participators.AddRange(
        players
        .FindAll(p => !Model.Participators.Select(pa => pa.PlayerId).Contains(p.Id))
        .Select(p => new Participator()
            {
                Player = p,
                PlayerId = p.Id,
                WeaponType = weaponTypes.First(),
                WeaponTypeId = weaponTypes.First().Id,
            })
        );
        Model!.Participators.Sort((lhs, rhs) => lhs.Player!.UserName!.CompareTo(rhs.Player!.UserName));
    }

    private void Submit() => Logger.LogInformation($"Hi");

    public void Dispose()
    {
        if (editContext is not null)
        {
            editContext.OnFieldChanged -= HandleFieldChanged;
        }
    }

    /// <summary>
    /// Form Model for creating sessions.
    /// </summary>
    public record SessionFormModel : IValidatableObject
    {
        public string Name { get; set; } = "";
        public int MaxDays { get; set; } = 1;
        public int[] PlayerIds { get; set; } = [];
        public required Participator UserParticipator { get; set; }
        public List<Participator> Participators { get; set; } = [];
        public List<Player> SelectedPlayers { get; set; } = [];
        public string Date { get; set; } = DateUtils.GetDateString();
        public int DayCount { get; set; } = 1;

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (Name.Trim() == "")
            {
                yield return new ValidationResult("Name must not be empty", ["Name"]);
            }
            if (MaxDays < DayCount)
            {
                yield return new ValidationResult("MaxDays must be greater than or equal to DayCount", ["MaxDays"]);
            }
        }

        public override string ToString()
        {
            return $"Name: {Name}, MaxDays: {MaxDays}, Players: {String.Join(",", PlayerIds)}, Date: {Date}, DayCount: {DayCount}";
        }
    }
}