@using MHWApp.Library.Model

<li>
	<label class="container-component">
		@Player.UserName
		<input id="checkbox" class="checkbox" type="checkbox" checked="@IsSelected" @onclick="ToggleSelection" />
	</label>
</li>

@code {
	[Parameter]
	public required bool IsSelected { get; set; }

	[Parameter]
	public required Player Player { get; set; }

	[Parameter]
	public required Func<Player, Task> AddPlayer { get; set; }

	[Parameter]
	public required Func<Player, Task> RemovePlayer { get; set; }

	private void ToggleSelection()
	{
		IsSelected = !IsSelected;

		if(IsSelected){
			AddPlayer(Player);
		}
		else {
			RemovePlayer(Player);
		}
	}

	private string GetButtonClass(){
		return IsSelected ? "selected" : "unselected";
	}
}
