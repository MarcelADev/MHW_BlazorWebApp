@using MHWApp.Library.Model;
@inject ILogger<VuParticipatorCard> Logger

@if (null != Value)
{
    <div class="vu-card participator">
        <div class="vu-card-header">
            @Value.Player.UserName
        </div>
        <div class="vu-card-body">
            <div class="participator-weapon">
                <img src="@($"Images/WeaponIcons/{Value.WeaponType.Name}.svg")"
                     alt="@Value.WeaponType.Name" />
                @* <select value="@Value.WeaponTypeId" @onchange="HandleWeaponChange">
                    @foreach (var weaponType in weaponTypes)
                    {
                        <option value="@weaponType.Id" selected="@(weaponType.Id == Value.WeaponTypeId)">@weaponType.Name</option>
                    }
                </select> *@
            </div>
        </div>
    </div>
}

@code {
    private Participator? _value;

    /// <summary>
    /// Participator to bind to.
    /// </summary>
    [Parameter]
    public Participator? Value { get; set; }

    /// <summary>
    /// Value changed callback.
    /// </summary>
    [Parameter]
    public EventCallback<Participator?> ValueChanged { get; set; }

    /// <summary>
    /// List of available weapon types to choose.
    /// </summary>
    [Parameter]
    public List<WeaponType> weaponTypes { get; set; } = new();

    private void HandleWeaponChange(ChangeEventArgs args)
    {
        if (args?.Value == null) return;

        var weaponTypeId = int.Parse(args.Value.ToString());
        var weaponType = weaponTypes.Find(w => w.Id == weaponTypeId);

        if (weaponType == null) return;

        Value!.WeaponTypeId = weaponType.Id;
        Value!.WeaponType = weaponType;

        ValueChanged.InvokeAsync(Value);
        StateHasChanged();
    }
}
