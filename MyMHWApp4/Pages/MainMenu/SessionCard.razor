@using MHWApp.Library.Exceptions
@using MHWApp.Library.Model
@using MyMHWApp4.HubConnections
@using MyMHWApp4.Pages.GeneralComponents.IconButtons
@using MyMHWApp4.Pages.GeneralComponents.Modals
@using MyMHWApp4.Pages.GeneralComponents.Modals.EditSessionModal
@using MyMHWApp4.Provider
@inject NavigationManager navigationManager
@inject ParticipatorProvider participatorProvider
@inject SessionProvider sessionProvider
@inject IDataBaseUpdatesHubConnection hubService
@implements IDisposable

@if (errors)
{
    @foreach (var error in errorList)
    {
        <div class="alert alert-danger">@error</div>
    }
}

<div class="card-session">

    <div class="container-image">

        <img src="Images/CardPicture.jpg" alt="Image not available" />

    </div>

    <div class="data__container">

        <div class="card-header__container">
            <h5>@Session.Name</h5>

            <div class="date__container">
                <span class="material-symbols-outlined black">
                    event_available
                </span>

                <p>@Session.DayCount/@Session.MaxDays</p>
            </div>
        </div>

        <div class="property__container">

            <label for="session-weapon">Weapon:</label>
            @if (isLoading)
            {
                <p id="session-weapon">Loading ...</p>
            }
            else
            {
                <p id="session-weapon">@participator!.WeaponType!.Name</p>
            }
        </div>

        <div class="property__container-last">
            <label for="session-date">Date:</label>
            <p id="session-date">@Session.Date</p>
        </div>

        <div class="container-left-space-between">
            <button class="play__button" @onclick="HandlePlayButtonClicked">
                Play
            </button>

            <div class="container-left">
                @if (toggleMore)
                {
                    <EditButton EditButtonClicked="HandleEditButtonClicked" AlternativeDesign="true"></EditButton>
                    <DeleteButton DeleteButtonClicked="HandleDeleteButtonClicked" AlternativeDesign="true"></DeleteButton>
                }
                <MoreButton MoreButtonClicked="HandleMoreButtonClicked"></MoreButton>
            </div>			
        </div>
    </div>

</div>

@if (showEditModal)
{
    <EditSessionModal Session="Session" 
    CloseModal="HandleCloseEditModal">

    </EditSessionModal>
}

@if(showDeleteModal)
{
    <DeleteSessionModal CloseButtonClicked="HandleDeleteModalCloseButtonClicked"
    RemoveParticipationButtonClicked="HandleModalRemoveParticipationButtonClicked"
    DeleteSessionButtonClicked="HandleModalDeleteSessionButtonClicked">
    </DeleteSessionModal>
}

@code 
{
    private bool toggleMore = false;
    private bool isLoading = true;
    private bool showDeleteModal = false;
    private bool showEditModal = false;

    private bool errors;
    private string[] errorList = [];

    Participator? participator;

    [Parameter]
    public required Session Session { get; set; }

    protected override async Task OnInitializedAsync()
    {
        participator = await participatorProvider.GetParticipatorAsync(Session.Id);

        hubService.OnUpdatedSession += HandleSignalRUpdatedSession;

        isLoading = false;
    }

    private void HandleMoreButtonClicked()
    {
        toggleMore = !toggleMore;
    }

    private void HandleEditButtonClicked()
    {
        showEditModal = true;
    }

    private void HandleDeleteButtonClicked()
    {
        showDeleteModal = true;
    }

    private void HandlePlayButtonClicked()
    {
        navigationManager.NavigateTo("/inventory");
    }

    private void HandleDeleteModalCloseButtonClicked()
    {
        showDeleteModal = false;
    }

    private void HandleCloseEditModal()
    {
        showEditModal = false;
    }

    private async Task HandleModalRemoveParticipationButtonClicked()
    {
        errors = false;
        errorList = [];

        try
        {
            await participatorProvider.RemoveParticipatorAsync(participator!.Id);
        }
        catch (EntityWasNotFoundException)
        {
            errors = true;
            errorList = ["Couldnt remove Participator because it wasn't found. Please reload page!"];
        }
        catch (UnexpectedResponseException)
        {
            errors = true;
            errorList = ["Unexpected HTTP Response. Please contact Devs!"];
        }

        showDeleteModal = false;
        StateHasChanged();
    }

    private async Task HandleModalDeleteSessionButtonClicked()
    {
        errors = false;
        errorList = [];

        try
        {
            await sessionProvider.RemoveSessionAsync(Session.Id);
        }
        catch (EntityWasNotFoundException)
        {
            errors = true;
            errorList = ["Couldnt remove Session because it wasn't found. Please reload page!"];
        }
        catch (UnexpectedResponseException)
        {
            errors = true;
            errorList = ["Unexpected HTTP Response. Please contact Devs!"];
        }

        showDeleteModal = false;
        StateHasChanged();
    }

    private void HandleSignalRUpdatedSession(Session updatedSession)
    {
        if(Session.Id == updatedSession.Id)
        {
            Session = updatedSession;
        }
        StateHasChanged();
    }

    public void Dispose()
    {
        hubService.OnUpdatedSession -= HandleSignalRUpdatedSession;
    }
}
