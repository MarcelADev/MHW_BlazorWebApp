@using MHWApp.Library.Model
@using MyMHWApp4.Pages.GeneralComponents.IconButtons
@using MyMHWApp4.Provider
@inject NavigationManager navigationManager
@inject ParticipatorProvider participatorProvider

<button class="card-session" @onclick="HandleCardClicked">

	<div class="container-image">

		<img src="Images/CardPicture.jpg" alt="Image not available" />

		<div class="ovderlay__iconbuttons">
			@if (!toggleMore)
			{
				<div class="container-top">
					<MoreButton MoreButtonClicked="HandleMoreButtonClicked"></MoreButton>
				</div>
			}
			else
			{
				<div class="container-top">
					<MoreButton MoreButtonClicked="HandleMoreButtonClicked" Glow="true"></MoreButton>
					<EditButton EditButtonClicked="HandleEditButtonClicked" AlternativeDesign="true" Glow="true"></EditButton>
					<DeleteButton DeleteButtonClicked="HandleDeleteButtonClicked" AlternativeDesign="true" Glow="true"></DeleteButton>
				</div>
			}
		</div>
	</div>

	<div class="container-data">

		<h5>@Session.Name</h5>

		<div class="container-property">

			<div class="container-label">
				<label>Weapon:</label>
			</div>

			@if (participator == null)
			{
				<p>Loading ...</p>
			}
			else
			{
				<p>@participator.WeaponType!.Name</p>
			}
		</div>

		<div class="container-property">

			<div class="container-label">
				<label>Days:</label>
			</div>
			<p>@Session.DayCount/@Session.MaxDays</p>

		</div>

		<div class="container-property">
			<div class="container-label">
				<label>Date:</label>
			</div>
			<p>@Session.Date</p>
		</div>
	</div>

</button>

@code 
{
	private bool toggleMore = false;

	[Parameter]
	public required Session Session { get; set; }
	Participator? participator;

	protected override async Task OnInitializedAsync()
	{
		participator = await participatorProvider.GetParticipatorAsync(Session.Id);
		await base.OnInitializedAsync();
	}

	private void HandleCardClicked()
	{
		// navigationManager.NavigateTo("/inventory");
	}

	private void HandleMoreButtonClicked()
	{
		toggleMore = !toggleMore;
	}

	private void HandleEditButtonClicked()
	{
		StateHasChanged();
	}

	private void HandleDeleteButtonClicked()
	{

	}

	private void NavigateToInventory() 
	{ 
		navigationManager.NavigateTo("/inventory");
	}
}
