@using MHWApp.Library.Model

<button class="container-category-card" @onclick="OnClick">
	@Category.Name
</button>

<div class="container-left expandable-content" style="@(openCard ? "height: auto;" : "height: 0;")">
	<div>
		<button class="button button-edit theme-blue">Edit</button>
		<button class="button button-delete theme-red">Delete</button>
	</div>
</div>

@code {
	private bool openCard = false;

	[Parameter]
	public required Category Category { get; set; }

	private void OnClick()
	{
		openCard = !openCard;
	}
}