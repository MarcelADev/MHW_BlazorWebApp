@using MHWApp.Library.Model
@using MyMHWApp4.Pages.GeneralComponents
@using MyMHWApp4.Pages.GeneralComponents.IconButtons
@using MyMHWApp4.Pages.Modals
@using MyMHWApp4.Provider
@using static MHWApp.Library.StaticVariables
@inject CategoryProvider categoryProvider

<div class="card">

	<div class="container-left-space-between">
		<p class="header-card">@Category.Name</p>

		<div class="container-left">
			@if (!toggleEdit)
			{
				<EditButton EditButtonClicked="HandleEditButtonClicked"></EditButton>
				<DeleteButton DeleteButtonClicked="HandleDeleteButtonClicked"></DeleteButton>
			}
			else
			{
				<ConfirmButton ConfirmButtonClicked="HandleConfirmButtonClicked"></ConfirmButton>
				<CancelButton CancelButtonClicked="HandleCancelButtonClicked"></CancelButton>
			}
		</div>
	</div>

	@if (toggleEdit)
	{
		<EditTextInput 
		@ref="changeNameInput"
		Value="@Category.Name"
		LabelText="Name"
		PlaceHolder="Category">
		</EditTextInput>

		<div class="container-top tab">

			<InputComponentCheckbox 
			@ref="InvCatCheckbox" 
			LabelText="Inventory Entry Category" 
			IsChecked="@(Category.InventoryEntryCategory != null)">
			</InputComponentCheckbox>

			<InputComponentCheckbox 
			@ref="WepCatCheckbox" 
			LabelText="Weapon Category" 
			IsChecked="@(Category.WeaponCategory != null)">
			</InputComponentCheckbox>

			<InputComponentCheckbox 
			@ref="ArmCatCheckbox" 
			LabelText="Armor Category" 
			IsChecked="@(Category.ArmorCategory != null)">
			</InputComponentCheckbox>
		</div>
	}
</div>

@if (errors)
{
	@foreach (var error in errorList)
	{
		<div class="alert alert-danger">@error</div>
	}
}

@if(showModal){
	<Modal
		Title="Confirm Delete"
		BodyText="@modalBodyText"
		CloseButtonClicked="HandleModalCloseOrCancelButtonClicked"
		SecondaryButtonClicked="HandleModalCloseOrCancelButtonClicked"
		PrimaryButtonClicked="HandleDeleteConfirmedButtonClicked">
	</Modal>
}

@code {
	private string? modalBodyText;

	private bool showModal = false;
	private bool toggleEdit = false;
	private bool errors = false;
	private List<string> errorList = [];

	private bool invCat;
	private bool wepCat;
	private bool armCat;

	public InputComponentCheckbox? InvCatCheckbox;
	public InputComponentCheckbox? WepCatCheckbox;
	public InputComponentCheckbox? ArmCatCheckbox;
	private EditTextInput? changeNameInput;

	public string Value { get; set; } = "";

	[Parameter]
	public required Category Category { get; set; }

	[Parameter]
	public required EventCallback<Category> CategoryGotRemoved { get; set; }

	protected override async Task OnInitializedAsync()
	{
		invCat = Category.InventoryEntryCategory != null;
		wepCat = Category.WeaponCategory != null;
		armCat = Category.ArmorCategory != null;

		modalBodyText = $"Are you sure you want to remove {Category.Name}?";

		await base.OnInitializedAsync();
	}

	private void HandleEditButtonClicked()
	{
		toggleEdit = !toggleEdit;
		errors = false;
	}

	private async Task HandleConfirmButtonClicked()
	{
		errorList = [];
		bool error1, error2, error3, error4;
		error1 = error2 = error3 = error4 = false;

		// Check if all components are initialized
		if (changeNameInput == null)
		{
			errorList.Add("changeNameInput is null!");
			errors = true;
			return;
		}

		if (InvCatCheckbox == null)
		{
			errorList.Add("InvCatCheckbox is null!");
			errors = true;
			return;
		}

		if (WepCatCheckbox == null)
		{
			errorList.Add("WepCatCheckbox is null!");
			errors = true;
			return;
		}

		if (ArmCatCheckbox == null)
		{
			errorList.Add("ArmCatCheckbox is null!");
			errors = true;
			return;
		}

		// Check if name was changed
		if (changeNameInput.Value != Category.Name)
		{
			Category.Name = changeNameInput.Value;
			await categoryProvider.UpdateCategoryAsync(Category);
		}
		else error1 = true;

		// Check if Inventory Entry Category was changed
		if (InvCatCheckbox.Value != invCat)
		{
			if (InvCatCheckbox.Value)
			{
				InventoryEntryCategory newInvCat = new InventoryEntryCategory
				{
						Id = 0,
						CategoryId = Category.Id,
						Order = ORDER_DEFAULT_VALUE
				};
				await categoryProvider.CreateInventoryEntryCategoryAsync(newInvCat);
				Category.InventoryEntryCategory = newInvCat;
			}
			else
			{
				//TO DO: Modal
			}
		}
		else error2 = true;

		// Check if Weapon Category was changed
		if (WepCatCheckbox.Value != wepCat)
		{
			if (WepCatCheckbox.Value)
			{
				WeaponCategory newWepCat = new WeaponCategory
					{
						Id = 0,
						CategoryId = Category.Id,
						Order = ORDER_DEFAULT_VALUE
					};
				await categoryProvider.CreateWeaponCategoryAsync(newWepCat);
				Category.WeaponCategory = newWepCat;
			}
			else
			{
				//TO DO: Modal
			}
		}
		else error3 = true;

		// Check if Armor Category was changed
		if (ArmCatCheckbox.Value != armCat)
		{
			if (ArmCatCheckbox.Value)
			{
				ArmorCategory newArmCat = new ArmorCategory
					{
						Id = 0,
						CategoryId = Category.Id,
						Order = ORDER_DEFAULT_VALUE
					};
				await categoryProvider.CreateArmorCategoryAsync(newArmCat);
				Category.ArmorCategory = newArmCat;
			}
			else
			{
				//TO DO: Modal
			}
		}
		else error4 = true;

		errors = error1 && error2 && error3 && error4;

		if (errors) errorList.Add("No changes were made!");

		toggleEdit = !toggleEdit;
	}

	private void HandleCancelButtonClicked()
	{
		toggleEdit = !toggleEdit;
		errors = false;
	}

	private async Task HandleDeleteButtonClicked()
	{
		showModal = true;
	}

	private async Task HandleModalCloseOrCancelButtonClicked()
	{
		showModal = false;
	}

	private async Task HandleDeleteConfirmedButtonClicked()
	{
		await categoryProvider.RemoveCategoryAsync(Category.Id);
		await CategoryGotRemoved.InvokeAsync(Category);
		showModal = false;
	}
}