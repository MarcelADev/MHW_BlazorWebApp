@using MHWApp.Library.Model
@using MyMHWApp4.Pages.GeneralComponents

<div class="card">

	<p >@Category.Name</p>

	<div class="tab">
		<div class="container-property">
			<label for="PropertyInput">Name:</label>
			<input name="PropertyInput" placeholder="Category Name" type="text" @bind-value="Value" />
		</div>

		<InputComponentCheckbox @ref="InventoryEntryCategoryCheckbox" LabelText="Inventory Entry Category" IsChecked="HasInventoryEntryCategory"></InputComponentCheckbox>

		<InputComponentCheckbox @ref="WeaponCategoryCheckbox" LabelText="Weapon Category" IsChecked="HasWeaponCategory"></InputComponentCheckbox>

		<InputComponentCheckbox @ref="ArmorCategoryCheckbox" LabelText="Armor Category" IsChecked="HasArmorCategory"></InputComponentCheckbox>
	</div>

	<div class="container-button">

		<button class="button button-confirm theme-purple">Confirm Changes</button>
		<DeleteButton></DeleteButton>
	</div>
</div>



@code {
	public InputComponentCheckbox? InventoryEntryCategoryCheckbox;
	public InputComponentCheckbox? WeaponCategoryCheckbox;
	public InputComponentCheckbox? ArmorCategoryCheckbox;

	public string Value { get; set; } = "";

	[Parameter]
	public required Category Category { get; set; }

	[Parameter]
	public required bool HasInventoryEntryCategory { get; set; }
	
	[Parameter]
	public bool HasWeaponCategory { get; set; }
	
	[Parameter]
	public bool HasArmorCategory { get; set; }

	protected override async Task OnInitializedAsync()
	{
		Value = Category.Name;
		await base.OnInitializedAsync();
	}
}