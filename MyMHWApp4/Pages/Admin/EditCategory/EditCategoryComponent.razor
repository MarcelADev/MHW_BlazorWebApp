@using MHWApp.Library.Model
@using MyMHWApp4.Pages.GeneralComponents

<div class="category-card">

	<p >@Category.Name</p>

	<div class="tab">
		<div class="container-property">
			<label for="PropertyInput">Name:</label>
			<input name="PropertyInput" placeholder="Category Name" type="text" @bind-value="Value" />
		</div>

		<InputComponentCheckbox @ref="NewNameInput" LabelText="Inventory Entry" IsChecked="true"></InputComponentCheckbox>

		<button class="button button-delete theme-red">Delete</button>

	</div>
</div>



@code {
	public InputComponentCheckbox? NewNameInput;

	public string Value { get; set; } = "";

	[Parameter]
	public required Category Category { get; set; }

	protected override async Task OnInitializedAsync()
	{
		Value = Category.Name;
		await base.OnInitializedAsync();
	}
}