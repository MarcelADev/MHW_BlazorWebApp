@using MHWApp.Library.Model
@using MyMHWApp4.Pages.GeneralComponents

<div class="category-card">

	<p >@Category.Name</p>

	<div class="tab">
		<div class="container-property">
			<label for="PropertyInput">Name:</label>
			<input name="PropertyInput" placeholder="Category Name" type="text" @bind-value="Value" />
		</div>

		<InputComponentCheckbox @ref="IsInventoryEntryInput" LabelText="Inventory Entry Category" IsChecked="true"></InputComponentCheckbox>

		<InputComponentCheckbox @ref="IsWeaponInput" LabelText="Weapon Category" IsChecked="true"></InputComponentCheckbox>
		
		<InputComponentCheckbox @ref="IsArmorInput" LabelText="Armor Category" IsChecked="true"></InputComponentCheckbox>

		<div class="container-button">
			<button class="button button-confirm theme-purple">Confirm Changes</button>
			<button class="button button-delete theme-red">Delete</button>

			<span class="material-symbols-outlined">
				delete
			</span>

		</div>

	</div>
</div>



@code {
	public InputComponentCheckbox? IsInventoryEntryInput;
	public InputComponentCheckbox? IsWeaponInput;
	public InputComponentCheckbox? IsArmorInput;

	public string Value { get; set; } = "";

	[Parameter]
	public required Category Category { get; set; }

	protected override async Task OnInitializedAsync()
	{
		Value = Category.Name;
		await base.OnInitializedAsync();
	}
}