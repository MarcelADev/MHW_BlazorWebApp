@page "/edit/categories"
@using MHWApp.Library.Model
@using MyMHWApp4.Pages.GeneralComponents
@using Provider
@inject CategoryProvider categoryProvider

<h3>Edit Categories</h3>

<InputComponentText LabelText="Name:" PropertyChanged="HandleNameChanged"></InputComponentText>

@if(categories == null){
	<p>Loading ...</p>
}
else if(!categories.Any()){
	<p>List is empty</p>
}
else{
	@foreach(Category category in categories){
		<EditCategoryComponent Category="category"></EditCategoryComponent>
	}
}

<p>@name</p>

@code {
	List<Category>? categories;
	private string name = "";

	protected override async Task OnInitializedAsync()
	{
		categories = await categoryProvider.GetCategoriesAsync();
		await base.OnInitializedAsync();
	}

	private void HandleNameChanged(string newName)
	{
		name = newName;
		StateHasChanged();
	}
}
