@page "/edit/categories"
@using MHWApp.Library.DTO
@using MHWApp.Library.Exceptions
@using MHWApp.Library.Model
@using MyMHWApp4.HubConnections
@using MyMHWApp4.Pages.GeneralComponents.Select
@using Provider
@inject CategoryProvider categoryProvider
@inject GameExtensionProvider gameExtensionProvider
@inject IDataBaseUpdatesHubConnection hubService
@implements IDisposable

<header class="container-center header">
	<h2>Categories</h2>
</header>

<main class="container-top">

	<div class="container-h3"><h3>Create</h3></div>

	<div class="form__container">
		@if(!isLoading)
		{
			<EditForm EditContext="editContext" FormName="category" OnValidSubmit="Submit">
				<DataAnnotationsValidator />
				<ValidationSummary />

				<div class="form__field">
					<label for="category-name">Name</label>
					<InputText id="category-name" @bind-Value="Model!.Name"></InputText>
				</div>

				<div class="form__field-checkbox">
					<InputCheckbox id="category-inventory" @bind-Value="Model.IsInventoryCategory"></InputCheckbox>
					<label for="category-inventory">Inventory Category</label>
				</div>

				<div class="form__field-checkbox">
					<InputCheckbox id="category-weapon" @bind-Value="Model.IsWeaponCategory"></InputCheckbox>
					<label for="category-weapon">Weapon Category</label>
				</div>

				<div class="form__field-checkbox">
					<InputCheckbox id="category-armor" @bind-Value="Model.IsArmorCategory"></InputCheckbox>
					<label for="category-armor">Armor Category</label>
				</div>

				<div class="form__field form__button">
					<button type="submit" class="btn btn-primary">
						Create Category
					</button>
				</div>

			</EditForm>
		}
	</div>

	<div class="container-h3 margin-h3"><h3>Edit</h3></div>

	@if(isLoading)
	{
		<p>Loading ...</p>
	}
	else if(!categories!.Any())
	{
		<p>List is empty</p>
	}
	else
	{
		@foreach(Category category in categories!)
		{
			<CategoryCard
			@key="category.Id"
			Category="category">
			</CategoryCard>
		}
	}

</main>

<footer class="footer"></footer>

@code {
	private bool isLoading = true;
	private bool isFormValid = false;
	private EditContext? editContext;

	[SupplyParameterFromForm]
	private CategoryFormModel? Model { get; set; }

	List<Category>? categories;
	List<GameExtension>? extensions;

	protected override async Task OnInitializedAsync()
	{
		categories = await categoryProvider.GetCategoriesAsync();
		if (categories.Any()) categories.Sort((x, y) => x.Name.CompareTo(y.Name));

		extensions = await gameExtensionProvider.GetGameExtensionsAsync();
		if (extensions.Any()) extensions.Sort((x, y) => x.Name.CompareTo(y.Name));

		Model ??= new CategoryFormModel(categories) { };
		editContext = new(Model);
		editContext.OnFieldChanged += HandleFieldChanged;

		hubService.OnNewCategory += HandleSignalRNewCategory;
		hubService.OnUpdatedCategory += HandleSignalRUpdatedCategory;
		hubService.OnDeletedCategory += HandleSignalRDeletedCategory;

		hubService.OnNewInventoryCategory += HandleSignalRNewInventoryCategory;
		hubService.OnDeletedInventoryCategory += HandleSignalRDeletedInventoryCategory;

		hubService.OnNewWeaponCategory += HandleSignalRNewWeaponCategory;
		hubService.OnDeletedWeaponCategory += HandleSignalRDeletedWeaponCategory;

		hubService.OnNewArmorCategory += HandleSignalRNewArmorCategory;
		hubService.OnDeletedArmorCategory += HandleSignalRDeletedArmorCategory;

		hubService.OnNewGameExtension += HandleSignalRNewGameExtension;
		hubService.OnUpdatedGameExtension += HandleSignalRUpdatedGameExtension;
		hubService.OnDeletedGameExtension += HandleSignalRDeletedGameExtension;

		isLoading = false;
		StateHasChanged();
	}

	private void HandleFieldChanged(object? sender, FieldChangedEventArgs e)
	{
		if(editContext is not null)
		{
			isFormValid = !editContext.Validate();
			StateHasChanged();
		}
	}

	private async Task Submit() => await CreateCategory();

	private async Task CreateCategory()
	{
		CategoryCreateDTO categoryDTO = new CategoryCreateDTO
			{
				NewCategory = new Category 
				{ 
					Id = 0,
					Name = Model!.Name,
				},
				IsInventoryEntry = Model.IsInventoryCategory,
				IsWeapon = Model.IsWeaponCategory,
				IsArmor = Model.IsArmorCategory,
			};

		try
		{
			await categoryProvider.CreateCategoryAsync(categoryDTO);
		}
		catch (EntityAlreadyExistsException)
		{
			Model.EntityAlreadyExistsFlag = true;
			editContext!.Validate();
		}
		catch (EntityWasNullException)
		{
			Model.EntityWasNullFlag = true;
			editContext!.Validate();
		}
		catch (UnexpectedResponseException)
		{
			Model.UnexpectedResponseFlag = true;
			editContext!.Validate();
		}
		StateHasChanged();
	}

	private void HandleSignalRNewCategory(Category newCategory)
	{
		categories!.Add(newCategory);
		StateHasChanged();
	}

	private void HandleSignalRUpdatedCategory(Category updatedCategory)
	{
		var existing = categories!.Find(c => c.Id == updatedCategory.Id);
		if (existing != null) existing.Name = updatedCategory.Name;
		StateHasChanged();
	}

	private void HandleSignalRDeletedCategory(int deletedCategoryId)
	{
		var existing = categories!.Find(c => c.Id == deletedCategoryId);
		if (existing != null) categories.Remove(existing);
		StateHasChanged();
	}

	private void HandleSignalRNewInventoryCategory(InventoryEntryCategory newInventoryCategory)
	{
		var existing = categories!.Find(ic => ic.Id == newInventoryCategory.CategoryId);
		if (existing != null) existing.InventoryEntryCategory = newInventoryCategory;
		StateHasChanged();
	}

	private void HandleSignalRDeletedInventoryCategory(int categoryIdOfDeletedInventoryCategory)
	{
		var existing = categories!.Find(ic => ic.Id == categoryIdOfDeletedInventoryCategory);
		if (existing != null) existing.InventoryEntryCategory = null;
		StateHasChanged();
	}

	private void HandleSignalRNewWeaponCategory(WeaponCategory newWeaponCategory)
	{
		var existing = categories!.Find(wc => wc.Id == newWeaponCategory.CategoryId);
		if (existing != null) existing.WeaponCategory = newWeaponCategory;
		StateHasChanged();
	}

	private void HandleSignalRDeletedWeaponCategory(int categoryIdOfDeletedWeaponCategory)
	{
		var existing = categories!.Find(wc => wc.Id == categoryIdOfDeletedWeaponCategory);
		if (existing != null) existing.WeaponCategory = null;
		StateHasChanged();
	}

	private void HandleSignalRNewArmorCategory(ArmorCategory newArmorCategory)
	{
		var existing = categories!.Find(ac => ac.Id == newArmorCategory.CategoryId);
		if (existing != null) existing.ArmorCategory = newArmorCategory;
		StateHasChanged();
	}

	private void HandleSignalRDeletedArmorCategory(int categoryIdOfDeletedArmorCategory)
	{
		var existing = categories!.Find(ac => ac.Id == categoryIdOfDeletedArmorCategory);
		if (existing != null) existing.ArmorCategory = null;
		StateHasChanged();
	}

	private void HandleSignalRNewGameExtension(GameExtension newGameExtension)
	{
		extensions!.Add(newGameExtension);
		StateHasChanged();
	}

	private void HandleSignalRUpdatedGameExtension(GameExtension updatedGameExtension)
	{
		var existing = extensions!.Find(ge => ge.Id == updatedGameExtension.Id);
		if (existing != null) existing.Name = updatedGameExtension.Name;
		StateHasChanged();
	}

	private void HandleSignalRDeletedGameExtension(int deletedGameExtensionId)
	{
		var existing = extensions!.Find(ge => ge.Id == deletedGameExtensionId);
		if (existing != null) extensions.Remove(existing);
		StateHasChanged();
	}

	public void Dispose()
	{
		hubService.OnNewCategory -= HandleSignalRNewCategory;
		hubService.OnUpdatedCategory -= HandleSignalRUpdatedCategory;
		hubService.OnDeletedCategory -= HandleSignalRDeletedCategory;

		hubService.OnNewInventoryCategory -= HandleSignalRNewInventoryCategory;
		hubService.OnDeletedInventoryCategory -= HandleSignalRDeletedInventoryCategory;

		hubService.OnNewWeaponCategory -= HandleSignalRNewWeaponCategory;
		hubService.OnDeletedWeaponCategory -= HandleSignalRDeletedWeaponCategory;

		hubService.OnNewArmorCategory -= HandleSignalRNewArmorCategory;
		hubService.OnDeletedArmorCategory -= HandleSignalRDeletedArmorCategory;

		hubService.OnNewGameExtension -= HandleSignalRNewGameExtension;
		hubService.OnUpdatedGameExtension -= HandleSignalRUpdatedGameExtension;
		hubService.OnDeletedGameExtension -= HandleSignalRDeletedGameExtension;
	}
}
