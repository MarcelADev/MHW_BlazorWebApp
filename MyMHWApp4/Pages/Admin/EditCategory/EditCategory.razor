@page "/edit/categories"
@using MHWApp.Library.DTO
@using MHWApp.Library.Model
@using MyMHWApp4.Pages.GeneralComponents
@using Provider
@inject CategoryProvider categoryProvider

<header class="container-center header">
	<h2>Categories</h2>
</header>

<main class="container-top">

	<div class="container-h3"><h3>Create</h3></div>

	<InputComponentText @ref="nameInput" LabelText="Name:" PlaceHolder="Category Name"></InputComponentText>

	<div class="tab">

		<div class="container-h4 margin-h4"><h4>Interfaces</h4></div>

		<InputComponentCheckbox @ref="isInventoryEntryCategory" LabelText="Inventory Entry"></InputComponentCheckbox>

		<InputComponentCheckbox @ref="isWeaponCategory" LabelText="Weapon"></InputComponentCheckbox>

		<InputComponentCheckbox @ref="isArmorCategory" LabelText="Armor"></InputComponentCheckbox>

	</div>

	<button class="button theme-purple" @onclick="OnCreateCategoryButtonClicked">Create Category</button>

	<div class="container-h3 margin-h3"><h3>Edit</h3></div>

	@if(categories == null){
		<p>Loading ...</p>
	}
	else if(!categories.Any()){
		<p>List is empty</p>
	}
	else{
		@foreach(Category category in categories){
			<EditCategoryComponent 
				Category="category"
				HasInventoryEntryCategory="true"
				RemoveCategory="HandleRemoveCategory">
			</EditCategoryComponent>

			@* (category.InventoryEntryCategory != null) *@
			@* <p>InventoryEntryCategoryId: @IsNotNull(category.InventoryEntryCategory)</p>
			<p>WeaponCatagory: @IsNotNull(category.WeaponCategory.Id)</p>
			<p>ArmorCategory: @IsNotNull(category.ArmorCategory.Id)</p> *@
		}
	}

</main>

<footer class="footer"></footer>

@code {
	List<Category>? categories;
	CategoryDTO? categoryDTO;

	private InputComponentText? nameInput;
	private InputComponentCheckbox? isInventoryEntryCategory;
	private InputComponentCheckbox? isWeaponCategory;
	private InputComponentCheckbox? isArmorCategory;

	protected override async Task OnInitializedAsync()
	{
		categories = await categoryProvider.GetCategoriesAsync();
		await base.OnInitializedAsync();
	}

	private async Task OnCreateCategoryButtonClicked()
	{
		categoryDTO = new CategoryDTO
		{
			NewCategory = new Category { Id = 0, Name = nameInput!.Value },
			IsInventoryEntry = isInventoryEntryCategory.Value,
			IsWeapon= isWeaponCategory.Value,
			IsArmor = isArmorCategory.Value
		};

		await categoryProvider.CreateAllCategoriesAsync(categoryDTO);

		categories = await categoryProvider.GetCategoriesAsync();
	}

	private async Task HandleRemoveCategory(Category category)
	{
		await categoryProvider.RemoveCategoryAsync(category.Id);

		categories.Remove(category);
	}

	private bool IsNotNull(object o){
		if (o == null) return false;

		return true;
	}
}
