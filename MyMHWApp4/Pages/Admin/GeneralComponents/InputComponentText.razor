<div class="propertyContainer">
	<label for="PropertyInput">Name:</label>
	<br />
	<input name="PropertyInput" placeholder="Category Name" type="text" @bind-value="name" @oninput="OnNameChanged" />
</div>

@code {
	private string name = "";

	[Parameter]
	public EventCallback<string> NameChanged { get; set; }

	private async Task OnNameChanged()
	{
		await NameChanged.InvokeAsync(name);
	}
}
