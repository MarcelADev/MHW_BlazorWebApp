@using MHWApp.Library
@using MHWApp.Library.Exceptions
@using MHWApp.Library.Model
@using MyMHWApp4.HubConnections
@using MyMHWApp4.Pages.Admin.EditCategory
@using MyMHWApp4.Pages.GeneralComponents
@using MyMHWApp4.Pages.GeneralComponents.IconButtons
@using MyMHWApp4.Pages.GeneralComponents.Modals
@using MyMHWApp4.Pages.GeneralComponents.Select
@using MyMHWApp4.Provider
@using static MHWApp.Library.StaticVariables
@inject InventoryEntryProvider inventoryEntryProvider
@inject CategoryProvider categoryProvider
@inject IDataBaseUpdatesHubConnection hubService

@if(!isLoading)
{
	<div class="form__container">
		<EditForm EditContext="editContext" FormName="inventoryEntryCard" OnValidSubmit="Submit">
			<DataAnnotationsValidator />
			<ValidationSummary />

			<div class="card">

				<div class="container-left-space-between">
					<p class="header-card">
						@if(InventoryEntry.CategoryInName)
						{
							var categoryEntry = InventoryEntry.InventoryEntryCategories.FirstOrDefault();
							if (categoryEntry != null)
							{
								@categoryEntry.Category!.Name
							}
						}
						@InventoryEntry.Name
					</p>

					<div class="container-right-gap">
						@if (!toggleEdit)
						{
							<EditButton EditButtonClicked="HandleEditButtonClicked"></EditButton>
							<DeleteButton DeleteButtonClicked="HandleDeleteButtonClicked"></DeleteButton>
						}
						else
						{
							<ConfirmButton />
							<CancelButton CancelButtonClicked="HandleCancelButtonClicked"></CancelButton>
						}
					</div>
				</div>

				@if (toggleEdit)
				{
					<div class="form__field">
						<label for="inventoryEntryCard-name">Change Name:</label>
						<InputText id="inventoryEntryCard-name" @bind-Value="Model!.NewName" />
					</div>

					<div class="form__field-checkbox">
						<InputCheckbox id="inventoryEntryCard-categoryInName" @bind-Value="Model.SelectedCategoryInName" />
						<label for="inventoryEntryCard-categoryInName">Category in front of Name</label>
					</div>

					<MultiSelect Label="Change Categories"
								 Placeholder="Select"
								 T="InventoryEntryCategory"
								 Options="@allInventoryEntryCategories"
								 OptionNameMapper="(InventoryEntryCategory iec) => iec.Category?.Name ?? string.Empty"
								 OptionValueMapper="(InventoryEntryCategory iec) => iec.Id"
								 ValueList="Model.SelectedInventoryCategories"
								 ValueListChanged="HandleSelect">
					</MultiSelect>
				}
			</div>

		</EditForm>
	</div>
}

@if(showModal){
	<Modal
	Title="Confirm Delete"
	BodyText="@modalBodyText"
	CloseButtonClicked="HandleModalCloseOrCancelButtonClicked"
	SecondaryButtonClicked="HandleModalCloseOrCancelButtonClicked"
	PrimaryButtonClicked="HandleModalConfirmButtonClicked">
	</Modal>
}

@code {
	private bool isLoading = true;
	private bool isFormValid = true;
	private bool toggleEdit = false;
	private bool showModal = false;

	private string? modalBodyText;

	private List<InventoryEntryCategory>? allInventoryEntryCategories;

	public EditContext? editContext;

	[SupplyParameterFromForm]
	public InventoryEntryCardFormModel? Model { get; set; }

	[Parameter]
	public required InventoryEntry InventoryEntry { get; set; }

	protected override async Task OnInitializedAsync()
	{
		allInventoryEntryCategories = await categoryProvider.GetInventoryCategoriesAsync();
		if (allInventoryEntryCategories.Any()) allInventoryEntryCategories.Sort((x, y) => x.Category!.Name.CompareTo(y.Category!.Name));

		modalBodyText = $"Are you sure you want to remove {InventoryEntry.Name}?";

		Model ??= new InventoryEntryCardFormModel(InventoryEntry);
		editContext = new(Model);
		editContext.OnFieldChanged += HandleFieldChanged;

		hubService.OnUpdatedInventoryEntry += HandleSignalRUpdatedInventoryEntry;

		isLoading = false;
		StateHasChanged();
	}

	private void HandleFieldChanged(object? sender, FieldChangedEventArgs e)
	{
		if (editContext is not null)
		{
			isFormValid = !editContext.Validate();
			StateHasChanged();
		}
	}

	private void HandleSelect(List<InventoryEntryCategory> inventoryEntryCategories)
	{
		// Model!.SelectedArmorCategory = inventoryEntryCategories.ToList();
		isFormValid = !editContext!.Validate();
		StateHasChanged();
	}

	private async Task Submit() => await ChangeInventoryEntryNameAndOrCategory();

	private async Task ChangeInventoryEntryNameAndOrCategory()
	{
		InventoryEntry inventoryEntry = new InventoryEntry
		{
			Id = InventoryEntry.Id,
			Name = Model!.NewName,
			Order = ORDER_DEFAULT_VALUE,
			InventoryEntryCategories = Model.SelectedInventoryCategories
		};

		try
		{
			await inventoryEntryProvider.UpdateInventoryEntryAsync(inventoryEntry);
		}
		catch (EntityWasNotFoundException)
		{
			Model.EntityWasNotFoundFlag = true;
			editContext!.Validate();
		}
		catch (UnexpectedResponseException)
		{
			Model.UnexpectedResponseFlag = true;
			editContext!.Validate();
		}

		toggleEdit = !toggleEdit;
		StateHasChanged();
	}

	private void HandleEditButtonClicked()
	{
		toggleEdit = !toggleEdit;
	}

	private void HandleCancelButtonClicked()
	{
		toggleEdit = !toggleEdit;
		Model!.NewName = Model.Name;
	}

	private void HandleDeleteButtonClicked()
	{
		showModal = true;
	}

	private void HandleModalCloseOrCancelButtonClicked()
	{
		showModal = false;
	}

	private async Task HandleModalConfirmButtonClicked()
	{
		showModal = false;

		try
		{
			await inventoryEntryProvider.RemoveInventoryEntryAsync(InventoryEntry.Id);
		}
		catch (EntityWasNotFoundException)
		{
			Model!.EntityWasNullFlag = true;
			editContext!.Validate();
		}
		catch (UnexpectedResponseException)
		{
			Model!.UnexpectedResponseFlag = true;
			editContext!.Validate();
		}
		StateHasChanged();
	}

	private void HandleSignalRUpdatedInventoryEntry(InventoryEntry updatedInventoryEntry)
	{
		if (InventoryEntry.Id == updatedInventoryEntry.Id)
		{
			InventoryEntry.Name = Model!.Name = Model.NewName = updatedInventoryEntry.Name;
			InventoryEntry.InventoryEntryCategories = updatedInventoryEntry.InventoryEntryCategories.ToList();
			Model.CurrentInventoryCategories = updatedInventoryEntry.InventoryEntryCategories.ToList();
			Model.SelectedInventoryCategories = updatedInventoryEntry.InventoryEntryCategories.ToList();
		}
		StateHasChanged();
	}

	public void Dispose()
	{
		hubService.OnUpdatedInventoryEntry -= HandleSignalRUpdatedInventoryEntry;
	}
}