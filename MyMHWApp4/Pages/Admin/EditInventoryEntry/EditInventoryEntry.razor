@page "/edit/inventoryentries"
@using static MHWApp.Library.StaticVariables
@using MHWApp.Library.Exceptions
@using MHWApp.Library.Model
@using MyMHWApp4.HubConnections
@using MyMHWApp4.Pages.GeneralComponents.Select
@using Provider;
@inject InventoryEntryProvider inventoryEntryProvider
@inject CategoryProvider categoryProvider;
@inject IDataBaseUpdatesHubConnection hubService
@inject ILogger<EditInventoryEntry> logger
@implements IDisposable

<header class="container-center header">
    <h2>Inventory Entry</h2>
</header>

<main class="container-top">

    <div class="container-h3"><h3>Create</h3></div>

    <div class="form__container">
        @if(!isLoading)
        {
            <EditForm EditContext="editContext" FormName="inventoryEntry" OnvalidSubmit="Submit">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="form__field">
                    <label for="inventoryEntry-name">Name</label>
                    <InputText name="inventoryEntry-name" @bind-Value="Model!.Name" />
                </div>

                <MultiSelect Label="Select Categories"
                Placeholder="Select"
                T="InventoryEntryCategory"
                Options="@inventoryCategories"
                OptionNameMapper="(InventoryEntryCategory iec) => iec.Category?.Name ?? string.Empty"
                OptionValueMapper="(InventoryEntryCategory inventoryCategory) => inventoryCategory.Id"
                ValueListChanged="HandleSelect">
                </MultiSelect>

                <div class=" form__field form__button">
                    <button type="submit" class="btn btn-primary">
                        Create Inventory Entry
                    </button>
                </div>

            </EditForm>
        }
    </div>

    <div class="container-h3 margin-h3"><h3>Edit</h3></div>

    @if(isLoading){
        <p>Loading ...</p>
    }
    else if (!inventoryEntries!.Any())
    {
        <p>List is empty</p>
    }
    else{
        @foreach (InventoryEntry entry in inventoryEntries!)
        {
            <InventoryEntryCard
            @key="entry.Id"
            InventoryEntry="entry">
            </InventoryEntryCard>
        }
    }

</main>

<footer class="footer"></footer>


@code {
    private bool isLoading = true;
    private bool isFormValid = false;
    private EditContext? editContext;

    [SupplyParameterFromForm]
    private InventoryEntryFormModel? Model { get; set; }

    List<InventoryEntry>? inventoryEntries;
    List<InventoryEntryCategory>? inventoryCategories;

    protected override async Task OnInitializedAsync()
    {
        inventoryEntries = await inventoryEntryProvider.GetInventoryEntriesAsync();
        if (inventoryEntries.Any()) inventoryEntries.Sort((x, y) => x.Name.CompareTo(y.Name));

        inventoryCategories = await categoryProvider.GetInventoryCategoriesAsync();
        if (inventoryCategories.Any()) inventoryCategories.Sort((x, y) => x.Category!.Name.CompareTo(y.Category!.Name));

        Model ??= new InventoryEntryFormModel(inventoryEntries) { };
        editContext = new(Model);
        editContext.OnFieldChanged += HandleFieldChanged;

        hubService.OnNewInventoryEntry += HandleSignalRNewInventoryEntry;
        hubService.OnUpdatedInventoryEntry += HandleSignalRUpdatedInventoryEntry;
        hubService.OnDeletedInventoryEntry += HandleSignalRDeletedInventoryEntry;

        isLoading = false;
        StateHasChanged();
    }

    private void HandleFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        if (editContext is not null)
        {
            isFormValid = !editContext.Validate();
            StateHasChanged();
        }
    }

    private void HandleSelect(List<InventoryEntryCategory> inventoryEntryCategories)
    {
        Model!.InventoryCategories = inventoryEntryCategories;
        StateHasChanged();
    }

    private async Task Submit() => await CreateInventoryEntry();

    private async Task CreateInventoryEntry()
    {
        InventoryEntry newInventoryEntry = new InventoryEntry 
        { 
            Id = 0,
            Name = Model!.Name,
            InventoryEntryCategories = Model.InventoryCategories,
            Order = ORDER_DEFAULT_VALUE
        };

        try
        {
            await inventoryEntryProvider.CreateInventoryEntryAsync(newInventoryEntry);
        }
        catch (EntityAlreadyExistsException)
        {
            Model.EntityAlreadyExistsFlag = true;
            editContext!.Validate();
        }
        catch (EntityWasNullException)
        {
            Model.EntityWasNullFlag = true;
            editContext!.Validate();
        }
        catch (UnexpectedResponseException)
        {
            Model.UnexpectedResponseFlag = true;
            editContext!.Validate();
        }
        StateHasChanged();
    }

    private void HandleSignalRNewInventoryEntry(InventoryEntry newInventoryEntry)
    {
        inventoryEntries!.Add(newInventoryEntry);
        StateHasChanged();
    }

    private void HandleSignalRUpdatedInventoryEntry(InventoryEntry updatedInventoryEntry)
    {
        var existing = inventoryEntries!.Find(ie => ie.Id == updatedInventoryEntry.Id);
        if (existing != null) existing.Name = updatedInventoryEntry.Name;
        StateHasChanged();
    }

    private void HandleSignalRDeletedInventoryEntry(int deletedInventoryEntryId)
    {
        var existing = inventoryEntries!.Find(ge => ge.Id == deletedInventoryEntryId);
        if (existing != null) inventoryEntries.Remove(existing);
        StateHasChanged();
    }

    public void Dispose()
    {
        hubService.OnNewInventoryEntry -= HandleSignalRNewInventoryEntry;
        hubService.OnUpdatedInventoryEntry -= HandleSignalRUpdatedInventoryEntry;
        hubService.OnDeletedInventoryEntry -= HandleSignalRDeletedInventoryEntry;
    }
}
