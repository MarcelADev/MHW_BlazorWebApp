@page "/edit/inventoryentries"
@using MHWApp.Library.Model
@using MyMHWApp4.Pages.GeneralComponents
@using Provider;
@inject InventoryEntryProvider inventoryEntryProvider
@inject CategoryProvider categoryProvider; 

<header class="container-center header">
    <h2>Inventory Entry</h2>
</header>

<main class="container-top">

    <div class="container-h3"><h3>Create</h3></div>

    <div class="form__container">
        @if(!isLoading)
        {
            <EditForm EditContext="editContext" FormName="inventoryEntry" OnvalidSubmit="Submit">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="form__field">
                    <label for="inventoryEntry-name">Name</label>
                    <InputText name="inventoryEntry-name" @bind-Value="Model!.Name" />
                </div>

                <SingleSelect
                T="InventoryEntryCategory"
                Options="@inventoryCategories"
                OptionNameMapper="(InventoryEntryCategory inventoryCategory) => inventoryCategory.Category.Name"
                OptionValueMapper="(InventoryEntryCategory inventoryCategory) => inventoryCategory.Id"
                @bind-Value="Model.InventoryCategory">
                </SingleSelect>

                <div class=" form__field form__button">
                    <button type="submit" class="btn btn-primary">
                        Create Inventory Entry
                    </button>
                </div>

            </EditForm>
        }
    </div>

    <div class="container-h3 margin-h3"><h3>Edit</h3></div>

    @if(isLoading){
        <p>Loading ...</p>
    }
    else if (!inventoryEntries!.Any())
    {
        <p>List is empty</p>
    }
    else{
        @foreach (InventoryEntry entry in inventoryEntries!)
        {
            @* <GameExtensionCard
                GameExtension="extension"
                RemoveGameExtension="HandleRemoveGameExtension">
            </GameExtensionCard> *@
        }
    }

</main>

<footer class="footer"></footer>


@code {
    private bool isLoading = true;
    private bool isFormValid = false;
    private EditContext? editContext;

    [SupplyParameterFromForm]
    private InventoryEntryFormModel? Model { get; set; }

    List<InventoryEntry>? inventoryEntries;
    List<InventoryEntryCategory>? inventoryCategories;

    protected override async Task OnInitializedAsync()
    {
        inventoryEntries = await inventoryEntryProvider.GetInventoryEntriesAsync();
        if (inventoryEntries.Any()) inventoryEntries.Sort((x, y) => x.Name.CompareTo(y.Name));

        inventoryCategories = await categoryProvider.GetInventoryCategoriesAsync();
        if (inventoryCategories.Any()) inventoryCategories.Sort((x, y) => x.Category!.Name.CompareTo(y.Category!.Name));

        Model ??= new InventoryEntryFormModel(inventoryEntries) { };
        if (inventoryCategories.Any()) Model.InventoryCategory = inventoryCategories.First();
        editContext = new(Model);
        editContext.OnFieldChanged += HandleFieldChanged;

        isLoading = false;
        StateHasChanged();
    }

    private void HandleFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        if (editContext is not null)
        {
            isFormValid = !editContext.Validate();
            StateHasChanged();
        }
    }

    private async Task Submit() => await CreateInventoryEntry();

    private async Task CreateInventoryEntry()
    {
