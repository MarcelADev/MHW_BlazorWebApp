@page "/admin/create"
@using MHWApp.Library.Model
@using MyMHWApp4.Pages.GeneralComponents.CustomInput
@using MyMHWApp4.Pages.GeneralComponents.IconButtons
@using MyMHWApp4.Pages.GeneralComponents.Select
@using MyMHWApp4.Provider
@inject IJSRuntime jsRuntime
@inject GameExtensionProvider gameExtensionProvider
@implements IDisposable

<div class="form__container margin-top">
    @if(!isLoading)
    {
        <EditForm EditContext="editContext" FormName="create" OnValidSubmit="Submit">

            <h3 class="h3__custom">Create Category</h3>

            <DataAnnotationsValidator />

            <div class="form__field">
                <label for="create-category-name">Name</label>
                <CustomInputText class="muted" id="create-category-name" @bind-Value="FormModel!.Name" />
                <ValidationMessage For="@(() => FormModel!.Name)" />
            </div>

            <SingleSelect Label="Choose general Game Extension"
            Placeholder="Select"
            T="GameExtension"
            Options="gameExtensions"
            OptionNameMapper="(GameExtension ge) => ge.Name"
            OptionValueMapper="(GameExtension ge) => ge.Id"
            @bind-value="FormModel.GeneralGameExtension"
            MutedLabel="true"
            Disabled="!addArmorSet && !addInventoryEntries" />

            <div class="form__field">
                <InputCheckbox id="create-armorset-checkbox"
                Value="addArmorSet"
                ValueChanged="ToggleArmorSet"
                ValueExpression="() => addArmorSet" />
                <label for="create-armorset-checkbox">Add Armor Set</label>
            </div>

            @if (showArmorSet)
            {
                <div id="animatedBox" class="box @(!addArmorSet ? "exit" : "")">

                    @if (!FormModel.Name.Equals(string.Empty))
                    {
                        <div class="form__field">
                            <InputCheckbox id="change-armorset-prefix-checkbox"
                                           Value="FormModel.UseAlternativeArmorPrefix"
                                           ValueChanged="ToggleArmorPrefix"
                                           ValueExpression="() => FormModel.UseAlternativeArmorPrefix" />
                            <label for="change-armorset-prefix-checkbox">Use alternative Prefix</label>
                        </div>

                        @if (showAlternativeArmorPrefix)
                        {
                            <div id="animatedBox3" class="box purple @(isExitingAlternativePrefix ? "exit" : "")">
                                <div class="form__field">
                                    <label for="change-armorset-prefix-textbox">Name</label>
                                    <CustomInputText class="muted"
                                                     id="change-armorset-prefix-textbox"
                                                     @bind-Value="FormModel!.AlternativeArmorPrefix" />
                                    <ValidationMessage For="@(() => FormModel!.AlternativeArmorPrefix)" />
                                </div>
                            </div>
                        }

                        <div class="form__field input-with-prefix">
                            <label for="create-category-helmet">Helmet</label>
                            <div class="input-prefix-container">
                                <span class="prefix-text">@FormModel!.ArmorPrefix</span>
                                <CustomInputText id="create-category-helmet" @bind-Value="FormModel!.HelmetSuffix" />
                            </div>
                            <ValidationMessage For="@(() => FormModel!.HelmetSuffix)" />

                        </div>

                        <div class="form__field input-with-prefix">
                            <label for="create-category-mail">Mail</label>
                            <div class="input-prefix-container">
                                <span class="prefix-text">@FormModel!.ArmorPrefix</span>
                                <CustomInputText id="create-category-mail" @bind-Value="FormModel!.MailSuffix" />
                            </div>
                            <ValidationMessage For="@(() => FormModel!.MailSuffix)" />
                        </div>

                        <div class="form__field input-with-prefix">
                            <label for="create-category-greaves">Boots</label>
                            <div class="input-prefix-container">
                                <span class="prefix-text">@FormModel!.ArmorPrefix</span>
                                <CustomInputText id="create-category-greaves" @bind-Value="FormModel!.GreavesSuffix" />
                            </div>
                            <ValidationMessage For="@(() => FormModel!.GreavesSuffix)" />
                        </div>
                    }
                    else
                    {
                        <p>Category Name needed</p>
                    }

                </div>
            }

            <div class="form__field">
                <InputCheckbox id="create-inventoryentries-checkbox"
                Value="addInventoryEntries"
                ValueChanged="ToggleInventoryEntries"
                ValueExpression="() => addInventoryEntries" />
                <label for="create-inventoryentries-checkbox">Add Inventory Entries</label>
            </div>

            @if(showInventoryEntries)
            {
                <div id="animatedBox2" class="box @(!addInventoryEntries ? "exit" : "")">

                    @if (!FormModel.Name.Equals(string.Empty))
                    {
                        <div class="multi-select-custom-style">
                            <MultiSelect Label="Common Inventory Entries"
                            Placeholder="Select"
                            T="InventoryEntryCardModel"
                            Options="@commonInventoryEntries"
                            OptionNameMapper="(InventoryEntryCardModel iecm) => iecm.Name"
                            OptionValueMapper="(InventoryEntryCardModel iecm) => iecm.Key"
                            ValueListChanged="HandleSelect"
                            MutedLabel="true"/>
                        </div>

                        <div class="form__field">
                            <label for="create-inventoryentry">Add Inventory Entry</label>
                            <div class="container-left-space-between">
                                <InputText id="create-inventoryentry" @bind-Value="FormModel!.UncommonInventoryEntryName" />
                                <AddButton AddButtonClicked="HandleAddButtonClicked" />
                            </div>
                        </div>

                        <label>List</label>

                        @foreach (InventoryEntryCardModel model in FormModel.SelectedCommonInventoryEntries)
                        {
                            model.GameExtension = FormModel.GeneralGameExtension;
                            <InventoryEntryCard @key="model.Key" 
                            Model="model"
                            RemoveFromList="HandleCommonInventoryEntryRemoved" />
                        }

                        @foreach (InventoryEntryCardModel model in uncommonInventoryentries)
                        {
                            model.GameExtension = FormModel.GeneralGameExtension;
                            <InventoryEntryCard @key="model.Key"
                            Model="model" 
                            RemoveFromList="HandleUncommonInventoryEntryRemoved" />
                        }

                        @if(!FormModel.SelectedCommonInventoryEntries.Any() && !uncommonInventoryentries.Any())
                        {
                            <p>No Inventory Entries</p>
                        }
                    }
                    else
                    {
                        <p>Category Name needed</p>
                    }

                </div>
            }

            <div class=" form__field form__button">
                <button type="submit" class="btn btn-primary">
                    Create
                </button>
            </div>

        </EditForm>
    }
</div>

@code {
    private bool isLoading = true;

    private bool addArmorSet = false;
    private bool showArmorSet = false;

    private bool addInventoryEntries = false;
    private bool showInventoryEntries = false;

    private bool showAlternativeArmorPrefix = false;
    private bool isExitingAlternativePrefix = false;

    private EditContext? editContext;

    private int keyCounter = 1;

    [SupplyParameterFromForm]
    private CreateFormModel? FormModel { get; set; }

    private List<string> commonInventoryEntryNames = new List<string>
    {
        "Tail",
        "Fang",
        "Claw",
    };

    private List<InventoryEntryCardModel> commonInventoryEntries = [];
    private List<InventoryEntryCardModel> uncommonInventoryentries = [];
    private List<GameExtension> gameExtensions = [];

    private DotNetObjectReference<Create>? _dotNetRef;

    protected override async Task OnInitializedAsync()
    {
        gameExtensions = await gameExtensionProvider.GetGameExtensionsAsync();

        foreach (string s in commonInventoryEntryNames)
        {
            commonInventoryEntries.Add(new InventoryEntryCardModel { Key = keyCounter++, Name = s });
        }

        FormModel ??= new CreateFormModel();
        FormModel.UpdateCommonInventoryEntries = HandleUpdateCommonInventoryEntries;
        editContext = new(FormModel);

        _dotNetRef = DotNetObjectReference.Create(this);

        isLoading = false;
    }

    private async Task StartExitAnimation(string elementId, string sectionName)
    {
        await jsRuntime.InvokeVoidAsync("startExitAnimation", elementId, _dotNetRef, sectionName);
    }

    private async Task ToggleArmorSet(bool value)
    {
        if (!value && showArmorSet)
        {
            await StartExitAnimation("animatedBox", "ArmorSet");
        }
        else if (value)
        {
            showArmorSet = true;
        }
        addArmorSet = value;
    }

    private async Task ToggleInventoryEntries(bool value)
    {
        if (!value && showInventoryEntries)
        {
            await StartExitAnimation("animatedBox2", "InventoryEntries");
        }
        else if (value)
        {
            showInventoryEntries = true;
        }
        addInventoryEntries = value;
    }

    private async Task ToggleArmorPrefix(bool value)
    {
        if (!value && showAlternativeArmorPrefix)
        {
            isExitingAlternativePrefix = true;
            await StartExitAnimation("animatedBox3", "AlternativeArmorPrefix");
        }
        else if (value)
        {
            isExitingAlternativePrefix = false;
            showAlternativeArmorPrefix = true;
        }

        FormModel!.UseAlternativeArmorPrefix = value;
    }

    [JSInvokable]
    public void OnAnimationComplete(string section)
    {
        if (section == "ArmorSet")
        {
            showArmorSet = false;
        }
        else if (section == "InventoryEntries")
        {
            showInventoryEntries = false;
        }
        else if (section == "AlternativeArmorPrefix")
        {
            isExitingAlternativePrefix = false;
            showAlternativeArmorPrefix = false;
        }

        StateHasChanged();
    }

    private void HandleUpdateCommonInventoryEntries()
    {
        foreach (InventoryEntryCardModel model in FormModel!.SelectedCommonInventoryEntries)
            model.ExtendedName = FormModel.Name + " " + model.Name;
    }

    private void HandleSelect(List<InventoryEntryCardModel> selectedCommonInventoryEntries)
    {
        FormModel!.SelectedCommonInventoryEntries = selectedCommonInventoryEntries;

        foreach (InventoryEntryCardModel model in FormModel.SelectedCommonInventoryEntries)
            model.ExtendedName = FormModel.Name + " " + model.Name;
        StateHasChanged();
    }

    private void HandleAddButtonClicked()
    {
        if(!FormModel!.UncommonInventoryEntryName.Equals(string.Empty) &&
            !uncommonInventoryentries.Any(iecm => iecm.Name == FormModel.UncommonInventoryEntryName))
        {
            uncommonInventoryentries.Add(new InventoryEntryCardModel { Key = keyCounter++, Name = FormModel.UncommonInventoryEntryName});
            FormModel.UncommonInventoryEntryName = string.Empty;
            StateHasChanged();
        }
    }

    private void HandleCommonInventoryEntryRemoved(InventoryEntryCardModel model)
    {
        FormModel!.SelectedCommonInventoryEntries.RemoveAll(iecm => iecm.Key == model.Key);
        StateHasChanged();
    }

    private void HandleUncommonInventoryEntryRemoved(InventoryEntryCardModel model)
    {
        uncommonInventoryentries.RemoveAll(iecm => iecm.Key == model.Key);
        StateHasChanged();
    }

    private async Task Submit()
    {
        throw new NotImplementedException();
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
    }
}
