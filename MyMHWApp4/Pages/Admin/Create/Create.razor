@page "/admin/create"
@using MHWApp.Library.Model
@using MyMHWApp4.Pages.GeneralComponents.IconButtons
@using MyMHWApp4.Pages.GeneralComponents.Select
@using MyMHWApp4.Provider
@inject GameExtensionProvider gameExtensionProvider
@implements IDisposable

<div class="form__container margin-top">
    @if(!isLoading)
    {
        <EditForm EditContext="editContext" FormName="create" OnValidSubmit="Submit">
            <DataAnnotationsValidator/>
            <ValidationSummary/>

            <div class="box">
                <h3 class="h3__custom">Create Category</h3>

                <div class="form__field">
                    <label for="create-category-name">Name</label>
                    <InputText class="muted" id="create-category-name" @bind-Value="FormModel!.Name" />
                </div>

                <div class="form__field">
                    <InputCheckbox id="create-armorset-checkbox" @bind-value="addArmorSet" />
                    <label for="create-armorset-checkbox">Add Armor Set</label>
                </div>

                <div class="form__field">
                    <InputCheckbox id="create-inventoryentries-checkbox" @bind-value="addInventoryEntries" />
                    <label for="create-inventoryentries-checkbox">Add Inventory Entries</label>
                </div>

                @if(addArmorSet || addInventoryEntries)
                {
                    <SingleSelect Label="Choose general Game Extension"
                    Placeholder="Select"
                    T="GameExtension"
                    Options="gameExtensions"
                    OptionNameMapper="(GameExtension ge) => ge.Name"
                    OptionValueMapper="(GameExtension ge) => ge.Id"
                    @bind-value="FormModel.GeneralGameExtension" 
                    MutedLabel="true"/>
                }

            </div>

            @if(addArmorSet)
            {
                <div class="box">
                    <h3 class="h3__custom">Armor Set</h3>

                    @if (!FormModel.Name.Equals(string.Empty))
                    {
                        <div class="form__field">
                            <label for="create-category-name">Helmet</label>
                            <InputText id="create-category-name" @bind-Value="FormModel!.Helmet" />
                        </div>

                        <div class="form__field">
                            <label for="create-category-name">Mail</label>
                            <InputText id="create-category-name" @bind-Value="FormModel!.Mail" />
                        </div>

                        <div class="form__field">
                            <label for="create-category-name">Boots</label>
                            <InputText id="create-category-name" @bind-Value="FormModel!.Boots" />
                        </div>
                    }
                    else
                    {
                        <p>Category Name needed</p>
                    }

                </div>
            }

            @if(addInventoryEntries)
            {
                <div class="box">
                    <h3 class="h3__custom">Inventory Entries</h3>

                    @if (!FormModel.Name.Equals(string.Empty))
                    {
                        <div class="multi-select-custom-style">
                            <MultiSelect Label="Common Inventory Entries"
                            Placeholder="Select"
                            T="InventoryEntryCardModel"
                            Options="@commonInventoryEntries"
                            OptionNameMapper="(InventoryEntryCardModel iecm) => iecm.Name"
                            OptionValueMapper="(InventoryEntryCardModel iecm) => iecm.Key"
                            ValueListChanged="HandleSelect"
                            MutedLabel="true"/>
                        </div>

                        <div class="form__field">
                            <label for="create-inventoryentry">Add Inventory Entry</label>
                            <div class="container-left-space-between">
                                <InputText id="create-inventoryentry" @bind-Value="FormModel!.UncommonInventoryEntryName" />
                                <AddButton AddButtonClicked="HandleAddButtonClicked" />
                            </div>
                        </div>

                        <label>List</label>

                        @foreach (InventoryEntryCardModel model in FormModel.SelectedCommonInventoryEntries)
                        {
                            model.GameExtension = FormModel.GeneralGameExtension;
                            <InventoryEntryCard @key="model.Key" 
                                                Model="model"
                                                RemoveFromList="HandleCommonInventoryEntryRemoved" />
                        }

                        @foreach (InventoryEntryCardModel model in uncommonInventoryentries)
                        {
                            model.GameExtension = FormModel.GeneralGameExtension;
                            <InventoryEntryCard @key="model.Key"
                                                Model="model" 
                                                RemoveFromList="HandleUncommonInventoryEntryRemoved" />
                        }

                        @if(!FormModel.SelectedCommonInventoryEntries.Any() && !uncommonInventoryentries.Any())
                        {
                            <p>No Inventory Entries</p>
                        }
                    }
                    else
                    {
                        <p>Category Name needed</p>
                    }

                </div>
            }

            <div class=" form__field form__button">
                <button type="submit" class="btn btn-primary">
                    Create
                </button>
            </div>

        </EditForm>
    }
</div>

@code {
    private bool isLoading = true;
    private bool isFormValid = false;
    private bool addArmorSet = false;
    private bool addInventoryEntries = false;
    private EditContext? editContext;

    private int keyCounter = 1;

    [SupplyParameterFromForm]
    private CreateFormModel? FormModel { get; set; }

    private List<string> commonInventoryEntryNames = new List<string>
    {
        "Tail",
        "Fang",
        "Claw",
    };

    private List<InventoryEntryCardModel> commonInventoryEntries = [];
    private List<InventoryEntryCardModel> uncommonInventoryentries = [];
    private List<GameExtension> gameExtensions = [];

    protected override async Task OnInitializedAsync()
    {
        gameExtensions = await gameExtensionProvider.GetGameExtensionsAsync();

        foreach (string s in commonInventoryEntryNames)
        {
            commonInventoryEntries.Add(new InventoryEntryCardModel { Key = keyCounter++, Name = s });
        }

        FormModel ??= new CreateFormModel();
        FormModel.UpdateCommonInventoryEntries = HandleUpdateCommonInventoryEntries;
        editContext = new(FormModel);
        editContext.OnFieldChanged += HandleFieldChanged;

        isLoading = false;
    }

    private void HandleUpdateCommonInventoryEntries()
    {
        foreach (InventoryEntryCardModel model in FormModel.SelectedCommonInventoryEntries)
            model.ExtendedName = FormModel.Name + " " + model.Name;
    }

    private void HandleFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        if (editContext is not null)
        {
            isFormValid = !editContext.Validate();
            StateHasChanged();
        }
    }

    private void HandleSelect(List<InventoryEntryCardModel> selectedCommonInventoryEntries)
    {
        FormModel!.SelectedCommonInventoryEntries = selectedCommonInventoryEntries;

        foreach (InventoryEntryCardModel model in FormModel.SelectedCommonInventoryEntries)
            model.ExtendedName = FormModel.Name + " " + model.Name;
        StateHasChanged();
    }

    private void HandleAddButtonClicked()
    {
        if(!FormModel!.UncommonInventoryEntryName.Equals(string.Empty) &&
            !uncommonInventoryentries.Any(iecm => iecm.Name == FormModel.UncommonInventoryEntryName))
        {
            uncommonInventoryentries.Add(new InventoryEntryCardModel { Key = keyCounter++, Name = FormModel.UncommonInventoryEntryName});
            FormModel.UncommonInventoryEntryName = string.Empty;
            StateHasChanged();
        }
    }

    private void HandleCommonInventoryEntryRemoved(InventoryEntryCardModel model)
    {
        FormModel!.SelectedCommonInventoryEntries.RemoveAll(iecm => iecm.Key == model.Key);
        StateHasChanged();
    }

    private void HandleUncommonInventoryEntryRemoved(InventoryEntryCardModel model)
    {
        uncommonInventoryentries.RemoveAll(iecm => iecm.Key == model.Key);
        StateHasChanged();
    }

    private async Task Submit()
    {
        throw new NotImplementedException();
    }

    public void Dispose()
    {
        if (editContext is not null)
            editContext.OnFieldChanged -= HandleFieldChanged;
    }
}
