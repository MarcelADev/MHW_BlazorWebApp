@using MHWApp.Library.Model
@using MyMHWApp4.Pages.GeneralComponents.CustomInput
@using MyMHWApp4.Pages.GeneralComponents.IconButtons
@using MyMHWApp4.Pages.GeneralComponents.Select
@implements IDisposable

<div class="multi-select-custom-style">
    <MultiSelect Label="Common Inventory Entries"
                 Placeholder="Select"
                 T="InventoryEntryCardModel"
                 Options="@FormModel!.CommonInventoryEntries"
                 OptionNameMapper="(InventoryEntryCardModel iecm) => iecm.Name"
                 OptionValueMapper="(InventoryEntryCardModel iecm) => iecm.Key"
                 ValueListChanged="HandleSelect"/>
</div>

<EditForm EditContext="editContext" FormName="inventory-entry-list" OnValidSubmit="Submit">
    <DataAnnotationsValidator />

    <div class="form__field">
        <label for="inventory-entry-list-add">Add Inventory Entry</label>

        <div class="container-left-space-between">
            <CustomInputText id="inventory-entry-list-add" @bind-Value="FormModel!.UncommonInventoryEntryName" />
            <AddButton IsSubmitButton="true" />
        </div>

        <ValidationMessage For="@(() => FormModel!.UncommonInventoryEntryName)" class="validation-message" />
    </div>
</EditForm>

<label>List</label>

@foreach (InventoryEntryCardModel model in FormModel.SelectedCommonInventoryEntries)
{
    model.GameExtension = FormModel.GeneralGameExtension;
    <InventoryEntryCard @key="model.Key" 
                        Model="model"
                        RemoveFromList="HandleCommonInventoryEntryRemoved" />
}

@foreach (InventoryEntryCardModel model in FormModel.UncommonInventoryentries)
{
    model.GameExtension = FormModel.GeneralGameExtension;
    <InventoryEntryCard @key="model.Key"
                        Model="model" 
                        RemoveFromList="HandleUncommonInventoryEntryRemoved" />
}

@if(!FormModel.SelectedCommonInventoryEntries.Any() && !FormModel.UncommonInventoryentries.Any())
{
    <p>No Inventory Entries</p>
}

@code {
    private bool isFormValid = true;
    private int keyCounter = 1;
    private string nameSnapshot = string.Empty;

    private InventoryEntryListFormModel? FormModel;
    private EditContext? editContext;

    [Parameter] 
    public required Func<string>? GetName { get; set; }
    [Parameter]
    public required Action<string>? SetName { get; set; }

    [Parameter]
    public required Func<GameExtension> GetGeneralGameExtension { get; set; }
    [Parameter]
    public required Action<GameExtension> SetGeneralGameExtension { get; set; }

    protected override async Task OnInitializedAsync()
    {
        FormModel = new InventoryEntryListFormModel(GetName!, SetName!, GetGeneralGameExtension!, SetGeneralGameExtension!);
        foreach (string s in FormModel.CommonInventoryEntryNames)
        {
            FormModel.CommonInventoryEntries.Add(new InventoryEntryCardModel
            {
                Key = keyCounter++,
                Name = s
            });
        }
        FormModel.UpdateCommonInventoryEntries = HandleUpdateCommonInventoryEntries;

        editContext = new(FormModel);
    }

    protected override async Task OnParametersSetAsync()
    {
        var currentName = GetName?.Invoke();
        if (currentName != nameSnapshot)
        {
            nameSnapshot = currentName!;
            FormModel!.Name = nameSnapshot; // Refresh form model state
            StateHasChanged(); // Force UI update
        }
    }

    private void HandleUpdateCommonInventoryEntries()
    {
        foreach (InventoryEntryCardModel model in FormModel!.SelectedCommonInventoryEntries)
            model.ExtendedName = FormModel.Name + " " + model.Name;
    }

    private void HandleSelect(List<InventoryEntryCardModel> selectedCommonInventoryEntries)
    {
        FormModel!.SelectedCommonInventoryEntries = selectedCommonInventoryEntries;

        foreach (InventoryEntryCardModel model in FormModel.SelectedCommonInventoryEntries)
            model.ExtendedName = FormModel.Name + " " + model.Name;
        StateHasChanged();
    }

    /// <summary>
    /// Adds a uncommon Inventory Entry
    /// </summary>
    private void Submit()
    {
        isFormValid = editContext!.Validate();

        FormModel!.UncommonInventoryentries.Add(new InventoryEntryCardModel { Key = keyCounter++, Name = FormModel.UncommonInventoryEntryName });
        FormModel.UncommonInventoryEntryName = string.Empty;
        StateHasChanged();
    }

    private void HandleCommonInventoryEntryRemoved(InventoryEntryCardModel model)
    {
        FormModel!.SelectedCommonInventoryEntries.RemoveAll(iecm => iecm.Key == model.Key);
        StateHasChanged();
    }

    private void HandleUncommonInventoryEntryRemoved(InventoryEntryCardModel model)
    {
        FormModel!.UncommonInventoryentries.RemoveAll(iecm => iecm.Key == model.Key);
        StateHasChanged();
    }

    public void Dispose()
    {
        
    }
}
