@using MHWApp.Library.Exceptions
@using MHWApp.Library.Model
@using MyMHWApp4.HubConnections
@using MyMHWApp4.Pages.GeneralComponents
@using MyMHWApp4.Pages.GeneralComponents.IconButtons
@using MyMHWApp4.Pages.GeneralComponents.Modals
@using MyMHWApp4.Provider
@inject GameExtensionProvider gameExtensionProvider
@inject IDataBaseUpdatesHubConnection hubService
@implements IDisposable

@if(!isLoading)
{
	<div class="form__container">
		<EditForm EditContext="editContext" FormName="session" OnValidSubmit="Submit">
			<DataAnnotationsValidator />
			<ValidationSummary />
			<div class="card">

				<div class="container-left-space-between">
					<p class="header-card">@GameExtension.Name</p>

					<div class="container-right-gap">
						@if (!toggleEdit)
						{
							<EditButton EditButtonClicked="HandleEditButtonClicked"></EditButton>
							<DeleteButton DeleteButtonClicked="HandleDeleteButtonClicked"></DeleteButton>
						}
						else
						{
							<ConfirmButton />
							<CancelButton CancelButtonClicked="HandleCancelButtonClicked"></CancelButton>
						}
					</div>
				</div>

				@if (toggleEdit)
				{
					<div class="form__field">
						<label for="gameExtension-nameChange">Change Name:</label>
						<InputText name="gameExtension-nameChange" @bind-Value="Model!.NewName" />
					</div>
				}
			</div>
		</EditForm>
	</div>
}

@if(showModal){
	<Modal
	Title="Confirm Delete"
	BodyText="@modalBodyText"
	CloseButtonClicked="HandleModalCloseOrCancelButtonClicked"
	SecondaryButtonClicked="HandleModalCloseOrCancelButtonClicked"
	PrimaryButtonClicked="HandleModalConfirmButtonClicked">
	</Modal>
}

@code {
	private bool isLoading = true;
	private bool isFormValid = true;
	private bool toggleEdit = false;
	private bool showModal = false;

	private string? modalBodyText;

	public EditContext? editContext;

	[SupplyParameterFromForm]
	public GameExtensionCardFormModel? Model { get; set; }

	[Parameter]
	public required GameExtension GameExtension { get; set; }

	protected override void OnInitialized()
	{
		modalBodyText = $"Are you sure you want to remove {GameExtension.Name}?";

		Model ??= new GameExtensionCardFormModel(GameExtension);
		editContext = new(Model);

		hubService.OnUpdatedGameExtension += HandleSignalRUpdatedGameExtension;

		isLoading = false;
		StateHasChanged();
	}

	private async Task Submit() => await ChangeGameExtensionName();

	private async Task ChangeGameExtensionName()
	{
		GameExtension.Name = Model!.NewName;

		try
		{
			await gameExtensionProvider.UpdateGameExtensionAsync(GameExtension);
		}
		catch (EntityWasNotFoundException)
		{
			Model.EntityWasNotFoundFlag = true;
			editContext!.Validate();
		}
		catch (UnexpectedResponseException)
		{
			Model.UnexpectedResponseFlag = true;
			editContext!.Validate();
		}
		StateHasChanged();
	}

	private void HandleEditButtonClicked()
	{
		toggleEdit = !toggleEdit;
	}

	private void HandleCancelButtonClicked()
	{
		Model!.NewName = Model.Name;
		toggleEdit = !toggleEdit;
	}

	private void HandleDeleteButtonClicked()
	{
		showModal = true;
	}

	private void HandleModalCloseOrCancelButtonClicked()
	{
		showModal = false;
	}

	private async Task HandleModalConfirmButtonClicked()
	{
		showModal = false;

		try
		{
			await gameExtensionProvider.RemoveGameExtensionAsync(GameExtension.Id);
		}
		catch (EntityWasNotFoundException)
		{
			Model!.EntityWasNullFlag = true;
			editContext!.Validate();
		}
		catch (UnexpectedResponseException)
		{
			Model!.UnexpectedResponseFlag = true;
			editContext!.Validate();
		}
		StateHasChanged();
	}

	private void HandleSignalRUpdatedGameExtension(GameExtension updatedGameExtension)
	{
		if (GameExtension.Id == updatedGameExtension.Id)
		{
			GameExtension.Name = Model!.Name = Model.NewName = updatedGameExtension.Name;
		}
		StateHasChanged();
	}

	public void Dispose()
	{
		hubService.OnUpdatedGameExtension -= HandleSignalRUpdatedGameExtension;
	}
}
