@using MHWApp.Library.Model
@using MyMHWApp4.Pages.GeneralComponents
@using MyMHWApp4.Pages.GeneralComponents.IconButtons
@using MyMHWApp4.Provider
@inject GameExtensionProvider gameExtensionProvider

<div class="card">

	<div class="container-left-space-between">
		<p class="header-card">@GameExtension.Name</p>

		<div class="container-left">
			@if (!toggleEdit)
			{
				<EditButton EditButtonClicked="HandleEditButtonClicked"></EditButton>
				<DeleteButton DeleteButtonClicked="HandleDeleteButtonClicked"></DeleteButton>
			}
			else
			{
				<ConfirmButton @ref="confirmButton" ConfirmButtonClicked="HandleConfirmButtonClicked"></ConfirmButton>
				<CancelButton CancelButtonClicked="HandleCancelButtonClicked"></CancelButton>
			}
		</div>
	</div>

	@if (toggleEdit)
	{
		<EditTextInput 
		Value="@GameExtension.Name" 
		LabelText="Name" 
		PlaceHolder="Game Extension">
		</EditTextInput>
	}

</div>

@if (errors)
{
	@foreach (var error in errorList)
	{
		<div class="alert alert-danger">@error</div>
	}
}

@code {
	private bool toggleEdit = false;
	private bool errors = false;
	private List<string> errorList = [];

	private EditTextInput? changeNameInput;
	private ConfirmButton? confirmButton;

	[Parameter]
	public required GameExtension GameExtension { get; set; }

	[Parameter]
	public required EventCallback<GameExtension> RemoveGameExtension { get; set; }

	private void HandleEditButtonClicked()
	{
		toggleEdit = !toggleEdit;
	}

	private async Task HandleConfirmButtonClicked()
	{
		if (changeNameInput != null) 
		{
			if (changeNameInput.Value == GameExtension.Name)
			{
				errorList.Add("Name wasnt changed!");

				errors = true;
			}

			if (!errors)
			{
				GameExtension.Name = changeNameInput.Value;
				await gameExtensionProvider.UpdateGameExtensionAsync(GameExtension);
			}
		}

		toggleEdit = !toggleEdit;
	}

	private void HandleCancelButtonClicked()
	{
		toggleEdit = !toggleEdit;
	}

	private async Task HandleDeleteButtonClicked()
	{
		await RemoveGameExtension.InvokeAsync(GameExtension);
	}
}
