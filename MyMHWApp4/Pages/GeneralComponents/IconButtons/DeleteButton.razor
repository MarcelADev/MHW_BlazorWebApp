<button class="container-center @(AlternativeDesign ? "alternative" : "")" type="button" @onclick="OnDeleteButtonClicked">
	<span class="material-symbols-outlined @(Glow ? "glow" : "")">
		delete
	</span>
</button>

@code {
	[Parameter]
	public required EventCallback DeleteButtonClicked { get; set; }

	[Parameter]
	public bool AlternativeDesign { get; set; } = false;

	[Parameter]
	public bool Glow { get; set; } = false;

	private async Task OnDeleteButtonClicked()
	{
		await DeleteButtonClicked.InvokeAsync();
	}
}
