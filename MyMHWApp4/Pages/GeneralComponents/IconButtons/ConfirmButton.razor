<button class="container-center" type="button" @onclick="OnConfirmButtonClicked">
	<span class="material-symbols-outlined">
		check
	</span>
</button>

@code {
	[Parameter]
	public required EventCallback ConfirmButtonClicked { get; set; }

	private async Task OnConfirmButtonClicked()
	{
		await ConfirmButtonClicked.InvokeAsync();
	}
}
