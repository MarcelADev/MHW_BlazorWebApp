<button class="container-center @(AlternativeDesign ? "alternative" : "")" type="submit" @onclick="OnConfirmButtonClicked">
	<span class="material-symbols-outlined @(AlternativeDesign ? "alternative" : "")">
		check
	</span>
</button>

@code {
	[Parameter]
	public EventCallback ConfirmButtonClicked { get; set; }

	[Parameter]
	public bool AlternativeDesign { get; set; } = false;

	private async Task OnConfirmButtonClicked()
	{
		await ConfirmButtonClicked.InvokeAsync();
	}
}
