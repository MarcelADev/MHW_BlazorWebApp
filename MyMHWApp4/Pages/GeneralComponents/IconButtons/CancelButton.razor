<button class="container-center @(AlternativeDesign ? "alternative" : "")" type="button" @onclick="OnCancelButtonClicked">
	<span class="material-symbols-outlined @(AlternativeDesign ? "alternative" : "")">
		cancel
	</span>
</button>

@code {
	[Parameter]
	public required EventCallback CancelButtonClicked { get; set; }

	[Parameter]
	public bool AlternativeDesign { get; set; } = false;

	private async Task OnCancelButtonClicked()
	{
		await CancelButtonClicked.InvokeAsync();
	}
}
