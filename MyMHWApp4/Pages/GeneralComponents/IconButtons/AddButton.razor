<button class="container-center" type="@(IsSubmitButton ? "submit" : "button")" @onclick="OnAddButtonClicked">
	<span class="material-symbols-outlined">
		add_2
	</span>
</button>

@code {
	[Parameter]
	public required EventCallback AddButtonClicked { get; set; }

	[Parameter]
	public bool IsSubmitButton { get; set; } = false;

	private async Task OnAddButtonClicked()
	{
		await AddButtonClicked.InvokeAsync();
	}
}
