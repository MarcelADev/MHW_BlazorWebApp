@using MHWApp.Library.Model

<li>
	<button class="container-button" @onclick="OnClicked">
		@IdAndValue.Value
	</button>
</li>

@code {
	[Parameter]
	public required IdAndValue IdAndValue { get; set; }

	[Parameter]
	public required EventCallback<IdAndValue> Clicked { get; set; }

	private void OnClicked(){
		Clicked.InvokeAsync(IdAndValue);
	}
}