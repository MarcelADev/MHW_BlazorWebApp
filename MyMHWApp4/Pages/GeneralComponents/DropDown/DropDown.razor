@using MHWApp.Library.Model

<div class="dropdown-container">

	<button class="dropdown-button" @onclick="ToggleDropdown">
		@ChosenValuePair.Value
	</button>

	@if (isDropdownOpen)
	{
		<ul class="dropdown-list">
			@foreach (ValuePair vP in ValuePairList)
			{
				<DropDownComponent ValuePair="vP" Clicked="HandleClicked"></DropDownComponent>
			}
		</ul>
	}
</div>

@code {
	private bool isDropdownOpen = false;

	[Parameter]
	public required List<ValuePair> ValuePairList { get; set; }

	[Parameter]
	public required ValuePair ChosenValuePair { get; set; }

	private void ToggleDropdown()
	{
		isDropdownOpen = !isDropdownOpen;
	}

	public void HandleClicked(ValuePair valuePair)
	{
		ChosenValuePair = valuePair;
		isDropdownOpen = false;
	}
}