@using MHWApp.Library.Model

<div class="dropdown-container">

	<button class="dropdown-button" @onclick="ToggleDropdown">
		@ChosenTtem.Value
	</button>

	@if (isDropdownOpen)
	{
		<ul class="dropdown-list">
			@foreach (IdAndValue vP in ValuePairList)
			{
				<DropDownComponent IdAndValue="vP" Clicked="HandleClicked"></DropDownComponent>
			}
		</ul>
	}
</div>

@code {
	private bool isDropdownOpen = false;

	[Parameter]
	public required List<IdAndValue> ValuePairList { get; set; }

	[Parameter]
	public required IdAndValue ChosenTtem { get; set; }

	[Parameter]
	public required EventCallback<IdAndValue> ChosenItemChanged { get; set; }

	private void ToggleDropdown()
	{
		isDropdownOpen = !isDropdownOpen;
	}

	public void HandleClicked(IdAndValue idAndValue)
	{
		ChosenTtem = idAndValue;
		isDropdownOpen = false;
		OnChosenItemChanged();
	}

	private void OnChosenItemChanged()
	{
		ChosenItemChanged.InvokeAsync(ChosenTtem);
	}
}