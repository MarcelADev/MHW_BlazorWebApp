@using MHWApp.Library.Model
@using MyMHWApp4.Pages.GeneralComponents.Select
@using MyMHWApp4.Provider
@using static MHWApp.Library.StaticVariables
@inject ParticipatorProvider participatorProvider
@inject PlayerProvider playerProvider
@implements IDisposable

<div class="modal-backdrop show"></div>
<div class="modal fade show" style="display:block" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Edit Session</h5>
                <button @onclick="OnCloseButtonClicked" type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">

                @if (!isLoading)
                {
                    <EditForm EditContext="editContextChangeName" FormName="editSessionName" OnValidSubmit="SubmitNameChange">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="form__field">
                            <label for="editSessionName-name">Name</label>
                            <InputText id="editSessionName-name" @bind-Value="ChangeNameModel!.NewName"></InputText>
                        </div>

                        <div class=" form__field form__button">
                            <button type="submit" class="btn btn-primary">
                                Save Changes
                            </button>
                        </div>

                    </EditForm>

                    <AuthorizeView>
                        <Authorized Context="authContext">
                            @{
                                bool isAdmin = authContext.User.IsInRole(ADMIN_ROLE) || authContext.User.IsInRole(MASTER_ROLE);
                            }
                            @if(isAdmin)
                            {
                                <EditForm EditContext="editContextRemoveParticipator" FormName="removeParticipator" OnValidSubmit="SubmitRemoveParticipator">
                                    <DataAnnotationsValidator />
                                    <ValidationSummary />

                                    <MultiSelect Label="Remove Participators"
                                    Placeholder="Select"
                                    T="Participator"
                                    Options="participators"
                                    OptionNameMapper="(Participator p) => p.Player!.UserName"
                                    OptionValueMapper="(Participator p) => p.Id"
                                    ValueList="RemoveParticipatorModel!.SelectedParticipators"
                                    ValueListChanged="HandleRemoveSelect">
                                    </MultiSelect>

                                    <div class=" form__field form__button">
                                        <button type="submit" class="btn btn-primary">
                                            Save changes
                                        </button>
                                    </div>

                                </EditForm>

                                <EditForm EditContext="editContextAddParticipator" FormName="addParticipator" OnValidSubmit="SubmitAddParticipator">
                                    <DataAnnotationsValidator />
                                    <ValidationSummary />

                                    <MultiSelect Label="Add Participators"
                                    Placeholder="Select"
                                    T="Player"
                                    Options="players"
                                    OptionNameMapper="(Player p) => p.UserName"
                                    OptionValueMapper="(Player p) => p.Id"
                                    ValueList="AddParticipatorModel!.SelectedPlayers"
                                    ValueListChanged="HandleAddSelect">
                                    </MultiSelect>

                                    <div class=" form__field form__button">
                                        <button type="submit" class="btn btn-primary">
                                            Save changes
                                        </button>
                                    </div>

                                </EditForm>
                            }

                        </Authorized>
                    </AuthorizeView>
                }

            </div>

        </div>
    </div>
</div>

@code{
    private bool isLoading = true;
    private bool isFormValid = true;

    private EditContext? editContextChangeName;
    private EditContext? editContextRemoveParticipator;
    private EditContext? editContextAddParticipator;

    private List<Participator>? participators;
    private List<Player>? players;

    [SupplyParameterFromForm]
    private ChangeNameFormModel? ChangeNameModel { get; set; }

    [SupplyParameterFromForm]
    private RemoveParticipatorFormModel? RemoveParticipatorModel { get; set; }

    [SupplyParameterFromForm]
    private AddParticipatorFormModel? AddParticipatorModel { get; set; }

    [Parameter]
    public required Session Session { get; set; }

    [Parameter]
    public required EventCallback CloseButtonClicked { get; set; }

    protected override async Task OnInitializedAsync()
    {
        participators = await participatorProvider.GetParticipatorsAsync(Session.Id);
        players = (await playerProvider.GetPlayersAsync()).Where(p => !participators.Any(pa => pa.PlayerId == p.Id)).ToList();

        ChangeNameModel = new ChangeNameFormModel(Session.Name);
        RemoveParticipatorModel = new RemoveParticipatorFormModel(participators);
        AddParticipatorModel = new AddParticipatorFormModel(players);

        editContextChangeName = new(ChangeNameModel);
        editContextChangeName.OnFieldChanged += HandleChangeNameFieldChanged;

        editContextRemoveParticipator = new(RemoveParticipatorModel);
        editContextRemoveParticipator.OnFieldChanged += HandleRemoveParticipatorFieldChanged;

        editContextAddParticipator = new(AddParticipatorModel);
        editContextAddParticipator.OnFieldChanged += HandleAddParticipatorFieldChanged;

        isLoading = false;
        StateHasChanged();
    }

    private void HandleRemoveSelect(List<Participator> participators)
    {
        isFormValid = !editContextRemoveParticipator!.Validate();
        StateHasChanged();
    }

    private void HandleAddSelect(List<Player> players)
    {
        isFormValid = !editContextAddParticipator!.Validate();
        StateHasChanged();
    }

    private void HandleChangeNameFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        if (editContextChangeName is not null)
        {
            isFormValid = !editContextChangeName.Validate();
            StateHasChanged();
        }
    }

    private void HandleRemoveParticipatorFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        if (editContextRemoveParticipator is not null)
        {
            isFormValid = !editContextRemoveParticipator.Validate();
            StateHasChanged();
        }
    }

    private void HandleAddParticipatorFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        if (editContextAddParticipator is not null)
        {
            isFormValid = !editContextAddParticipator.Validate();
            StateHasChanged();
        }
    }

    private void SubmitNameChange()
    {

    }

    private void SubmitRemoveParticipator()
    {
        
    }

    private void SubmitAddParticipator()
    {

    }

    private void OnCloseButtonClicked()
    {
		CloseButtonClicked.InvokeAsync();
	}

    public void Dispose()
    {
        if (editContextChangeName is not null) editContextChangeName.OnFieldChanged -= HandleChangeNameFieldChanged;
        if (editContextRemoveParticipator is not null) editContextRemoveParticipator.OnFieldChanged -= HandleRemoveParticipatorFieldChanged;
        if (editContextAddParticipator is not null) editContextAddParticipator.OnFieldChanged -= HandleAddParticipatorFieldChanged;
    }
}