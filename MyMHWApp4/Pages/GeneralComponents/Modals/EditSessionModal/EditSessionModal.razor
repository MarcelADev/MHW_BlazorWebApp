@using MHWApp.Library.Model
@using MyMHWApp4.Pages.GeneralComponents.Select
@using MyMHWApp4.Provider
@using static MHWApp.Library.StaticVariables
@inject ParticipatorProvider participatorProvider

<div class="modal-backdrop show"></div>
<div class="modal fade show" style="display:block" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">

			<div class="modal-header">
				<h5 class="modal-title">Edit Session</h5>
				<button @onclick="OnCloseButtonClicked" type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>

			@if(!isLoading)
			{
				<EditForm EditContext="editContext" FormName="editSession" OnValidSubmit="Submit">

					<DataAnnotationsValidator />	
					<ValidationSummary />

					<div class="form__field">
						<label for="editSession-name">Name</label>
						<InputText id="editSession-name" @bind-Value="Model!.NewName"></InputText>
					</div>

					<MultiSelect T="Participator"
								 Options="participators"
								 OptionNameMapper="(Participator p) => p.Player!.UserName"
								 OptionValueMapper="(Participator p) => p.Id">

					</MultiSelect> 
					@* TO DO: FINISHH MULTI SELECT *@

				</EditForm>
			}


			@* <div class="modal-body">
				<p>Removing your Participation deletes all your progress in this Session!</p>
				<br>
				<p>Deleting the entire session is permanent! (Only Admins can delete Sessions)</p>
			</div>

			<div class="modal-footer">
				<button @onclick="OnRemoveParticipationButtonClicked" type="button" class="btn btn-danger">Remove your Participation</button>

				<AuthorizeView>
					<Authorized>
						@{
							bool canDelete = context.User.IsInRole(ADMIN_ROLE) || context.User.IsInRole(MASTER_ROLE);
						}
						<button @onclick="OnDeleteSessionButtonClicked"
								disabled="@(!canDelete)"
								class="btn @(canDelete ? "btn-danger" : "btn-dark")"
								type="button">
							Delete Session
						</button>
					</Authorized>
				</AuthorizeView>

			</div> *@

		</div>
	</div>
</div>

@code{
	private bool isLoading = true;

	private EditContext? editContext;
	private List<Participator>? participators;

	[SupplyParameterFromForm]
	private EditSessionModalFormModel? Model { get; set; }

	[Parameter]
	public required int SessionId { get; set; }

	[Parameter]
	public required EventCallback CloseButtonClicked { get; set; }

	[Parameter]
	public required EventCallback RemoveParticipationButtonClicked { get; set; }

	[Parameter]
	public required EventCallback DeleteSessionButtonClicked { get; set; }

	protected override async Task OnInitializedAsync()
	{
		participators = await participatorProvider.GetParticipatorsAsync(SessionId);

		isLoading = false;
	}

	private void Submit() => ChangeSession();

	private void ChangeSession()
	{
		
	}

	private void OnCloseButtonClicked()
	{
		CloseButtonClicked.InvokeAsync();
	}

	private void OnRemoveParticipationButtonClicked()
	{
		RemoveParticipationButtonClicked.InvokeAsync();
	}

	private void OnDeleteSessionButtonClicked()
	{
		DeleteSessionButtonClicked.InvokeAsync();
	}
}