@using MHWApp.Library.DTO
@using MHWApp.Library.Model
@using MyMHWApp4.Pages.GeneralComponents.Select
@using MyMHWApp4.Provider
@using static MHWApp.Library.StaticVariables
@inject ParticipatorProvider participatorProvider
@inject PlayerProvider playerProvider
@implements IDisposable

<div class="modal-backdrop show"></div>
<div class="modal fade show" style="display:block" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Edit @Session.Name</h5>
                <button @onclick="OnCloseButtonClicked" type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            @if (!isLoading)
            {
                <AuthorizeView>
                    <Authorized Context="authContext">
                        @{
                            bool isAdmin = authContext.User.IsInRole(ADMIN_ROLE) || authContext.User.IsInRole(MASTER_ROLE);
                        }
                        <EditForm EditContext="editContext" FormName="editSessionName" OnValidSubmit="Submit">
                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <div class="modal-body">
                                <div class="form__field">
                                    <label for="editSessionName-name">Change Name</label>
                                    <InputText id="editSessionName-name" @bind-Value="Model!.NewName"></InputText>
                                </div>

                                @if (isAdmin)
                                {
                                    <MultiSelect Label="Remove Participators"
                                                 Placeholder="Select"
                                                 T="Participator"
                                                 Options="participators"
                                                 OptionNameMapper="(Participator p) => p != null ? p.Player?.UserName : string.Empty"
                                                 OptionValueMapper="(Participator p) => p.Id"
                                                 ValueList="Model!.SelectedParticipators"
                                                 ValueListChanged="HandleRemoveSelect">
                                    </MultiSelect>

                                    <MultiSelect Label="Add Participators"
                                                 Placeholder="Select"
                                                 T="Player"
                                                 Options="players"
                                                 OptionNameMapper="(Player p) => p.UserName"
                                                 OptionValueMapper="(Player p) => p.Id"
                                                 ValueList="Model!.SelectedNewPlayers"
                                                 ValueListChanged="HandleAddSelect">
                                    </MultiSelect>
                                }
                            </div>

                            <div class="modal-footer">
                                <button type="submit" class="btn btn-primary inverted">
                                    Reset Form
                                </button>

                                <button type="submit" class="btn btn-primary purple">
                                    Save changes
                                </button>
                            </div>

                        </EditForm>
                    </Authorized>
                </AuthorizeView>
            }
        </div>
    </div>
</div>

@code{
    private bool isLoading = true;
    private bool isFormValid = true;

    private EditContext? editContext;

    private List<Participator>? participators;
    private List<Player>? players;

    [SupplyParameterFromForm]
    private EditSessionFormModel? Model { get; set; }

    [Parameter]
    public required Session Session { get; set; }

    [Parameter]
    public required EventCallback CloseButtonClicked { get; set; }

    protected override async Task OnInitializedAsync()
    {
        participators = await participatorProvider.GetParticipatorsAsync(Session.Id);
        players = (await playerProvider.GetPlayersAsync()).Where(p => !participators.Any(pa => pa.PlayerId == p.Id)).ToList();

        Model = new EditSessionFormModel(Session.Name, players, participators);
        editContext = new(Model);
        editContext.OnFieldChanged += HandleFieldChanged;

        isLoading = false;
        StateHasChanged();
    }

    private void OnCloseButtonClicked()
    {
        CloseButtonClicked.InvokeAsync();
    }

    private void HandleRemoveSelect(List<Participator> participators)
    {
        isFormValid = !editContext!.Validate();
        StateHasChanged();
    }

    private void HandleAddSelect(List<Player> players)
    {
        isFormValid = !editContext!.Validate();
        StateHasChanged();
    }

    private void HandleFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        if (editContext is not null)
        {
            isFormValid = !editContext.Validate();
            StateHasChanged();
        }
    }

    private void Submit() => ChangeSession();

    private void ChangeSession()
    {
        UpdateSessionDTO dto = new UpdateSessionDTO
        {
            UpdatedSession = new Session
            {
                Id = Session.Id,
                Name = Model!.NewName,
                Date = Session.Date,
                DayCount = Session.DayCount,
                MaxDays = Session.MaxDays
            },
            RemoveParticipators = Model.SelectedParticipators,
            AddParticipators = []
        };

        foreach (Player player in Model.SelectedNewPlayers) 
            dto.AddParticipators.Add(new Participator { Id = 0, PlayerId = player.Id, SessionId = Session.Id, WeaponTypeId = 1});   //TO DO WEAPON TYPE AUF DER PAGE
    }

    public void Dispose()
    {
        if (editContext is not null) editContext.OnFieldChanged -= HandleFieldChanged;
    }
}