<label class="container-property">
	<input id="checkbox" name="PropertyInput" type="checkbox" checked="@IsChecked" @bind-value="Value" />
	@LabelText
</label>

@code {
	public bool Value { get; set; } = false;

	[Parameter]
	public required string LabelText { get; set; }

	[Parameter]
	public bool IsChecked { get; set; }
}