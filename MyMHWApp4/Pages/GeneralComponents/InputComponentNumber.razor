<div class="propertyContainer">
	<label for="PropertyInput">@LabelText</label>
	<br />
	<input name="PropertyInput" type="number" @bind-value="input" @oninput="OnPropertyChanged" />
</div>

@code {
	private int input;

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();

		input = DefaultValue;
	}

	[Parameter]
	public int DefaultValue { get; set; } = 0;

	[Parameter]
	public required string LabelText { get; set; }

	[Parameter]
	public required EventCallback<int> PropertyChanged { get; set; }

	private async Task OnPropertyChanged()
	{
		await PropertyChanged.InvokeAsync(input);
	}
}
