﻿@using MHWApp.Library.Model;
@inject IJSRuntime JSRuntime
@inject ILogger<Select<T>> Logger
@typeparam T
@implements IAsyncDisposable

@*Prefer native component on mobile devices.*@
@if (os == "Android" || os == "iOS")
{
	@if (null != Label)
	{
		<label for="select" class="@labelClass">@Label</label>
	}
	<select name="select" @attributes="selectAttributes" @onchange="HandleNativeChange">
		@foreach (var option in Options)
		{
			<option value="@OptionValueMapper(option)">@OptionNameMapper(option)</option>
		}
	</select>
}
else
{
	<div class="anchor">
		@if (null != Label)
		{
			<label id="@Id-label"
				   class="@labelClass"
				   @onclick:preventDefault ="@Disabled"
				   @onclick:stopPropagation ="@Disabled"
				   @attributes ="labelAttributes">
				@Label
			</label>
		}

		<div id="mhwapp-single-select-@Id" class="select" aria-labelledby="@Id-label">
			<div class="select__trigger @(Disabled ? "disabled" : "")" 
				 tabindex="@(Disabled ? -1 : 0)"
				 aria-disabled="@Disabled">

				<div aria-hidden="true" class="select-content">

					@if (null != Value)
					{
						@OptionNameMapper(Value)
					}
					else
					{
						@Placeholder
					}

				</div>
				<!-- Google Icon -->
				<span class="material-symbols-outlined icon__color-black">
					keyboard_arrow_down
				</span>
			</div>

			<div class="select-dropdown" tabindex="@(Disabled ? -1 : 0)">
				@foreach (var option in Options)
				{
					<div class="select-option">
						<label class="select-option-label">
							<input checked="@(IsSelected(option))"
								   class="select-option-label-hidden"
								   id="select-@Id-@(OptionValueMapper(option))" 
								   name="select-@(OptionValueMapper(option))"
								   type="checkbox"
								   disabled="@Disabled"
								   @onchange="Disabled ? null : (_) => HandleCustomChange(option)" />
							@OptionNameMapper(option)
						</label>
						@if (IsSelected(option))
						{
							<!-- Google Icon -->
							<span class="material-symbols-outlined icon__color-blue">
								check
							</span>
						}
					</div>
				}
			</div>
		</div>

		<div class="select_content-overlay"></div>
	</div>
}