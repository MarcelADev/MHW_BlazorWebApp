﻿@using MHWApp.Library.Model;
@inject IJSRuntime JSRuntime
@inject ILogger<Select<T>> Logger
@typeparam T

@*Prefer native component on mobile devices.*@
@if (os == "Android" || os == "iOS")
{
    @if (null != Label)
    {
        <label for="select">@Label</label>
    }
    <select name="select" @attributes="selectAttributes" @onchange="HandleNativeChange">
        @foreach (var option in Options)
        {
            <option value="@OptionValueMapper(option)">@OptionNameMapper(option)</option>
        }
    </select>
}
else
{
    <div class="anchor">
        @if (null != Label)
        {
            <label>@Label</label>
        }

        <div class="select">
            <div class="select__trigger" tabindex="0">
                <div aria-hidden="true" class="select-content">
                    @if (IsMultipleSelection())
                    {
                        if (ValueList.Count == 0)
                        {
                            @Placeholder
                        }
                        @foreach (var selected in ValueList)
                        {
                            <button inert type="button" class="btn select-chip">
                                @* <span>
                                    @OptionNameMapper(selected)
                                    <i class="ms-Icon ms-Icon--ChromeClose" />
                                </span> *@
                                <span>
                                    @OptionNameMapper(selected)
                                    <span class="material-symbols-outlined">
                                        close
                                    </span>
                                </span>
                                
                            </button>
                        }
                    }
                    else
                    {
                        if (null != Value)
                        {
                            @OptionNameMapper(Value)
                        }
                        else
                        {
                            @Placeholder
                        }
                    }
                </div>
                <i class="ms-Icon ms-Icon--ChevronDownSmall" />
            </div>

            <div class="select-dropdown" tabindex="0">
                @foreach (var option in Options)
                {
                    <div class="select-option">
                        <label class="select-option-label">
                            <input checked="@(IsSelected(option))"
                                   class="@((!IsMultipleSelection()) ? "select-option-label-hidden" : "")"
                                   id="vu-select-@id-@(OptionValueMapper(option))" name="vu-select-@(OptionValueMapper(option))"
                                   type="checkbox" @onchange="(_) => HandleCustomChange(option)" />
                            @OptionNameMapper(option)
                        </label>
                        @if ((!IsMultipleSelection()) && IsSelected(option))
                        {
                            <i class="ms-Icon ms-Icon--CheckMark" />
                        }
                    </div>
                }
            </div>
        </div>

        <div class="select_content-overlay">
            @if (IsMultipleSelection())
            {
                @foreach (var selected in ValueList)
                {
                    <button tabindex="-1" type="button" class="btn select-chip select-chip-clickable"
                            @onclick="@((_) => HandleCustomChange(selected))">
                        <span>
                            @OptionNameMapper(selected)
                            <i class="ms-Icon ms-Icon--ChromeClose" />
                        </span>
                    </button>
                }
            }

        </div>
    </div>
}