<div class="modal-backdrop show"></div>
<div class="modal fade show" style="display:block" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">

			<div class="modal-header">
				<h5 class="modal-title">@Title</h5>
				<button @onclick="OnCloseButtonClicked" type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>

			<div class="modal-body">
				<p>@BodyText</p>
			</div>

			<div class="modal-footer">
				<button @onclick="OnSecondaryButtonClicked" type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
				<button @onclick="OnPrimaryButtonClicked" type="button" class="btn btn-danger">Delete</button>
			</div>

		</div>
	</div>
</div>

@code {
	[Parameter]
	public required string Title { get; set; }

	[Parameter]
	public required string BodyText { get; set; }


	[Parameter]
	public required EventCallback CloseButtonClicked { get; set; }

	private void OnCloseButtonClicked()
	{
		CloseButtonClicked.InvokeAsync();
	}


	[Parameter]
	public required EventCallback SecondaryButtonClicked { get; set; }

	private void OnSecondaryButtonClicked()
	{
		SecondaryButtonClicked.InvokeAsync();
	}


	[Parameter]
	public required EventCallback PrimaryButtonClicked { get; set; }

	private void OnPrimaryButtonClicked()
	{
		PrimaryButtonClicked.InvokeAsync();
	}
}