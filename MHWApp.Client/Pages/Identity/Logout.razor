@page "/logout"
@using MHWApp.Client.Identity
@using MHWApp.Client.Provider.Interfaces
@inject IAccountManagement accountManagement
@inject NavigationManager NavigationManager

<PageTitle>Logout</PageTitle>
<main class="mainContainer">

<h1>Logout</h1>

    <AuthorizeView @ref="authView">
        <Authorized>
            <div class="alert alert-info">Logging you out...</div>
        </Authorized>
        <NotAuthorized>
            <div class="alert alert-success">You're logged out. <a href="/login" @onclick="OnClick">Log in.</a></div>
            <p>You will be automatically redirected to the Start Menu. If not click <a href="" @onclick="OnClick">here</a></p>
        </NotAuthorized>
    </AuthorizeView>

</main>

@code {
    private AuthorizeView? authView;
	private bool clickedUrl = false;

    protected override async Task OnInitializedAsync()
    {
        if (await accountManagement.CheckAuthenticatedAsync())
        {
            await accountManagement.LogoutAsync();
        }

        await Task.Delay(5000);

        if(!clickedUrl) NavigationManager.NavigateTo("/");
    }

    private void OnClick()
    {
		clickedUrl = true;
    }
}