@if (FeatureFlags.IsRegisterEnabled)
{
    @page "/register"
    @using MHWApp.Client.Identity
    @using MHWApp.Client.GeneralComponents.CustomInput
    @using MHWApp.Client.Services
    @using MHWApp.Client.Utils
    @using MHWApp.Library.DTO.Identity
    @using System.ComponentModel.DataAnnotations
    @using MHWApp.Library.Exceptions
    @inject IAccountManagement identityProvider
    @inject IGlobalAlertService alertService
    @implements IDisposable

    <PageTitle>Register</PageTitle>

    @* <div class="alert-container">
    @foreach (string success in successes)
        {
            <div class="alert alert-success">@success</div>
        }
        @foreach (string danger in dangers)
        {
            <div class="alert alert-danger">@danger</div>
        }
        @foreach (string warning in primeVu)
        {
            <div class="alert alert-warning">
                <div class="prime-vu__container">
                    <div class="prime-vu__golden-text">@warning</div>
                    <div class="prime-vu__text-shadow">@warning</div>
                </div>
            </div>
        }
    </div> *@

    <div class="container-top theme-purple container-height">

        @* <div class="top-space"/> *@

        <header class="container-center header">
            <h1>Register</h1>
        </header>

        <AuthorizeView>
            <Authorized>
                <LoginRedirect></LoginRedirect>
            </Authorized>
            <NotAuthorized Context="notAuthorizedContext">
            
                <div class="form__container">
                    @if(!isLoading)
                    {
                        <EditForm EditContext="editContext" FormName="register" OnValidSubmit="DoRegisterAsync">

                            <div class="form__field">
                                <label for="register-userName">Username</label>
                                <CustomInputText id="register-userName"
                                                    AdditionalAttributes="FormModel!.AdditionalAttributes"
                                                    @bind-Value="FormModel!.UserName" />
                                <ValidationMessage For="@(() => FormModel!.UserName)" />
                            </div>

                            <div class="form__field">
                                <label for="register-password-one">Password</label>
                                <CustomInputText id="register-password-one"
                                                    InputType="password"
                                                    @bind-Value="FormModel!.PasswordOne" />
                                <ValidationMessage For="@(() => FormModel!.PasswordOne)" />
                            </div>

                            <div class="form__field">
                                <label for="register-password-two">Confirm Password</label>
                                <CustomInputText id="register-password-two"
                                                    InputType="password"
                                                    @bind-Value="FormModel!.PasswordTwo" />
                                <ValidationMessage For="@(() => FormModel!.PasswordTwo)" />
                            </div>

                            <div class=" form__field form__button">
                                <button type="submit" class="btn btn-primary btn-register">
                                    Register
                                </button>
                            </div>

                        </EditForm>
                    }
                </div>
            
            </NotAuthorized>
        </AuthorizeView>
    </div>

    @code {
        private bool isLoading = true;
        private bool validateOnlyModified = true;

        private List<string> primeVu = [];
        private List<string> dangers = [];
        private List<string> successes = [];

        private EditContext? editContext;
        private ValidationMessageStore? _messageStore;

        [SupplyParameterFromForm]
        private RegisterFormModel? FormModel { get; set; }

        protected override void OnInitialized()
        {
            FormModel = new();
            editContext = new EditContext(FormModel);
            editContext.OnFieldChanged += HandleFieldChanged;

            _messageStore = new ValidationMessageStore(editContext);

            isLoading = false;
        }

        private void HandleFieldChanged(object? sender, FieldChangedEventArgs e)
        {
            if (editContext is not null) 
            {
                Utils.ManualModelValidator.ValidateModel(editContext, FormModel!, _messageStore!, onlyModified: validateOnlyModified);
                StateHasChanged();
            }
        }

        public async Task DoRegisterAsync()
        {
            Utils.ManualModelValidator.ValidateModel(editContext!, FormModel!, _messageStore!, onlyModified: false);

            bool hasValidationErrors = editContext!.GetValidationMessages().Any();

            if (hasValidationErrors)
            {
                validateOnlyModified = false;

                Console.WriteLine("Not a valid Submit bruh");
                return;
            }
            else
            {
                validateOnlyModified = true;
            }

            try
            {
                await identityProvider.RegisterAsync(new IdentityDTO { UserName = FormModel!.UserName, Password = FormModel.PasswordOne });
            }
            catch(ConflictException e)
            {
                if (e.ConflictTitle.Contains("Prime Vu"))
                    alertService.ShowPrimeVu(e.ConflictTitle);
                else
                    alertService.ShowDanger(e.ConflictTitle);
            }
        }

        public void Dispose()
        {
            if (editContext is not null) editContext.OnFieldChanged -= HandleFieldChanged;
        }

        internal class RegisterFormModel : IValidatableObject
        {
            public Dictionary<string, object> AdditionalAttributes = new()
            {
                { "autofocus", "on" },
            };

            public string UserName { get; set; } = string.Empty;
            public string PasswordOne { get; set; } = string.Empty;
            public string PasswordTwo { get; set; } = string.Empty;

            public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
            {
                if(UserName.Equals(string.Empty))
                {
                    yield return new ValidationResult("Username is required", [nameof(UserName)]);
                }
                if(PasswordOne.Equals(string.Empty))
                {
                    yield return new ValidationResult("Password is required.", [nameof(PasswordOne)]);
                }
                if (PasswordOne != PasswordTwo)
                {
                    yield return new ValidationResult("Passwords do not match.", [nameof(PasswordTwo)]);
                }
            }
        }
    }

}