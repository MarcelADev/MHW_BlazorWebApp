@page "/login"
@using MHWApp.Client.Identity
@using MHWApp.Client.Pages.GeneralComponents
@using System.ComponentModel.DataAnnotations;
@inject IAccountManagement Acct

<PageTitle>Login</PageTitle>

<AuthorizeView>
	<Authorized>
		<LoginRedirect></LoginRedirect>
	</Authorized>
	<NotAuthorized Context="authContext">

		<div class="theme-purple">

			<header class="container-center header">

				<h2>Login</h2>

			</header>

			<main class="container-top main">

				<div class="container-top inner-bot">
					<EditForm EditContext="editContext" FormName="login" OnValidSubmit="DoLoginAsync">
						<DataAnnotationsValidator />
						<ValidationSummary />

						<div class="container-center inner-top">

							@if (errorList.Length > 0)
							{
								@foreach (var error in errorList)
								{
									<div class="alert alert-danger">@error</div>
								}
							}

						</div>

						<div class="container-property-identity">
							<label for="email">Email:</label>
							<br />
							<input required id="email" name="emailInput" placeholder="Enter your email address" type="email" autocomplete="on" @bind-value="Model!.Email" />
						</div>

						<div class="container-property-identity">
							<label for="password">Password:</label>
							<br />
							<input required id="password" name="passwordInput" placeholder="Enter your password" type="password" autocomplete="on" @bind-value="Model!.Password" />
						</div>

						<br />

						<div class="container-property-actions">
							<button class="button" type="submit">Login</button>

							<a class="link-return" href="">🠔 Return</a>
						</div>
					</EditForm>
				</div>
			</main>
		</div>
	</NotAuthorized>
</AuthorizeView>

@code {
	private string[] errorList = [];

	[SupplyParameterFromForm]
	private LoginFormModel? Model { get; set; }

	private EditContext? editContext;


	protected override void OnInitialized()
	{
		Model ??= new();
		editContext = new(Model);
		editContext.OnFieldChanged += HandleFieldChanged;
	}

	private void HandleFieldChanged(object? sender, FieldChangedEventArgs e)
	{
		if (editContext is not null)
		{
			editContext.Validate();
			StateHasChanged();
		}
	}

	public async Task DoLoginAsync()
	{
		var result = await Acct.LoginAsync(Model!.Email!, Model!.Password!);

		if (!result.Succeeded)
		{
			errorList = result.ErrorList;
		}
	}

	internal class LoginFormModel : IValidatableObject
	{
		public string Email { get; set; } = "";
		public string Password { get; set; } = "";

		public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
		{
			if (Email.Trim() == "")
			{
				yield return new ValidationResult("Email is required.");
			}
			if (Password.Trim() == "")
			{
				yield return new ValidationResult("Password is required.");
			}
		}
	}
}
