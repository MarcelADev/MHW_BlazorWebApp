@page "/login"
@using MHWApp.Client.Identity
@using MHWApp.Client.GeneralComponents
@using System.ComponentModel.DataAnnotations;
@using MHWApp.Client.GeneralComponents.CustomInput
@using MHWApp.Library.DTO.Identity
@inject IAccountManagement Acct

<PageTitle>Login</PageTitle>

<AuthorizeView>
	<Authorized>
		<LoginRedirect></LoginRedirect>
	</Authorized>
	<NotAuthorized Context="authContext">

		<div class="theme-purple">

			<header class="container-center header">

				<h1>Login</h1>

			</header>

			<div class="container-center">

				@if (errorList.Length > 0)
				{
					@foreach (var error in errorList)
					{
						<div class="alert alert-danger">@error</div>
					}
				}

			</div>

			<div class="form__container">

				<EditForm EditContext="editContext" FormName="login" OnValidSubmit="DoLoginAsync">
						
				<ValidationSummary />

				@* <div class="container-property-identity">
					<label for="email">Email:</label>
					<br />
					<input required id="email" name="emailInput" placeholder="Enter your email address" type="email" autocomplete="on" @bind-value="FormModel!.Email" />
				</div> *@

				<div class="form__field">
					<label for="login-username">Username</label>
					<CustomInputText id="login-username"
									 InputType="text"
									 @bind-Value="FormModel!.Username" />
					<ValidationMessage For="@(() => FormModel!.Username)" />
				</div>

				<div class="form__field">
					<label for="login-password">Password</label>
					<CustomInputText 
						id="login-password"
						InputType="password"
						@bind-Value="FormModel!.Password" />
					<ValidationMessage For="@(() => FormModel!.Password)" />
				</div>

				@* <div class="container-property-identity">
					<label for="password">Password:</label>
					<br />
					<input required id="password" name="passwordInput" placeholder="Enter your password" type="password" autocomplete="on" @bind-value="FormModel!.Password" />
				</div> *@

				<div class="container-property-actions">
					<button class="button" type="submit">Login</button>

					<a class="link-return" href="">🠔 Return</a>
				</div>
			</EditForm>
				
			</div>
		</div>
	</NotAuthorized>
</AuthorizeView>

@code {
	private string[] errorList = [];

	[SupplyParameterFromForm]
	private LoginFormModel? FormModel { get; set; }

	private EditContext? editContext;

	private ValidationMessageStore? _messageStore;

	private List<string> dangers = [];

	protected override void OnInitialized()
	{
		FormModel ??= new();
		editContext = new(FormModel);
		editContext.OnFieldChanged += HandleFieldChanged;

		_messageStore = new ValidationMessageStore(editContext);
	}

	private void HandleFieldChanged(object? sender, FieldChangedEventArgs e)
	{
		if (editContext is not null)
		{
			Utils.ManualModelValidator.ValidateModel(editContext, FormModel!, _messageStore!);
			StateHasChanged();
		}
	}

	public async Task DoLoginAsync()
	{
		var result = await Acct.LoginAsync(new IdentityDTO { UserName = FormModel!.Username, Password = FormModel.Password });

		if (!result.Succeeded)
		{
			errorList = result.ErrorList;
		}
	}

	private async Task ShowDanger(string message)
	{
		dangers.Add(message);
		StateHasChanged();

		await Task.Delay(8000);

		dangers.Remove(message);
		StateHasChanged();
	}

	internal class LoginFormModel : IValidatableObject
	{
		public string Username { get; set; } = "";
		public string Password { get; set; } = "";

		public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
		{
			if (Username.Trim() == "")
			{
				yield return new ValidationResult("Username is required.", [nameof(Username)]);
			}
			if (Password.Trim() == "")
			{
				yield return new ValidationResult("Password is required.", [nameof(Password)]);
			}
		}
	}
}
