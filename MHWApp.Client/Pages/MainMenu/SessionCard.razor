@using MHWApp.Client.GeneralComponents.Buttons
@using MHWApp.Client.GeneralComponents.CustomInput
@using MHWApp.Client.Pages.MainMenu.ShowAndEditSession
@using MHWApp.Client.Provider.Interfaces
@using MHWApp.Client.Services.Interfaces
@using MHWApp.Library.Exceptions
@using MHWApp.Library.Model
@using static MHWApp.Library.StaticVariables
@using MHWApp.Client.HubConnections
@using MHWApp.Client.GeneralComponents.Buttons.IconButtons
@using MHWApp.Client.GeneralComponents.Modals
@using MHWApp.Client.GeneralComponents.Modals.EditSessionModal
@using MHWApp.Client.Provider
@inject NavigationManager navigationManager
@inject ParticipatorProvider participatorProvider
@inject SessionProvider sessionProvider
@inject IDataBaseUpdatesHubConnection hubService
@inject IImageProvider imageProvider
@inject IGlobalAlertService alertService
@implements IDisposable

<div class="image-card__container">

    <div class="image-card__image">

        @if (isLoadingImage)
        {
            <div class="image-card__image__placeholder">
                <p>Is Loading ...</p>
            </div>
        }
        else if(loadingImageWasSuccessful)
        {
            <img src="@base64ImageString" alt="Image not available"/>
        }
        else
        {
            <div class="image-card__image__placeholder">
                <p class="image-card__image__not-found">@imagePlaceHolderText</p>
            </div>
        }

    </div>

    <div class="image-card__content">

        <div class="session-card__h2-container">

            <h2 class="session-card__h2">@Session.Name</h2>

            <div class="session-card__date-container">

                <span class="material-symbols-outlined session-card__date-icon">
                    event_available
                </span>

                <p>@Session.DayCount/@Session.MaxDays</p>
            </div>
        </div>

        <div class="session-card__field">

            <label for="session-weapon">Weapon:</label>
            @if (isLoading)
            {
                <p id="session-weapon">Loading ...</p>
            }
            else
            {
                <p id="session-weapon">@participator!.WeaponType!.Name</p>
            }
        </div>

        <div class="session-card__field">

            <label for="session-date">Date:</label>

            <p id="session-date">@Session.Date</p>

        </div>

        <div class="session-card__field container-left-space-between">

            <Button Content="Play" ButtonClicked="HandlePlayButtonClicked" Blue="true"></Button>

            <div class="container-left">
                @if (toggleMore)
                {
                    <EditButton EditButtonClicked="HandleEditButtonClicked" AlternativeDesign="true"></EditButton>
                    <DeleteButton DeleteButtonClicked="HandleDeleteButtonClicked" AlternativeDesign="true"></DeleteButton>
                }
                <MoreButton MoreButtonClicked="HandleMoreButtonClicked"></MoreButton>
            </div>
        </div>
    </div>
</div>

@if(showDeleteModal)
{
    <DeleteSessionModal CloseButtonClicked="HandleDeleteModalCloseButtonClicked"
    RemoveParticipationButtonClicked="HandleModalRemoveParticipationButtonClicked"
    DeleteSessionButtonClicked="HandleModalDeleteSessionButtonClicked">
    </DeleteSessionModal>
}

@code 
{
    private bool toggleMore = false;
    private bool isLoading = true;
    private bool showDeleteModal = false;

    private bool isLoadingImage = true;
    private bool loadingImageWasSuccessful = false;

    private string base64ImageString = string.Empty;
    private string imagePlaceHolderText = "";

    Participator? participator;

    private EditContext? editContext;

    [Parameter]
    public required Session Session { get; set; }

    [SupplyParameterFromForm]
    private EditSessionFormModel? FormModel { get; set; }

    protected override async Task OnInitializedAsync()
    {
        participator = await participatorProvider.GetParticipatorAsync(Session.Id);

		FormModel = new (Session);
		editContext = new (FormModel);
        editContext.OnFieldChanged += HandleFormFieldChanged;

        hubService.OnUpdatedSession += HandleSignalRUpdatedSession;

        isLoading = false;

        _ = LoadCardImage();
    }

    private async Task LoadCardImage()
    {
        string fileName = "SessionCard_Picture.jpg";

        try
        {
            var rawBase64ImageString = await imageProvider.GetImageAsync(fileName);

            base64ImageString = $"data:image/jpeg;base64,{rawBase64ImageString}";

            loadingImageWasSuccessful = true;
        }
        catch (EntityWasNotFoundException)
        {
            alertService.ShowWarning($"{fileName} was not found");

            imagePlaceHolderText = "404";
        }
        catch(EntityWasNullException)
        {
            alertService.ShowDanger($"Image string was empty. Try reloading page and deleting browser cache");
        }
        catch (UnexpectedResponseException)
        {
            alertService.ShowDanger(ALERT_MESSAGE_UNEXPECTED_SERVER_RESPONSE);
        }

        isLoadingImage = false;
        StateHasChanged();
    }

    private void HandleMoreButtonClicked()
    {
        toggleMore = !toggleMore;
    }

    private void HandleEditButtonClicked()
    {
        
    }

    private void HandleDeleteButtonClicked()
    {
        showDeleteModal = true;
    }

    private void HandlePlayButtonClicked()
    {
        navigationManager.NavigateTo("/inventory");
    }

    private void HandleDeleteModalCloseButtonClicked()
    {
        showDeleteModal = false;
    }

    private void HandleCloseEditModal()
    {
        
    }

    private async Task HandleModalRemoveParticipationButtonClicked()
    {
        try
        {
            await participatorProvider.RemoveParticipatorAsync(participator!.Id);

            alertService.ShowSuccess("Participation was successfully removed");
        }
        catch (EntityWasNotFoundException)
        {
            alertService.ShowDanger("Couldnt remove Participator because it wasn't found. Please reload page!");
        }
        catch (UnexpectedResponseException)
        {
            alertService.ShowDanger(ALERT_MESSAGE_UNEXPECTED_SERVER_RESPONSE);
        }

        showDeleteModal = false;
        StateHasChanged();
    }

    private async Task HandleModalDeleteSessionButtonClicked()
    {
        try
        {
            await sessionProvider.RemoveSessionAsync(Session.Id);

            alertService.ShowSuccess("Session was successfully removed");
        }
        catch (EntityWasNotFoundException)
        {
            alertService.ShowDanger("Couldnt remove Session because it wasn't found. Please reload page!");
        }
        catch (UnexpectedResponseException)
        {
            alertService.ShowDanger(ALERT_MESSAGE_UNEXPECTED_SERVER_RESPONSE);
        }

        showDeleteModal = false;
        StateHasChanged();
    }

    #region Session Card Back

    private void HandleFormFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        StateHasChanged();
	}

    private void Submit()
    {
        
	}

    #endregion

    private void HandleSignalRUpdatedSession(Session updatedSession)
    {
        if(Session.Id == updatedSession.Id)
        {
            Session = updatedSession;
        }
        StateHasChanged();
    }

    public void Dispose()
    {
        hubService.OnUpdatedSession -= HandleSignalRUpdatedSession;
        editContext!.OnFieldChanged -= HandleFormFieldChanged;
    }
}