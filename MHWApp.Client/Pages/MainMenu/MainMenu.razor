@page "/mainmenu"
@using MHWApp.Library.Model
@using MHWApp.Client.HubConnections
@using MHWApp.Client.Provider
@inject SessionProvider sessionProvider
@inject NavigationManager navigationManager
@inject IDataBaseUpdatesHubConnection hubService
@implements IDisposable

<header class="container-center header">

	<h2>Sessions</h2>

</header>

<main class="container-top">

	@if (!isLoading)
	{
		@foreach (Session session in sessions)
		{
			<SessionCard @key="session.Id" 
			Session="session">
			</SessionCard>
		}
	}
	else
	{
		<p>Loading ...</p>
	}

	<button class="button button-addsession theme-purple" @onclick="NavigateToCreateSession">

		<div class="container-button">
			<p class="plus">&#x002B</p>
			New Session
		</div>

	</button>

</main>

<footer class="footer"></footer>

@code {
	private bool isLoading = true;

	List<Session> sessions = [];

	protected async override Task OnInitializedAsync()
	{
		sessions = await sessionProvider.GetSessionsAsync();

		hubService.OnDeletedParticipator += HandleSignalRDeletedParticipator;

		hubService.OnNewSession += HandleSignalRNewSession;
		hubService.OnUpdatedSession += HandleSignalRUpdatedSession;
		hubService.OnDeletedSession += HandleSignalRDeletedSession;

		isLoading = false;
	}

	private void NavigateToCreateSession(){
		navigationManager.NavigateTo("/mainmenu/createsession");
	}

	private void HandleSignalRNewSession(Session newSession)
	{
		sessions.Add(newSession);
		StateHasChanged();
	}

	private void HandleSignalRDeletedParticipator(int deletedParticipatorId)
	{
		var deletedParticipator = sessions.Find(s => s.Id == deletedParticipatorId);
		if (deletedParticipator != null) sessions.Remove(deletedParticipator);
		StateHasChanged();
	}

	private void HandleSignalRDeletedSession(int sessionIdOfDeletedParticipator)
	{
		var deletedSessiion = sessions.Find(s => s.Id == sessionIdOfDeletedParticipator);
		if (deletedSessiion != null) sessions.Remove(deletedSessiion);
		StateHasChanged();
	}

	private void HandleSignalRUpdatedSession(Session updatedSession)
	{
		int index = sessions.FindIndex(s => s.Id == updatedSession.Id);

		if (index != -1) sessions[index] = updatedSession;
		else sessions.Add(updatedSession);

		StateHasChanged();
	}

	public void Dispose()
	{
		hubService.OnDeletedParticipator -= HandleSignalRDeletedParticipator;

		hubService.OnNewSession -= HandleSignalRNewSession;
		hubService.OnUpdatedSession -= HandleSignalRUpdatedSession;
		hubService.OnDeletedSession -= HandleSignalRDeletedSession;
	}
}