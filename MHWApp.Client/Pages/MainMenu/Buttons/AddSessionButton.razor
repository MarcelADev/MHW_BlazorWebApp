<button @onclick="OnAddSessionButtonClicked">
	<span class="material-symbols-outlined">
		add_2
	</span>
	New Session
</button>

@code {
	[Parameter]
	public required EventCallback AddSessionButtonClicked { get; set; }

	private async Task OnAddSessionButtonClicked()
	{
		await AddSessionButtonClicked.InvokeAsync();
	}
}