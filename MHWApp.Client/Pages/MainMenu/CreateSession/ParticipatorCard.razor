@using MHWApp.Library.Model;
@using MHWApp.Client.Extensions
@using MHWApp.Client.Pages.GeneralComponents.Select
@using System.Text.RegularExpressions
@inject ILogger<ParticipatorCard> Logger

@if (null != Participator)
{
    <div class="card__customized participator">

        <div class="card__header">
            @Participator!.Player?.UserName
        </div>

        <div >
            <div class="participator-weapon">
                <img src="@($"Images/WeaponIcons/{Participator!.WeaponType?.Name.ReplaceWhitespace()}.svg")" alt="@Participator.WeaponType?.Name" />
                
                <SingleSelect T="WeaponType"
                    Options="@weaponTypes"
                    OptionNameMapper="(WeaponType weaponType) => weaponType.Name"
                    OptionValueMapper="(WeaponType weaponType) => weaponType.Id"
                    Value="Participator.WeaponType"
                    ValueChanged="HandleWeaponChanged">
                </SingleSelect>

            </div>
        </div>
    </div>
}

@code {
    /// <summary>
    /// Participator to bind to.
    /// </summary>
    [Parameter]
    public Participator? Participator { get; set; }

    /// <summary>
    /// Value changed callback.
    /// </summary>
    [Parameter]
    public EventCallback<Participator?> ParticipatorChanged { get; set; }

    /// <summary>
    /// List of available weapon types to choose.
    /// </summary>
    [Parameter]
    public List<WeaponType> weaponTypes { get; set; } = new();

    private void HandleWeaponChanged(WeaponType weaponType)
    {
        Participator!.WeaponTypeId = weaponType.Id;
        Participator!.WeaponType = weaponType;

        ParticipatorChanged.InvokeAsync(Participator);
        StateHasChanged();
    }
}