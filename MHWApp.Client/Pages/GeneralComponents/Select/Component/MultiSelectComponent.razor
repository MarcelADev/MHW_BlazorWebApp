﻿@using MHWApp.Library.Model
@inject IJSRuntime JSRuntime
@inject ILogger<MultiSelectComponent<T>> Logger
@typeparam T
@inherits SelectComponentBase<T>
@implements IAsyncDisposable

@if (os == "Android" || os == "iOS")
{
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label for="select">@Label</label>
    }
    <select multiple
            name="select"
            @attributes="selectAttributes"
            @onchange="HandleNativeChange">
        @foreach (var option in Options)
        {
            <option value="@OptionValueMapper(option)" selected="@(IsSelected(option, ValueList))">
                @OptionNameMapper(option)
            </option>
        }
    </select>
}
else
{
    <div class="select__anchor">
        @if (!string.IsNullOrWhiteSpace(Label))
        {
            <label id="@Id-label"
                   for="mhwapp-multi-select-@Id"
                   @onclick:preventDefault="@Disabled"
                   @onclick:stopPropagation="@Disabled"
                   @attributes="labelAttributes">
                @Label
            </label>
        }

        <div id="mhwapp-multi-select-@Id"
             class="@($"select{GetCSSClassesForMultiSelect()}")"
             aria-labelledby="@Id-label">

            <div class="select__trigger @(Disabled ? "disabled" : "")"
                 tabindex="@(Disabled ? -1 : 0)"
                 aria-disabled="@Disabled">

                <div aria-hidden="true" class="select__content">
                    @if (ValueList.Count == 0)
                    {
                        @Placeholder
                    }
                    else
                    {
                        @foreach (var selected in ValueList)
                        {
                            <button inert type="button" class="btn btn-primary select__chip">
                                <span>
                                    @OptionNameMapper(selected)
                                    <span class="material-symbols-outlined">close</span>
                                </span>
                            </button>
                        }
                    }
                </div>

                <span class="material-symbols-outlined icon__color-black">keyboard_arrow_down</span>
            </div>

            <div class="select__dropdown" tabindex="@(Disabled ? -1 : 0)">
                @foreach (var option in Options)
                {
                    <div class="select__option">
                        <label class="select__option-label">
                            <input type="checkbox"
                                   checked="@IsSelected(option, ValueList)"
                                   id="select-@Id-@(OptionValueMapper(option))"
                                   name="select-@(OptionValueMapper(option))"
                                   disabled="@Disabled"
                                   @onchange="(_) => HandleCustomChangeMultiple(option)" />
                            @OptionNameMapper(option)
                        </label>
                    </div>
                }
            </div>
        </div>

        <div class="select__content-overlay">
            @foreach (var selected in ValueList)
            {
                <button tabindex="-1"
                        type="button"
                        class="btn btn-primary select__chip select__chip-clickable"
                        @onclick="@(() => HandleCustomChangeMultiple(selected))">
                    <span>
                        @OptionNameMapper(selected)
                        <span class="material-symbols-outlined">close</span>
                    </span>
                </button>
            }
        </div>
    </div>
}
