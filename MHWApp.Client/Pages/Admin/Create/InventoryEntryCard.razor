@using MHWApp.Library.Model
@using MHWApp.Client.GeneralComponents.CustomInput
@using MHWApp.Client.GeneralComponents.IconButtons
@using MHWApp.Client.GeneralComponents.Select.Input
@using MHWApp.Client.Provider
@using System.ComponentModel
@inject GameExtensionProvider gameExtensionProvider
@implements IDisposable

@if(!isLoading)
{
	<EditForm FormName="edit-inventory-entry" EditContext="editContext" OnValidSubmit="Submit">
		<DataAnnotationsValidator />

		<div class="card">		

			<div class="container-left-space-between">
				<p class="card__create-inventory-entry-header">@(Model.ExtendedName.Equals(string.Empty) ? Model.Name : Model.ExtendedName)</p>

				<div class="container-left">
					@if(!isEditing)
					{
						<EditButton EditButtonClicked="HandleEditButtonClicked"
						AlternativeDesign="true" />

						<DeleteButton DeleteButtonClicked="HandleDeleteButtonClicked"
						AlternativeDesign="true" />
					}
					else
					{
						<ConfirmButton AlternativeDesign="true" />

						<CancelButton CancelButtonClicked="HandleCancelButtonClicked"
						AlternativeDesign="true"/>
					}
				</div>
			</div>

			@if(!isEditing)
			{
				<label for="card__create-inventory-entry-gameextension">
					Game Extension
				</label>
				<p id="card__create-inventory-entry-gameextension">
					@(Model.GameExtension is null ? "None" : Model.GameExtension.Name)
				</p>
			}
			else
			{
				<div class="form__field">
					<label for="edit-inventory-entry-name">Name</label>
					<CustomInputText id="edit-inventory-entry-name" @bind-Value="FormModel!.SelectedName" />
					<ValidationMessage For="@(() => FormModel.SelectedName)" />
				</div>

				<SingleSelectInput Label="Choose Game Extension" 
							  Placeholder="Select"
							  T="GameExtension"
							  Options="gameExtensions"
							  OptionNameMapper="(GameExtension ge) => ge.Name"
							  OptionValueMapper="(GameExtension ge) => ge.Id"
							  @bind-Value="FormModel.SelectedGameExtension"/>			
			}

		</div>
	</EditForm>
}


@code {
	private bool isLoading = true;
	private bool isEditing = false;
	private bool isFormValid = true;

	private Guid lastRemovalToken;

	private List<GameExtension> gameExtensions = [];

	[Parameter]
	public required InventoryEntryCardModel Model { get; set; }

	[SupplyParameterFromForm]
	public InventoryEntryCardFormModel? FormModel { get; set; }

	[Parameter]
	public EventCallback<InventoryEntryCardModel> RemoveFromList { get; set; }

	[Parameter]
	public required Func<string,bool> CheckIfNewNameExists { get; set; }

	[CascadingParameter] 
	public Guid RemovalChangeToken { get; set; }

	private EditContext? editContext;

	protected override async Task OnInitializedAsync()
	{
		gameExtensions = await gameExtensionProvider.GetGameExtensionsAsync();

		if (Model is not null)
		{
			Model.PropertyChanged += HandleModelChanged;
		}

		FormModel = new InventoryEntryCardFormModel(Model!);
		editContext = new EditContext(FormModel);
		editContext.OnFieldChanged += HandleFieldChanged;

		isLoading = false;
		StateHasChanged();
	}

	private void HandleModelChanged(object? sender, PropertyChangedEventArgs e)
	{
		FormModel!.CurrentName = FormModel.SelectedName = Model.ExtendedName.Equals(string.Empty) ? Model.Name : Model.ExtendedName;

		InvokeAsync(StateHasChanged);
	}

	protected override void OnParametersSet()
	{
		if (FormModel is not null)
		{
			FormModel.CurrentGameExtension = Model.GameExtension;
			FormModel.SelectedGameExtension = Model.GameExtension;
		}

		if (isEditing && RemovalChangeToken != lastRemovalToken)
		{
			lastRemovalToken = RemovalChangeToken;

			// Re-check custom validation: NameAlreadyExists
			if (FormModel is not null && CheckIfNewNameExists.Invoke(FormModel.SelectedName))
			{
				FormModel.NameAlreadyExistsFlag = true;
			}
			else if (FormModel is not null)
			{
				FormModel.NameAlreadyExistsFlag = false;
			}

			// Built-in validation
			if (editContext is not null)
				isFormValid = editContext.Validate();

			StateHasChanged();
		}
	}

	private void HandleEditButtonClicked()
	{
		FormModel!.ShowValidationMessages = true;
		isEditing = true;
		StateHasChanged();
	}

	private void HandleDeleteButtonClicked()
	{
		RemoveFromList.InvokeAsync(Model);
		StateHasChanged();
	}

	private void HandleCancelButtonClicked()
	{
		if (editContext is not null)
		{
			FormModel!.ShowValidationMessages = false;
			FormModel.NameAlreadyExistsFlag = false;
			FormModel.SelectedGameExtension = FormModel.CurrentGameExtension;
			FormModel.SelectedName = FormModel.CurrentName;
			isFormValid = editContext.Validate();
		}

		isEditing = false;
		StateHasChanged();
	}

	private void HandleFieldChanged(object? sender, FieldChangedEventArgs e)
	{
		FormModel!.NameAlreadyExistsFlag = false;

		if(editContext is not null)
		{
			isFormValid = editContext.Validate();
		}
	}

	private void Submit()
	{
		if(CheckIfNewNameExists.Invoke(FormModel!.SelectedName))
		{
			FormModel.NameAlreadyExistsFlag = true;

			isFormValid = editContext!.Validate();

			StateHasChanged();
			return;
		}

		if (Model.ExtendedName.Equals(string.Empty)) Model.Name = FormModel!.CurrentName = FormModel.SelectedName;
		else Model.ExtendedName = FormModel!.CurrentName = FormModel.SelectedName;

		Model.GameExtension = FormModel.CurrentGameExtension = FormModel.SelectedGameExtension;

		isEditing = false;
		StateHasChanged();
	}

	public void Dispose()
	{
		if(editContext is not null)
		{
			editContext.OnFieldChanged -= HandleFieldChanged;
		}

		if (Model is not null)
		{
			Model.PropertyChanged -= HandleModelChanged;
		}
	}
}
