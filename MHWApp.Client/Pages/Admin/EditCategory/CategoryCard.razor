@using MHWApp.Library
@using MHWApp.Library.Exceptions
@using MHWApp.Library.Model
@using MHWApp.Client.HubConnections
@using MHWApp.Client.GeneralComponents.Select
@using MHWApp.Client.GeneralComponents.Buttons.IconButtons
@using MHWApp.Client.GeneralComponents.Modals
@using MHWApp.Client.Provider
@using static MHWApp.Library.StaticVariables
@inject CategoryProvider categoryProvider
@inject GameExtensionProvider gameExtensionProvider
@inject IDataBaseUpdatesHubConnection hubService
@implements IDisposable

@if(!isLoading)
{
	<div class="form__container">
		<EditForm EditContext="editContext" FormName="categoryCard" OnValidSubmit="Submit">
			<DataAnnotationsValidator />
			<ValidationSummary />

			<div class="card">

				<div class="container-left-space-between">
					<p class="header-card">@Category.Name</p>

					<div class="container-right-gap">
						@if (!toggleEdit)
						{
							<EditButton EditButtonClicked="HandleEditButtonClicked"></EditButton>
							<DeleteButton DeleteButtonClicked="HandleDeleteButtonClicked"></DeleteButton>
						}
						else
						{
							<ConfirmButton />
							<CancelButton CancelButtonClicked="HandleCancelButtonClicked"></CancelButton>
						}
					</div>
				</div>

				@if (toggleEdit)
				{
					<div class="form__field">
						<label for="categoryCard-name">Change Name:</label>
						<InputText id="categoryCard-name" @bind-Value="Model!.NewName" />
					</div>

					<div class="form__field-checkbox">
						<InputCheckbox id="categoryCard-inventory" @bind-Value="Model.IsInventoryCategory"></InputCheckbox>
						<label for="categoryCard-inventory">Inventory Category</label>
					</div>

					<div class="form__field-checkbox">
						<InputCheckbox id="categoryCard-weapon" @bind-Value="Model.IsWeaponCategory"></InputCheckbox>
						<label for="categoryCard-weapon">Weapon Category</label>
					</div>

					<div class="form__field-checkbox">
						<InputCheckbox id="categoryCard-armor" @bind-Value="Model.IsArmorCategory"></InputCheckbox>
						<label for="categoryCard-armor">Armor Category</label>
					</div>
				}
			</div>

		</EditForm>
	</div>
}

@if(showModal){
	<Modal
	Title="Confirm Delete"
	BodyText="@modalBodyText"
	CloseButtonClicked="HandleModalCloseOrCancelButtonClicked"
	SecondaryButtonClicked="HandleModalCloseOrCancelButtonClicked"
	PrimaryButtonClicked="HandleModalConfirmButtonClicked">
	</Modal>
}

@code {
	private bool isLoading = true;
	private bool isFormValid = true;
	private bool toggleEdit = false;
	private bool showModal = false;

	private List<GameExtension>? extensions;

	private string? modalBodyText;

	public EditContext? editContext;

	[SupplyParameterFromForm]
	public CategoryCardFormModel? Model { get; set; }

	[Parameter]
	public required Category Category { get; set; }

	protected override async Task OnInitializedAsync()
	{
		extensions = await gameExtensionProvider.GetGameExtensionsAsync();
		if (extensions.Any()) extensions.Sort((x, y) => x.Name.CompareTo(y.Name));

		modalBodyText = $"Are you sure you want to remove {Category.Name}?";

		Model ??= new CategoryCardFormModel(Category);
		editContext = new(Model);

		hubService.OnUpdatedCategory += HandleSignalRUpdatedCategory;

		hubService.OnNewInventoryCategory += HandleSignalRNewInventoryCategory;
		hubService.OnDeletedInventoryCategory += HandleSignalRDeletedInventoryCategory;

		hubService.OnNewWeaponCategory += HandleSignalRNewWeaponCategory;
		hubService.OnDeletedWeaponCategory += HandleSignalRDeletedWeaponCategory;

		hubService.OnNewArmorCategory += HandleSignalRNewArmorCategory;
		hubService.OnDeletedArmorCategory += HandleSignalRDeletedArmorCategory;

		hubService.OnNewGameExtension += HandleSignalRNewGameExtension;
		hubService.OnUpdatedGameExtension += HandleSignalRUpdatedGameExtension;
		hubService.OnDeletedGameExtension += HandleSignalRDeletedGameExtension;

		isLoading = false;
		StateHasChanged();
	}

	private async Task Submit() => await ChangeCategoryProperties();

	private async Task ChangeCategoryProperties()
	{
		bool cancel = false;

		if(Model!.IsCurrentlyInventoryCategory != Model.IsInventoryCategory)
		{
			if (Model.IsInventoryCategory)
			{
				cancel = await CreateInventoryCategory();
			}
			else
			{
				cancel = await DeleteInventoryCategory();
			}
		}

		if(!cancel && Model.IsCurrentlyWeaponCategory != Model.IsWeaponCategory)
		{
			if (Model.IsWeaponCategory)
			{
				cancel = await CreateWeaponCategory();
			}
			else
			{
				cancel = await DeleteWeaponCategory();
			}
		}

		if(!cancel && Model.IsCurrentlyArmorCategory != Model.IsArmorCategory)
		{
			if (Model.IsArmorCategory)
			{
				cancel = await CreateArmorCategory();
			}
			else
			{
				cancel = await DeleteArmorCategory();
			}
		}

		if(!Category.Name.Equals(Model.NewName))
		{
			cancel = await ChangeCategoryName();
		}

		if (cancel) Model.CancelFlag = true;

		toggleEdit = !toggleEdit;
		StateHasChanged();
	}

	private async Task<bool> CreateInventoryCategory()
	{
		InventoryEntryCategory inventoryEntryCategory = new InventoryEntryCategory
			{
				Id = 0,
				CategoryId = Category.Id,
				Order = StaticVariables.ORDER_DEFAULT_VALUE
			};

		try
		{
			await categoryProvider.CreateInventoryEntryCategoryAsync(inventoryEntryCategory);
			return false;
		}
		catch (EntityAlreadyExistsException)
		{
			Model!.EntityAlreadyExistsFlag = true;
			editContext!.Validate();
		}
		catch (EntityWasNullException)
		{
			Model!.EntityWasNullFlag = true;
			editContext!.Validate();
		}
		catch (UnexpectedResponseException)
		{
			Model!.UnexpectedResponseFlag = true;
			editContext!.Validate();
		}
		StateHasChanged();
		return true;
	}

	private async Task<bool> DeleteInventoryCategory()
	{
		try
		{
			await categoryProvider.RemoveInventoryCategoryAsync(Category.InventoryEntryCategory!.Id);
			return false;
		}
		catch(EntityWasNotFoundException)
		{
			Model!.EntityWasNotFoundFlag = true;
			editContext!.Validate();
		}
		catch (UnexpectedResponseException)
		{
			Model!.UnexpectedResponseFlag = true;
			editContext!.Validate();
		}

		StateHasChanged();
		return true;
	}

	private async Task<bool> CreateWeaponCategory()
	{
		WeaponCategory weaponCategory = new WeaponCategory
			{
				Id = 0,
				CategoryId = Category.Id,
				Order = StaticVariables.ORDER_DEFAULT_VALUE
			};

		try
		{
			await categoryProvider.CreateWeaponCategoryAsync(weaponCategory);
			return false;
		}
		catch (EntityAlreadyExistsException)
		{
			Model!.EntityAlreadyExistsFlag = true;
			editContext!.Validate();
		}
		catch (EntityWasNullException)
		{
			Model!.EntityWasNullFlag = true;
			editContext!.Validate();
		}
		catch (UnexpectedResponseException)
		{
			Model!.UnexpectedResponseFlag = true;
			editContext!.Validate();
		}
		StateHasChanged();
		return true;
	}

	private async Task<bool> DeleteWeaponCategory()
	{
		try
		{
			await categoryProvider.RemoveWeaponCategoryAsync(Category.WeaponCategory!.Id);
			return false;
		}
		catch (EntityWasNotFoundException)
		{
			Model!.EntityWasNotFoundFlag = true;
			editContext!.Validate();
		}
		catch (UnexpectedResponseException)
		{
			Model!.UnexpectedResponseFlag = true;
			editContext!.Validate();
		}

		StateHasChanged();
		return true;
	}

	private async Task<bool> CreateArmorCategory()
	{
		ArmorCategory armorCategory = new ArmorCategory
			{
				Id = 0,
				CategoryId = Category.Id,
				Order = StaticVariables.ORDER_DEFAULT_VALUE
			};

		try
		{
			await categoryProvider.CreateArmorCategoryAsync(armorCategory);
			return false;
		}
		catch (EntityAlreadyExistsException)
		{
			Model!.EntityAlreadyExistsFlag = true;
			editContext!.Validate();
		}
		catch (EntityWasNullException)
		{
			Model!.EntityWasNullFlag = true;
			editContext!.Validate();
		}
		catch (UnexpectedResponseException)
		{
			Model!.UnexpectedResponseFlag = true;
			editContext!.Validate();
		}
		StateHasChanged();
		return true;
	}

	private async Task<bool> DeleteArmorCategory()
	{
		try
		{
			await categoryProvider.RemoveArmorCategoryAsync(Category.ArmorCategory!.Id);
			return false;
		}
		catch (EntityWasNotFoundException)
		{
			Model!.EntityWasNotFoundFlag = true;
			editContext!.Validate();
		}
		catch (UnexpectedResponseException)
		{
			Model!.UnexpectedResponseFlag = true;
			editContext!.Validate();
		}

		StateHasChanged();
		return true;
	}

	private async Task<bool> ChangeCategoryName()
	{
		try
		{
			Category.Name = Model!.NewName;
			await categoryProvider.UpdateCategoryAsync(Category);
			return false;
		}
		catch (EntityWasNotFoundException)
		{
			Model!.EntityWasNotFoundFlag = true;
			editContext!.Validate();
		}
		catch (UnexpectedResponseException)
		{
			Model!.UnexpectedResponseFlag = true;
			editContext!.Validate();
		}

		StateHasChanged();
		return true;
	}

	private void HandleEditButtonClicked()
	{
		toggleEdit = !toggleEdit;
	}

	private void HandleCancelButtonClicked()
	{
		toggleEdit = !toggleEdit;
		Model!.NewName = Model.Name;
		Model.IsInventoryCategory = Model.IsCurrentlyInventoryCategory;
		Model.IsWeaponCategory = Model.IsCurrentlyWeaponCategory;
		Model.IsArmorCategory = Model.IsCurrentlyArmorCategory;
	}

	private void HandleDeleteButtonClicked()
	{
		showModal = true;
	}

	private void HandleModalCloseOrCancelButtonClicked()
	{
		showModal = false;
	}

	private async Task HandleModalConfirmButtonClicked()
	{
		showModal = false;

		try
		{
			await categoryProvider.RemoveCategoryAsync(Category.Id);

		}
		catch (EntityWasNotFoundException)
		{
			Model!.EntityWasNullFlag = true;
			editContext!.Validate();
		}
		catch (UnexpectedResponseException)
		{
			Model!.UnexpectedResponseFlag = true;
			editContext!.Validate();
		}
		StateHasChanged();
	}

	private void HandleSignalRUpdatedCategory(Category updatedCategory)
	{
		if(Category.Id == updatedCategory.Id)
		{
			Category.Name = Model!.Name = Model.NewName = updatedCategory.Name;
		}
		StateHasChanged();
	}

	private void HandleSignalRNewInventoryCategory(InventoryEntryCategory newInventoryCategory)
	{
		if (newInventoryCategory.CategoryId == Category.Id) Model!.IsCurrentlyInventoryCategory = Model.IsInventoryCategory = true;
		StateHasChanged();
	}

	private void HandleSignalRDeletedInventoryCategory(int categoryIdOfDeletedInventoryCategory)
	{
		if (categoryIdOfDeletedInventoryCategory == Category.Id) Model!.IsCurrentlyInventoryCategory = Model.IsInventoryCategory = false;
		StateHasChanged();
	}

	private void HandleSignalRNewWeaponCategory(WeaponCategory newWeaponCategory)
	{
		if (newWeaponCategory.CategoryId == Category.Id) Model!.IsCurrentlyWeaponCategory = Model.IsWeaponCategory = true;
		StateHasChanged();
	}

	private void HandleSignalRDeletedWeaponCategory(int categoryIdOfDeletedWeaponCategory)
	{
		if (categoryIdOfDeletedWeaponCategory == Category.Id) Model!.IsCurrentlyWeaponCategory = Model.IsWeaponCategory = false;
		StateHasChanged();
	}

	private void HandleSignalRNewArmorCategory(ArmorCategory newArmorCategory)
	{
		if (newArmorCategory.CategoryId == Category.Id) Model!.IsCurrentlyArmorCategory = Model.IsArmorCategory = true;
		StateHasChanged();
	}

	private void HandleSignalRDeletedArmorCategory(int categoryIdOfDeletedArmorCategory)
	{
		if (categoryIdOfDeletedArmorCategory == Category.Id) Model!.IsCurrentlyArmorCategory = Model.IsArmorCategory = false;
		StateHasChanged();
	}

	private void HandleSignalRNewGameExtension(GameExtension newGameExtension)
	{
		extensions!.Add(newGameExtension);
		StateHasChanged();
	}

	private void HandleSignalRUpdatedGameExtension(GameExtension updatedGameExtension)
	{
		var existing = extensions!.Find(ge => ge.Id == updatedGameExtension.Id);
		if (existing != null) existing.Name = updatedGameExtension.Name;
		StateHasChanged();
	}

	private void HandleSignalRDeletedGameExtension(int deletedGameExtensionId)
	{
		var existing = extensions!.Find(ge => ge.Id == deletedGameExtensionId);
		if (existing != null) extensions.Remove(existing);
		StateHasChanged();
	}

	public void Dispose()
	{
		hubService.OnUpdatedCategory -= HandleSignalRUpdatedCategory;

		hubService.OnNewInventoryCategory -= HandleSignalRNewInventoryCategory;
		hubService.OnDeletedInventoryCategory -= HandleSignalRDeletedInventoryCategory;

		hubService.OnNewWeaponCategory -= HandleSignalRNewWeaponCategory;
		hubService.OnDeletedWeaponCategory -= HandleSignalRDeletedWeaponCategory;

		hubService.OnNewArmorCategory -= HandleSignalRNewArmorCategory;
		hubService.OnDeletedArmorCategory -= HandleSignalRDeletedArmorCategory;

		hubService.OnNewGameExtension -= HandleSignalRNewGameExtension;
		hubService.OnUpdatedGameExtension -= HandleSignalRUpdatedGameExtension;
		hubService.OnDeletedGameExtension -= HandleSignalRDeletedGameExtension;
	}
}