@page "/admin/category/manage"
@using MHWApp.Client.HubConnections
@using MHWApp.Client.Provider
@using MHWApp.Library.Model
@inject CategoryProvider categoryProvider
@inject IDataBaseUpdatesHubConnection hubService
@implements IDisposable

<h1>Edit Category</h1>

<div class="form__container">
    @if (!isLoading)
    {
        foreach (Category category in categories)
        {
            var color = GetInterpolatedColor(categoryIndex, categories.Count);
            <p>@category.Name</p>
            <div id="dynamicAnimatedBox@(categoryIndex++)" class="box" style="border-color: @color">
                <p>content</p>
            </div>
        }
    }
</div>

@code {
    private bool isLoading = true;
    private List<Category> categories = [];
    private int categoryIndex = 0;

    protected override async Task OnInitializedAsync()
    {
        categories = await categoryProvider.GetCategoriesAsync();

        hubService.OnNewCategory += HandleSignalRNewCategory;

        isLoading = false;
    }

    private void HandleSignalRNewCategory(Category newCategory)
    {
        categories.Add(newCategory);
        StateHasChanged();
    }

    private string GetInterpolatedColor(int index, int total)
    {
        // Edge case: only one item
        if (total <= 1)
            return $"rgb(27, 110, 194)";

        // Start color (blue)
        var r1 = 27;
        var g1 = 110;
        var b1 = 194;

        // End color (purple)
        var r2 = 100;
        var g2 = 87;
        var b2 = 166;

        r2 = 255;
        g2 = 0;
        b2 = 138;

        // t goes from 0 (start) to 1 (end)
        double t = (double)index / (total - 1);

        int r = (int)(r1 + (r2 - r1) * t);
        int g = (int)(g1 + (g2 - g1) * t);
        int b = (int)(b1 + (b2 - b1) * t);

        return $"rgb({r}, {g}, {b})";
    }

    public void Dispose()
    {
        hubService.OnNewCategory -= HandleSignalRNewCategory;
    }
}
