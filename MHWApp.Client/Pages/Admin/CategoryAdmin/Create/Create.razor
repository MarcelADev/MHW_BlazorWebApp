@page "/admin/category/create"
@using MHWApp.Client.GeneralComponents.Buttons
@using MHWApp.Client.GeneralComponents.CustomInput.SingleSelect
@using MHWApp.Client.HubConnections
@using MHWApp.Client.GeneralComponents.CustomInput
@using MHWApp.Client.GeneralComponents.Buttons.IconButtons
@using MHWApp.Client.GeneralComponents.Select.Component
@using MHWApp.Client.GeneralComponents.Select.Input
@using MHWApp.Client.Provider
@using MHWApp.Library
@using MHWApp.Library.DTO.Create
@using MHWApp.Library.DTO.Create.Category_Armor_InventoryEntry
@using MHWApp.Library.Exceptions
@using MHWApp.Library.Model
@using static MHWApp.Library.StaticVariables
@inject IJSRuntime jsRuntime
@inject GameExtensionProvider gameExtensionProvider
@inject CategoryProvider categoryProvider
@inject CategoryArmorInventoryEntryProvider multiProvider
@inject IDataBaseUpdatesHubConnection hubService
@implements IDisposable

<h1>Create Category</h1>

@if(!isLoading)
{
    <EditForm EditContext="editContext" FormName="create" OnValidSubmit="Submit" OnInvalidSubmit="InvalidSubmit">

        <ValidationSummary />

        <CustomInputText id="create-category-name" Label="Name" @bind-Value="FormModel!.Name" />

        <div class="form__field">
            <SingleSelectInput Label="Choose general Game Extension"
                               Placeholder="Select"
                               T="GameExtension"
                               Options="gameExtensions"
                               OptionNameMapper="(GameExtension ge) => ge.Name"
                               OptionValueMapper="(GameExtension ge) => ge.Id"
                               @bind-Value="FormModel.GeneralGameExtension" />
            <ValidationMessage For="@(() => FormModel!.GeneralGameExtension)" />
        </div>

        <SingleSelect Label="Choose general Game Extension"
                      Placeholder="Select"
                      T="GameExtension"
                      Options="gameExtensions"
                      OptionNameMapper="(GameExtension ge) => ge.Name"
                      OptionValueMapper="(GameExtension ge) => ge.Id"
                      @bind-Value="FormModel.GeneralGameExtension" />
        <ValidationMessage For="@(() => FormModel!.GeneralGameExtension)" />

        <CheckboxWithToggleContainer Label="Add Armor Set (New Version)">

            <CheckboxWithToggleContainer Label="Use alternative Prefix" OnToggleChanged="HandleUseAlternativePrefixToggle">

                <CustomInputText id="change-armorset-prefix-textbox"
								 NoMargin="true"
                                 @bind-Value="FormModel!.AlternativeArmorPrefix" />

            </CheckboxWithToggleContainer>

            <CustomInputText id="create-category-head"
                             Label="Head"
                             Prefix="@(useAlternativePrefix? FormModel!.AlternativeArmorPrefix : FormModel!.Name)"                                  
                             @bind-Value="FormModel!.HelmetSuffix" />

            <CustomInputText id="create-category-chest"
                             Label="Chest"
                             Prefix="@(useAlternativePrefix? FormModel!.AlternativeArmorPrefix : FormModel!.Name)"
                             @bind-Value="FormModel!.MailSuffix" />

            <CustomInputText id="create-category-legs"
                             Label="Legs"
                             Prefix="@(useAlternativePrefix? FormModel!.AlternativeArmorPrefix : FormModel!.Name)"
                             NoMargin="true"
                             @bind-Value="FormModel!.GreavesSuffix" />

        </CheckboxWithToggleContainer>

        <div class="form__field">
            <InputCheckbox id="create-armorset-checkbox"
                           Value="FormModel.AddArmorSet"
                           ValueChanged="ToggleArmorSet"
                           ValueExpression="() => FormModel.AddArmorSet" />
            <label for="create-armorset-checkbox">Add Armor Set</label>
        </div>

        @if (showArmorSet)
        {
            <div id="animatedBox" class="box @(!FormModel.AddArmorSet ? "exit" : "")">

                @if (!FormModel.Name.Equals(string.Empty))
                {
                    <div class="form__field">
                        <CustomInputCheckbox id="change-armorset-prefix-checkbox"
                                        Hierarchy="2"
                                        Value="FormModel.UseAlternativeArmorPrefix"
                                        ValueChanged="ToggleArmorPrefix"
                                        ValueExpression="() => FormModel.UseAlternativeArmorPrefix" />
                        <label for="change-armorset-prefix-checkbox">Use alternative Prefix</label>
                    </div>

                    @if (showAlternativeArmorPrefix)
                    {
                        <div id="animatedBox3" class="box purple @(isExitingAlternativePrefix ? "exit" : "")">
                            <div class="form__field">
                                <label for="change-armorset-prefix-textbox">Name</label>
                                <CustomInputText id="change-armorset-prefix-textbox"
                                                    @bind-Value="FormModel!.AlternativeArmorPrefix" />
                                <ValidationMessage For="@(() => FormModel!.AlternativeArmorPrefix)" />
                            </div>
                        </div>
                    }

                    <div class="form__field">
                        <label for="create-category-mail">Mail</label>

                        <div class="input-grid">
                            <span class="prefix-text">@FormModel!.ArmorPrefix</span>
                            <CustomInputText id="create-category-mail" @bind-Value="FormModel!.MailSuffix" />
                            <ValidationMessage For="@(() => FormModel!.MailSuffix)" class="validation-message" />
                        </div>
                    </div>

                    <div class="form__field">
                        <label for="create-category-greaves">Greaves</label>

                        <div class="input-grid">
                            <span class="prefix-text">@FormModel!.ArmorPrefix</span>
                            <CustomInputText id="create-category-greaves" @bind-Value="FormModel!.GreavesSuffix" />
                            <ValidationMessage For="@(() => FormModel!.GreavesSuffix)" class="validation-message" />
                        </div>
                    </div>
                }
                else
                {
                    <p>Category Name needed</p>
                }

            </div>
        }

        <div class="form__field">
            <InputCheckbox id="create-inventoryentries-checkbox"
                            Value="FormModel.AddInventoryEntries"
                            ValueChanged="ToggleInventoryEntries"
                            ValueExpression="() => FormModel.AddInventoryEntries" />
            <label for="create-inventoryentries-checkbox">Add Inventory Entries</label>
        </div>

        @if(showInventoryEntries)
        {
            <div id="animatedBox2" class="box @(!FormModel.AddInventoryEntries ? "exit" : "")">
                @if (!FormModel.Name.Equals(string.Empty))
                {
                    <InventoryEntryList @ref="inventoryEntryList"
                                        GetName="() => FormModel.Name"
                                        SetName="value => FormModel.Name = value"
                                        GetGeneralGameExtension="() => FormModel.GeneralGameExtension"
                                        SetGeneralGameExtension="value => FormModel.GeneralGameExtension = value" />
                }
                else
                {
                    <p>Category Name needed</p>
                }
            </div>
        }

        <Button Content="Create" IsSubmit="true" />

    </EditForm>
}


@code {
    private bool isLoading = true;

    #region Create Category
    private bool showArmorSet = false;
    private bool showInventoryEntries = false;

    private bool showAlternativeArmorPrefix = false;
    private bool isExitingAlternativePrefix = false;

    private bool validateOnlyModified = true;

    private EditContext? editContext;

    [SupplyParameterFromForm]
    private CreateFormModel? FormModel { get; set; }

    private List<GameExtension> gameExtensions = [];

    private DotNetObjectReference<Create>? _dotNetRef;

    private InventoryEntryList? inventoryEntryList;

    private ValidationMessageStore? _messageStore;
    #endregion

    #region Testing

    private bool useAlternativePrefix = false;

    private void HandleUseAlternativePrefixToggle(bool toggleState)
    {
        useAlternativePrefix = toggleState;
    }

    #endregion

    protected override async Task OnInitializedAsync()
    {
        gameExtensions = await gameExtensionProvider.GetGameExtensionsAsync();

        FormModel ??= new CreateFormModel();
        editContext = new(FormModel);
        editContext.OnFieldChanged += HandleFieldChanged;

        _dotNetRef = DotNetObjectReference.Create(this);

        _messageStore = new ValidationMessageStore(editContext);

        isLoading = false;
    }

    private void HandleFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        if (editContext is null || FormModel is null)
            return;

        if (FormModel.UnexpectedResponseFlag)
        {
            FormModel.UnexpectedResponseFlag = false;
            Utils.ManualModelValidator.ValidateModel(editContext, FormModel, _messageStore!, onlyModified: validateOnlyModified);
        }
        // Trigger validation when name textbox got a change
        else if (e.FieldIdentifier.FieldName is nameof(FormModel.Name))
        {
            if (FormModel.EntityAlreadyExistsFlag) FormModel.EntityAlreadyExistsFlag = false;

            Utils.ManualModelValidator.ValidateModel(editContext, FormModel, _messageStore!, onlyModified: validateOnlyModified);
        }
        // Trigger validation when game extension select got a change
        else if (e.FieldIdentifier.FieldName is nameof(FormModel.GeneralGameExtension))
        {
            Utils.ManualModelValidator.ValidateModel(editContext, FormModel, _messageStore!, onlyModified: validateOnlyModified);
        }
        // Trigger validation when alternative prefix textbox got a change
        else if (e.FieldIdentifier.FieldName is nameof(FormModel.AlternativeArmorPrefix))
        {
            Utils.ManualModelValidator.ValidateModel(editContext, FormModel, _messageStore!, onlyModified: validateOnlyModified);
        }
        // Trigger validation when helmet textbox got a change
        else if (e.FieldIdentifier.FieldName is nameof(FormModel.HelmetSuffix))
        {
            Utils.ManualModelValidator.ValidateModel(editContext, FormModel, _messageStore!, onlyModified: validateOnlyModified);
        }
        // Trigger validation when mail textbox got a change
        else if (e.FieldIdentifier.FieldName is nameof(FormModel.MailSuffix))
        {
            Utils.ManualModelValidator.ValidateModel(editContext, FormModel, _messageStore!, onlyModified: validateOnlyModified);
        }
        // Trigger validation when greaves textbox got a change
        else if (e.FieldIdentifier.FieldName is nameof(FormModel.GreavesSuffix))
        {
            Utils.ManualModelValidator.ValidateModel(editContext, FormModel, _messageStore!, onlyModified: validateOnlyModified);
        }
    }

    private async Task StartExitAnimation(string elementId, string sectionName)
    {
        await jsRuntime.InvokeVoidAsync("startExitAnimation", elementId, _dotNetRef, sectionName);
    }

    private async Task ToggleArmorSet(bool value)
    {
        if (!value && showArmorSet)
        {
            await StartExitAnimation("animatedBox", "ArmorSet");
        }
        else if (value)
        {
            showArmorSet = true;
        }
        FormModel!.AddArmorSet = value;

        // Run validation after updating model
        Utils.ManualModelValidator.ValidateModel(editContext!, FormModel!, _messageStore!, onlyModified: validateOnlyModified);
    }

    private async Task ToggleInventoryEntries(bool value)
    {
        if (!value && showInventoryEntries)
        {
            await StartExitAnimation("animatedBox2", "InventoryEntries");
        }
        else if (value)
        {
            showInventoryEntries = true;
        }
        FormModel!.AddInventoryEntries = value;

        // Run validation after updating model
        Utils.ManualModelValidator.ValidateModel(editContext!, FormModel!, _messageStore!, onlyModified: validateOnlyModified);
    }

    private async Task ToggleArmorPrefix(bool value)
    {
        if (!value && showAlternativeArmorPrefix)
        {
            isExitingAlternativePrefix = true;
            await StartExitAnimation("animatedBox3", "AlternativeArmorPrefix");

            FormModel!.AlternativeArmorPrefix = string.Empty;
        }
        else if (value)
        {
            isExitingAlternativePrefix = false;
            showAlternativeArmorPrefix = true;

            FormModel!.AlternativeArmorPrefix = FormModel.Name;
        }

        FormModel!.UseAlternativeArmorPrefix = value;
    }

    [JSInvokable]
    public void OnAnimationComplete(string section)
    {
        if (section == "ArmorSet")
        {
            showArmorSet = false;
        }
        else if (section == "InventoryEntries")
        {
            showInventoryEntries = false;
        }
        else if (section == "AlternativeArmorPrefix")
        {
            isExitingAlternativePrefix = false;
            showAlternativeArmorPrefix = false;
        }

        StateHasChanged();
    }

    private async Task Submit()
    {
        // Run validation after updating model
        Utils.ManualModelValidator.ValidateModel(editContext!, FormModel!, _messageStore!, onlyModified: false);

        bool hasValidationErrors = editContext!.GetValidationMessages().Any();

        if (hasValidationErrors)
        {
            validateOnlyModified = false;

            Console.WriteLine("Not a valid Submit bruh");
            return;
        }
        else
        {
            validateOnlyModified = true;
        }

        CreateCategoryArmorInventoryEntryDTO dto = new()
            {
                Name = FormModel!.Name,
            };

        if (showArmorSet)
        {
            dto.GeneralGameExtensionId = FormModel.GeneralGameExtension!.Id;

            string armorPrefix = (FormModel!.UseAlternativeArmorPrefix ? FormModel.AlternativeArmorPrefix : FormModel.ArmorPrefix) + " ";

            dto.ArmorSet = [];

            dto.ArmorSet.Add(new ArmorModel
                {
                    Name = armorPrefix + FormModel!.HelmetSuffix,
                    ArmorType = ArmorType.Head
                });

            dto.ArmorSet.Add(new ArmorModel
                {
                    Name = armorPrefix + FormModel!.MailSuffix,
                    ArmorType = ArmorType.Chest
                });

            dto.ArmorSet.Add(new ArmorModel
                {
                    Name = armorPrefix + FormModel!.GreavesSuffix,
                    ArmorType = ArmorType.Legs
                });
        }

        if (showInventoryEntries)
        {
            dto.InventoryEntries = [];

            foreach (InventoryEntryCardModel model in inventoryEntryList!.FormModel!.SelectedCommonInventoryEntries)
            {
                dto.InventoryEntries.Add(new InventoryEntryModel
                    {
                        Name = model.ExtendedName == string.Empty ? model.Name : model.ExtendedName,
                        GameExtension = model.GameExtension!
                    });
            }

            foreach (InventoryEntryCardModel model in inventoryEntryList!.FormModel!.UncommonInventoryentries)
            {
                dto.InventoryEntries.Add(new InventoryEntryModel
                    {
                        Name = model.ExtendedName == string.Empty ? model.Name : model.ExtendedName,
                        GameExtension = model.GameExtension!
                    });
            }
        }

        try
        {
            await multiProvider.CreateCategoryArmorInventoryEntryAsync(dto);
        }
        catch (EntityAlreadyExistsException)
        {
            FormModel.EntityAlreadyExistsFlag = true;
            Utils.ManualModelValidator.ValidateModel(editContext!, FormModel!, _messageStore!, onlyModified: false);
        }
        catch (UnexpectedResponseException)
        {
            FormModel.UnexpectedResponseFlag = true;
            Utils.ManualModelValidator.ValidateModel(editContext!, FormModel!, _messageStore!, onlyModified: false);
        }
    }

    private void InvalidSubmit()
    {
        Console.WriteLine("%%%%%%%%%%%%%%%%%%%%");
        Console.WriteLine();
        Console.WriteLine("Invalid Submit");
        Console.WriteLine();
        Console.WriteLine("%%%%%%%%%%%%%%%%%%%%");
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
        
        if (editContext is not null)
            editContext.OnFieldChanged -= HandleFieldChanged;
    }
}
