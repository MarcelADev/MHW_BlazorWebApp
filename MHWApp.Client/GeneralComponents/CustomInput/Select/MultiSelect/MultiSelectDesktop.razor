@using System.Diagnostics.CodeAnalysis
@using MHWApp.Client.GeneralComponents.FormFieldHolder
@inherits InputBase<List<T>>
@typeparam T
@inject IJSRuntime js
@implements IAsyncDisposable

<SelectHolder Label="@Label" LabelId="@LabelId" For="ValueExpression">

    <div @ref="_multiSelectElementRef"
         aria-labelledby="@LabelId"
         class="multi-select@(ValidationClass + (IsOpen ? " open" : string.Empty))">

        <div class="multi-select__trigger@(Disabled ? " disabled" : string.Empty)"
             tabindex="@TabIndex"
             aria-disabled="@Disabled"
             @onclick="HandleTriggerClicked"
             @onkeydown="HandleTriggerKeyDown">

            <div class="multi-select__trigger-content">
                @if (Value is not null && Value.Count > 0)
                {
                    @foreach (var value in Value)
                    {
                        <button type="button"
                                class="multi-select__trigger-content-chip"
                                tabindex="-1"
                                @onclick:stopPropagation="true"
                                @onclick="() => RemoveValue(value)">
                            @OptionNameMapper(value)
                            <span class="material-symbols-outlined multi-select__trigger-content-chip-icon">close</span>
                        </button>
                    }
                }
                else
                {
                    @Placeholder
                }
            </div>

            <span class="material-symbols-outlined multi-select__trigger-icon">keyboard_arrow_down</span>
        </div>

        <div class="multi-select__dropdown"
             tabindex="-1">
            @for (int i = 0; i < Options.Count; i++)
            {
                var option = Options[i];
                string optionId = @OptionId + $"-{i}";
                int tempI = i;

                <label id="@optionId"
                       class="multi-select__option-label"
                       tabindex="@OptionsTabIndex"
                       @onkeydown="e => HandleOptionKeyDown(e, option, tempI)">
                    <input type="checkbox"
                           name="@Id"
                           disabled="@Disabled"
                           checked="@IsSelected(option)"
                           tabindex="-1"
                           @onchange="() => HandleCheckboxChange(option, tempI)" />
                    @OptionNameMapper(option)

                    @if (IsSelected(option))
                    {
                        <span class="material-symbols-outlined multi-select__option-icon">check</span>
                    }
                </label>
            }
        </div>
    </div>
</SelectHolder>

@code {
    private bool IsOpen { get; set; } = false;
    private Lazy<IJSObjectReference> _module = new();
    private DotNetObjectReference<MultiSelectDesktop<T>>? _dotNetRef;
    private ElementReference _multiSelectElementRef;

    [Parameter, EditorRequired] public string Id { get; set; } = default!;
    [Parameter, EditorRequired] public string LabelId { get; set; } = default!;
    [Parameter, EditorRequired] public string OptionId { get; set; } = default!;
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Placeholder { get; set; } = string.Empty;
    [Parameter] public bool Disabled { get; set; }

    [Parameter, EditorRequired] public List<T> Options { get; set; } = new();
    [Parameter, EditorRequired] public Func<T, object> OptionValueMapper { get; set; } = default!;
    [Parameter, EditorRequired] public Func<T, string> OptionNameMapper { get; set; } = default!;

    // Forwarded InputBase state
    private bool HasLabel => !string.IsNullOrWhiteSpace(Label);
    private string TabIndex => Disabled ? "-1" : "0";
    private string OptionsTabIndex => Disabled ? "-1" : IsOpen ? "0" : "-1";

    private int _focusedOptionIndex = 0;
    private int FocusedOptionIndex
    {
        get => _focusedOptionIndex;
        set
        {
            if (value < 0)
            {
                _focusedOptionIndex = Options.Count - 1;
            }
            else if (value >= Options.Count)
            {
                _focusedOptionIndex = 0;
            }
            else
            {
                _focusedOptionIndex = value;
            }
            StateHasChanged();
        }
    }

    private bool IsSelected(T option)
    {
        var optionValue = OptionValueMapper(option);

        return Value.Any(value =>
            Equals(OptionValueMapper(value), optionValue));
    }

    private void HandleCheckboxChange(T option, int index)
    {
        var newValue = Value.ToList();

        if (newValue.Contains(option))
        {
            newValue.Remove(option);
        }
        else
        {
            newValue.Add(option);
        }

        FocusedOptionIndex = index;
        CurrentValue = newValue;
    }

    private void RemoveValue(T option)
    {
        var newValue = Value!.ToList();

        if (newValue.Contains(option))
        {
            newValue.Remove(option);
        }
        newValue.Remove(option);
        CurrentValue = newValue;
    }

    private string ValidationClass => GetValidationCss();

    private string GetValidationCss(){
        string cssClasses = string.Empty;

        if (EditContext is null) return string.Empty;

        if (EditContext.GetValidationMessages(FieldIdentifier).Any()) return " invalid";

        if (!EditContext.IsModified(FieldIdentifier)) return string.Empty;

        if (CssClass.Contains("valid")) return " valid";

        return string.Empty;
    }

    private void HandleTriggerClicked()
    {
        if (Disabled)
        {
            IsOpen = false;
            return;
        }
        IsOpen = !IsOpen;

        if (IsOpen)
        {
            _ = OpenDropDown();
        }
        else
        {
            _ = CollapseDropDown();
        }
    }

    private async Task HandleTriggerKeyDown(KeyboardEventArgs e)
    {
        if (Disabled)
        {
            IsOpen = false;
            return;
        }

        if (e.Key is "Enter" or " " or "ArrowDown")
        {
            if (!IsOpen)
            {
                _ = OpenDropDown();
                await ChangeFocusedElement();
            }
        }
        else if (e.Key is "Escape" && IsOpen)
        {
            if (IsOpen) _ = CollapseDropDown();
        }
    }

    private async Task HandleOptionKeyDown(KeyboardEventArgs e, T option, int index)
    {
        switch (e.Key)
        {
            case "Enter":
            case " ":
                HandleCheckboxChange(option, index);
                break;
            case "Tab":
                await HandleTabKeyPressed();
                break;
            case "ArrowUp":
            case "ArrowLeft":
                FocusedOptionIndex--;
                await ChangeFocusedElement();
                break;
            case "ArrowDown":
            case "ArrowRight":
                FocusedOptionIndex++;
                await ChangeFocusedElement();
                break;
        }
    }

    private async Task HandleTabKeyPressed()
    {
        FocusedOptionIndex++;
        if (FocusedOptionIndex == 0)
        {
            _ = CollapseDropDown();
        }
    }

    private async Task AddMousClickListener()
    {
        await _module.Value.InvokeVoidAsync("addMouseClickListener", _multiSelectElementRef, _dotNetRef);
    }

    private async Task RemoveMouseClickListener()
    {
        await _module.Value.InvokeVoidAsync("removeMouseClickListener");
    }

    private async Task ChangeFocusedElement()
    {
        await _module.Value.InvokeVoidAsync("changeFocusedElement", _multiSelectElementRef, FocusedOptionIndex, OptionId);
    }

    private async Task OpenDropDown()
    {
        IsOpen = true;
        FocusedOptionIndex = 0;
        await AddMousClickListener();
    }

    private async Task CollapseDropDown()
    {
        IsOpen = false;
        FocusedOptionIndex = 0;
        await RemoveMouseClickListener();
    }

    [JSInvokable]
    public async Task HandleOutsideClick()
    {
        if (!IsOpen) return;

        _ = CollapseDropDown();

        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = new(await js.InvokeAsync<IJSObjectReference>("import", "./GeneralComponents/CustomInput/Select/MultiSelect/MultiSelectDesktop.razor.js"));
            _dotNetRef = DotNetObjectReference.Create(this);
        }
    }

    protected override bool TryParseValueFromString(string? value, [MaybeNullWhen(false)] out List<T> result, [NotNullWhen(false)] out string? validationErrorMessage)
    {
        result = new List<T>();
        validationErrorMessage = "MultiSelect does not support string conversion.";

        return false;
    }

    public async ValueTask DisposeAsync()
    {
        if (_module.IsValueCreated)
        {
            await _module.Value.DisposeAsync();
        }
    }
}