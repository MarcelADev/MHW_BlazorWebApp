@using MHWApp.Client.GeneralComponents.FormFieldHolder
@inject IJSRuntime JS
@implements IAsyncDisposable

<CheckboxWithToggleContainerHolder>
    <label for="@CheckboxId">
        <input id="@CheckboxId" type="checkbox" disabled="@Disabled" @bind="@IsOpen">
        @Label
    </label>

    <div id="@WrapperId" class="toggle-container__wrapper @(IsOpen ? "open" : "close")">
        <div class="toggle-container__content">
            @ChildContent
        </div>
    </div>
</CheckboxWithToggleContainerHolder>

@code {
    private string? _guid;
    private Lazy<IJSObjectReference> CheckboxWithToggleContainerModule = new();

    public string Guid => _guid ??= Convert.ToHexStringLower(System.Guid.NewGuid().ToByteArray());
    public string CheckboxId => $"checkbox-toggle-{Guid}";
    public string WrapperId => $"checkbox-toggle-wrapper-{Guid}";

    /// <summary>
    /// The content of the label for the checkbox.
    /// </summary>
    [Parameter]
    public required string Label { get; set; } = "Toggle checkbox";

    /// <summary>
    /// Content to be displayed when the toggle is active.
    /// </summary>
    [Parameter] 
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Event hook that can be used by the parent component to respond to toggle state changes.
    /// </summary>
    [Parameter]
    public EventCallback<bool> OnToggleChanged { get; set; }

    /// <summary>
    /// Set this to true to disable the checkbox and prevent user interaction
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; } = false;

    private bool _isOpen = false;
    /// <summary>
    /// Stores toggle state.
    /// </summary>
    private bool IsOpen
    {
        get { return _isOpen; }
        set
        {
            if (_isOpen != value)
            {
                _isOpen = value;
                NotifyToggleStateChanged();
				_ = ToggleOverflowVisibility();
            }
        }
    }

    void NotifyToggleStateChanged()
    {
        OnToggleChanged.InvokeAsync(IsOpen);
    }

    private async Task ToggleOverflowVisibility()
    {
        await CheckboxWithToggleContainerModule.Value.InvokeVoidAsync("toggleOverflowVisibility", IsOpen, WrapperId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            CheckboxWithToggleContainerModule = new(await JS.InvokeAsync<IJSObjectReference>("import", "./GeneralComponents/CustomInput/CheckboxWithToggleContainer.razor.js"));
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (CheckboxWithToggleContainerModule.IsValueCreated)
        {
            await CheckboxWithToggleContainerModule.Value.DisposeAsync();
        }
    }
}