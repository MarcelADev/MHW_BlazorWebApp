@using System.Linq.Expressions
@using MHWApp.Client.GeneralComponents.FormFieldHolder
@typeparam T
@inject IJSRuntime js
@implements IAsyncDisposable

<InputSingleSelectDesktopHolder Label="@Label" LabelId="@LabelId">

    <div @ref="_singleSelectElementRef"
         aria-labelledby="@LabelId"
         class="single-select@(ValidationClass + (IsOpen ? " open" : string.Empty))">

        <div class="single-select__trigger@(Disabled ? " disabled" : string.Empty)"
             tabindex="@TabIndex"
             aria-disabled="@Disabled"
             @onclick="HandleTriggerClicked"
             @onkeydown="HandleTriggerKeyDown">

            <div class="single-select__trigger-content">
                @if (Value is not null)
                {
                    @OptionNameMapper(Value!)
                }
                else
                {
                    @Placeholder
                }
            </div>

            <span class="material-symbols-outlined single-select__trigger-icon">keyboard_arrow_down</span>
        </div>

        <div class="single-select__dropdown"
             tabindex="1">
            @foreach (var option in Options)
            {
                <div class="single-select__option">
                    <label class="single-select__option-label">
                        <input type="radio"
                               name="@Id"
                               disabled="@Disabled"
                               checked="@IsSelected(option)"
                               @onchange="() => HandleRadioChange(option)"/>
                        @OptionNameMapper(option)
                    </label>

                    @if (IsSelected(option))
                    {
                        <span class="material-symbols-outlined">check</span>
                    }
                </div>
            }
        </div>
    </div>
</InputSingleSelectDesktopHolder>

@code {
    private bool IsOpen { get; set; } = false;
    private Lazy<IJSObjectReference> _module = new();
    private DotNetObjectReference<InputSingleSelectDesktop<T>>? _dotNetRef;
    private ElementReference _singleSelectElementRef;

    [Parameter, EditorRequired] public string Id { get; set; } = default!;
    [Parameter, EditorRequired] public string LabelId { get; set; } = default!;
    [Parameter, EditorRequired] public string OptionId { get; set; } = default!;
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Placeholder { get; set; } = string.Empty;
    [Parameter] public bool Disabled { get; set; }

    [Parameter, EditorRequired] public List<T> Options { get; set; } = new();
    [Parameter, EditorRequired] public Func<T, object> OptionValueMapper { get; set; } = default!;
    [Parameter, EditorRequired] public Func<T, string> OptionNameMapper { get; set; } = default!;

    // Forwarded InputBase state
    [Parameter] public T? Value { get; set; }
    [Parameter] public EventCallback<T?> ValueChanged { get; set; }
    [Parameter] public Expression<Func<T?>>? ValueExpression { get; set; }
    [Parameter] public EditContext? EditContext { get; set; }
    [Parameter] public FieldIdentifier FieldIdentifier { get; set; }
    [Parameter] public string CssClass { get; set; } = string.Empty;

    private bool HasLabel => !string.IsNullOrWhiteSpace(Label);
    private string TabIndex => Disabled ? "-1" : "0";

    private bool IsSelected(T option)
        => Value is not null && EqualityComparer<T>.Default.Equals(Value, option);

    private void HandleTriggerClicked()
    {
        if (Disabled) {
            IsOpen = false;
            return;
        }
        IsOpen = !IsOpen;

        if (IsOpen)
        {
            _ = AddMousClickListener();
        }
        else
        {
            _ = RemoveMousClickListener();
        }
    }

    private async Task HandleTriggerKeyDown(KeyboardEventArgs e)
    {
        if (Disabled)
        {
            IsOpen = false;
            return;
        }

        if (e.Key is "Enter" or " " or "ArrowDown")
        {
            if (!IsOpen)
            {
                IsOpen = true;
                await AddMousClickListener();
            }
        }

        if (e.Key is "Escape")
        {
            IsOpen = false;
            await RemoveMousClickListener();
        }
    }

    private async Task HandleRadioChange(T option)
    {
        if (!IsSelected(option))
        {
            await ValueChanged.InvokeAsync(option);
            EditContext?.NotifyFieldChanged(FieldIdentifier);
        }
    }

    private string ValidationClass => GetValidationCss();

    private string GetValidationCss(){
        string cssClasses = string.Empty;

        if (EditContext is null) return string.Empty;

        if (EditContext.GetValidationMessages(FieldIdentifier).Any()) return " invalid";

        if (!EditContext.IsModified(FieldIdentifier)) return string.Empty;

        if (CssClass.Contains("valid")) return " valid";

        return string.Empty;
    }

    private async Task AddMousClickListener()
    {
        await _module.Value.InvokeVoidAsync("addMouseClickListener", _singleSelectElementRef, _dotNetRef);
    }

    private async Task RemoveMousClickListener()
    {
        await _module.Value.InvokeVoidAsync("removeMouseClickListener");
    }

    [JSInvokable]
    public async Task HandleOutsideClick()
    {
        if (!IsOpen) return;

        IsOpen = false;
		_ = RemoveMousClickListener();

        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = new(await js.InvokeAsync<IJSObjectReference>("import", "./GeneralComponents/CustomInput/InputSingleSelect/InputSingleSelectDesktop.razor.js"));
            _dotNetRef = DotNetObjectReference.Create(this);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module.IsValueCreated)
        {
            await _module.Value.DisposeAsync();
        }
    }
}