@using MHWApp.Client.Services
@using MHWApp.Client.Services.Interfaces
@using static MHWApp.Client.Services.GlobalAlertService
@inject IGlobalAlertService alertService
@implements IDisposable

<div class="alert-container">
    @foreach (var alert in alertService.Alerts)
    {
        if (alert.Type == AlertType.Success)
        {
            <div class="alert alert-success">

                <span class="material-symbols-outlined alert-icon">
                    check
                </span>

                @alert.Message

            </div>
        }
        else if (alert.Type == AlertType.Info)
        {
            <div class="alert alert-info">

                <span class="material-symbols-outlined alert-icon">
                    info
                </span>

                @alert.Message

            </div>
        }
        else if (alert.Type == AlertType.Warning || alert.Type == AlertType.Danger)
        {
            var cssClass = alert.Type == AlertType.Warning ? "alert-warning" : "alert-danger";
            <div class="alert @cssClass">

                <span class="material-symbols-outlined alert-icon">
                    warning
                </span>

                @alert.Message

            </div>
        }
        else if (alert.Type == AlertType.PrimeVu)
        {
            <div class="alert alert-warning alert-prime-vu">

                <div class="prime-vu__container">
                    <div class="prime-vu__golden-text">@alert.Message</div>
                    <div class="prime-vu__text-shadow">@alert.Message</div>
                </div>

            </div>
        }
    }
</div>

@code {
    protected override void OnInitialized()
    {
        alertService.TriggerStateHasChanged += HandleAlertChanged;
    }

    private void HandleAlertChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        alertService.TriggerStateHasChanged -= HandleAlertChanged;
    }
}
