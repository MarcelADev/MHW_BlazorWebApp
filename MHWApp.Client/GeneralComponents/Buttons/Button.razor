@using MHWApp.Client.GeneralComponents.FormFieldHolder
@if (!isLoading)
{
    <ButtonHolder IsSubmitButton="IsSubmit">
        @if(Icon.Equals(string.Empty))
        {
            <button type="@(IsSubmit ? "submit" : "button")" 
                    class="button__base@_cssClasses"
                    @onclick="OnButtonClicked">
                @Content
            </button>
        }
        else
        {
            <button type="@(IsSubmit ? "submit" : "button")" 
                    class="button__base button__flex@_cssClasses"
                    @onclick="OnButtonClicked">

                <div class="button__icon-container">
                    <span class="material-symbols-outlined button__icon">
                        @Icon
                    </span>
                </div>
            
                <div class="button__content-container">
                    @Content
                </div>

            </button>
        }
    </ButtonHolder>
}

@code {
    private bool isLoading = true;
    private string _cssClasses = string.Empty;

    [Parameter]
    public required string Content { get; set; }

    [Parameter]
    public EventCallback ButtonClicked { get; set; }

    [Parameter]
    public bool Secondary { get; set; } = false;

    [Parameter]
    public bool Muted { get; set; } = false;

    [Parameter]
    public string Icon { get; set; } = string.Empty;

    [Parameter]
    public bool IsSubmit { get; set; } = false;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        if (Secondary) _cssClasses += " button__secondary";
        if (Muted) _cssClasses += " button__muted";

        isLoading = false;
    }

    private async Task OnButtonClicked()
    {
        await ButtonClicked.InvokeAsync();
    }
}