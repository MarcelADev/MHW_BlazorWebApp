@using MHWApp.Client.GeneralComponents.FormFieldHolder

<IconButtonHolder Label="@Label" InputId="@Id">
	<button id="@Id"
			class="icon-button container-center@(Muted ? " muted" : "")" 
			type="@(IsSubmit ? "submit" : "button")" @onclick="OnIconButtonClicked"
			aria-pressed="@(IsPressed ? "true" : "false")">
	
		<p class="icon-button__placeholder">O</p>
	
		<span class="material-symbols-outlined">
			@Icon
		</span>
	</button>
</IconButtonHolder>

@code {
	private string? _id;

	public string Id => _id ??= $"icon-button__{Convert.ToHexStringLower(Guid.NewGuid().ToByteArray())}";

	[Parameter]
	public required string Icon { get; set; }

	[Parameter]
	public required EventCallback IconButtonClicked { get; set; }

	[Parameter]
	public bool IsSubmit { get; set; } = false;

	[Parameter]
	public bool Muted { get; set; } = false;

	[Parameter]
	public bool IsPressed { get; set; } = false;

	[Parameter]
	public string Label { get; set; } = string.Empty;

	private async Task OnIconButtonClicked()
	{
		await IconButtonClicked.InvokeAsync();
	}
}
