<button class="container-center @(AlternativeDesign ? "alternative" : "")" type="button" @onclick="OnEditButtonClicked">
	<span class="material-symbols-outlined @(AlternativeDesign ? "alternative" : "") @(Glow ? "glow" : "")">
		edit
	</span>
</button>

@code {
	[Parameter]
	public required EventCallback EditButtonClicked { get; set; }

	[Parameter]
	public bool AlternativeDesign { get; set; } = false;

	[Parameter]
	public bool Glow { get; set; } = false;

	private async Task OnEditButtonClicked()
	{
		await EditButtonClicked.InvokeAsync();
	}
}
