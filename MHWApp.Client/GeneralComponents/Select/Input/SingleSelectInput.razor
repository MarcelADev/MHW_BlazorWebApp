@using MHWApp.Library.Model
@inject IJSRuntime JSRuntime
@inject ILogger<SingleSelectInput<T>> Logger
@typeparam T
@inherits SelectInputBase<T>

@if (os == "Android" || os == "iOS")
{
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label for="select">@Label</label>
    }
    <select name="select"
            class="@CssClass"
            @attributes="AdditionalAttributes"
            @onchange="HandleNativeChange">
        <option value="">@Placeholder</option>
        @foreach (var option in Options)
        {
            <option value="@OptionValueMapper(option)" selected="@IsSelected(option, Value)">
                @OptionNameMapper(option)
            </option>
        }
    </select>
}
else
{
    <div class="single-select__anchor">
        @if (!string.IsNullOrWhiteSpace(Label))
        {
            <label id="@Id-label"
                   @onclick:preventDefault="@Disabled"
                   @onclick:stopPropagation="@Disabled"
                   @attributes="labelAttributes">
                @Label
            </label>
        }

        <div id="mhwapp-single-select-@Id"
             class="@($"single-select{GetCSSClassesForSingleSelect()}")"
             aria-labelledby="@Id-label"
             @attributes="AdditionalAttributes">

            <div class="single-select__trigger @(Disabled ? "disabled" : "")"
                 tabindex="@(Disabled ? -1 : 0)"
                 aria-disabled="@Disabled">

                <div class="single-select__trigger-content">
                    @if (Value is not null)
                    {
                        @OptionNameMapper(Value)
                    }
                    else
                    {
                        @Placeholder
                    }
                </div>

                <span class="material-symbols-outlined single-select__trigger-icon">keyboard_arrow_down</span>
                
            </div>


            <div class="single-select__dropdown" tabindex="@(Disabled ? -1 : 0)">
                @foreach (var option in Options)
                {
                    <div class="single-select__option">
                        <label class="single-select__option-label">
                            <input type="checkbox"
                                   class="single-select__option-label-hidden"
                                   checked="@IsSelected(option, Value)"
                                   id="select-@Id-@(OptionValueMapper(option))"
                                   name="select-@(OptionValueMapper(option))"
                                   disabled="@Disabled"
                                   @onchange="(_) => HandleCustomChange(option)" />
                            @OptionNameMapper(option)
                        </label>
                        @if (IsSelected(option, Value))
                        {
                            <span class="material-symbols-outlined single-select__option-icon">check</span>
                        }
                    </div>
                }
            </div>
        </div>

        <input type="text"
               hidden
               class="@CssClass"
               @bind="CurrentValueAsString"
               @attributes="AdditionalAttributes" />
    </div>
}
