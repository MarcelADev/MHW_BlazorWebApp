@using MHWApp.Client.GeneralComponents.Select.Component
@using MHWApp.Library.DTO
@using MHWApp.Library.Exceptions
@using MHWApp.Library.Model
@using MHWApp.Client.GeneralComponents.Select
@using MHWApp.Client.Pages.MainMenu.CreateSession
@using MHWApp.Client.Provider
@using static MHWApp.Library.StaticVariables
@inject ParticipatorProvider participatorProvider
@inject PlayerProvider playerProvider
@inject WeaponProvider weaponProvider
@inject SessionProvider sessionProvider
@implements IDisposable

<div class="modal-backdrop show"></div>
<div class="modal fade show" style="display:block" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Edit @Session.Name</h5>
                <button @onclick="OnCloseButtonClicked" type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            @if (!isLoading)
            {
                <AuthorizeView>
                    <Authorized Context="authContext">
                        @{
                            bool isAdmin = authContext.User.IsInRole(ADMIN_ROLE) || authContext.User.IsInRole(MASTER_ROLE);
                        }
                        <div class="form__container">
                            <EditForm EditContext="editContext" FormName="editSession" OnValidSubmit="Submit">
                                <DataAnnotationsValidator />
                                <ValidationSummary />

                                <div class="modal-body">
                                    <div class="form__field">
                                        <label for="editSession-name">Change Name</label>
                                        <InputText id="editSession-name" @bind-Value="Model!.NewName"></InputText>
                                    </div>

                                    <div class="form__field">
                                        <label>Change Day Counters</label>
                                        <div class="days__container">

                                            <div class="days__input">
                                                <InputNumber @bind-Value="Model!.NewDayCount"
                                                             AdditionalAttributes="@(new Dictionary<string, object>
                                                             {
                                                                 ["id"] = "editSession-dayCount",
                                                                 ["min"] = "1",
                                                             })" />
                                            </div>

                                            <label class="slash">/</label>

                                            <div class="days__input">
                                                <InputNumber @bind-Value="Model!.NewMaxDays"
                                                             AdditionalAttributes="@(new Dictionary<string, object>
                                                             {
                                                                 ["id"] = "editSession-maxDays",
                                                                 ["min"] = "1"
                                                             })" />
                                            </div>

                                        </div>
                                    </div>

                                    @if (isAdmin)
                                    {
                                        @if (!participatorsIsEmpty)
                                        {
                                            <MultiSelectComponent Label="Remove Participators"
                                            Placeholder="Select"
                                            T="Participator"
                                            Options="participators"
                                            OptionNameMapper="(Participator p) => p != null ? p.Player?.UserName : string.Empty"
                                            OptionValueMapper="(Participator p) => p.Id"
                                            ValueList="Model.RemoveParticipators"
                                            ValueListChanged="HandleRemoveSelect">
                                            </MultiSelectComponent>
                                        }

                                        @if (!playersIsEmpty)
                                        {
                                            <MultiSelectComponent Label="Add Participators"
                                            Placeholder="Select"
                                            T="Player"
                                            Options="players"
                                            OptionNameMapper="(Player p) => p.UserName"
                                            OptionValueMapper="(Player p) => p.Id"
                                            ValueList="Model.PlayerValueList"
                                            ValueListChanged="HandleAddSelect">
                                            </MultiSelectComponent>
                                        }

                                        @for (var i = 0; i < Model!.AddParticipators.Count; i++)
                                        {
                                            var participator = Model!.AddParticipators[i];

                                            @if (Model!.PlayerIds.Contains(participator.PlayerId))
                                            {
                                                <div class="form__field">
                                                    <ParticipatorCard @bind-Participator="participator" 
                                                    weaponTypes="weaponTypes"/>
                                                </div>
                                            }
                                        }
                                    }
                                </div>

                                <div class="modal-footer">
                                    <button type="button" class="btn btn-primary inverted" @onclick="OnResetFormButtonClicked">
                                        Reset Form
                                    </button>

                                    <button type="submit" class="btn btn-primary purple">
                                        Save changes
                                    </button>
                                </div>

                            </EditForm>
                        </div>
                    </Authorized>
                </AuthorizeView>
            }
        </div>
    </div>
</div>

@code{
    private bool isLoading = true;
    private bool isFormValid = true;
    private bool participatorsIsEmpty = true;
    private bool playersIsEmpty = true;

    private EditContext? editContext;

    private List<Participator>? participators;
    private List<Player>? players;
    private List<WeaponType> weaponTypes = [];

    [SupplyParameterFromForm]
    private EditSessionModalFormModel? Model { get; set; }

    [Parameter]
    public required Session Session { get; set; }

    [Parameter]
    public required EventCallback CloseModal { get; set; }

    protected override async Task OnInitializedAsync()
    {
        participators = await participatorProvider.GetParticipatorsAsync(Session.Id);
        if (participators.Any()) participatorsIsEmpty = false;

        players = (await playerProvider.GetPlayersAsync()).Where(p => !participators.Any(pa => pa.PlayerId == p.Id)).ToList();
        if (players.Any()) playersIsEmpty = false;

        weaponTypes = await weaponProvider.GetWeaponTypesAsync();

        Model = new EditSessionModalFormModel(Session.Name, Session.DayCount, Session.MaxDays);
        editContext = new(Model);
        editContext.OnFieldChanged += HandleFieldChanged;

        isLoading = false;
        StateHasChanged();
    }

    private void OnCloseButtonClicked()
    {
        CloseModal.InvokeAsync();
    }

    private void OnResetFormButtonClicked()
    {
        if (Model is null) return;

        Model!.NewName = Model.CurrentName;
        Model.NewMaxDays = Model.CurrentMaxDays;
        Model.NewDayCount = Model.CurrentDayCount;

        Model.RemoveParticipators = [];
        Model.AddParticipators = [];
        Model.PlayerValueList = [];
        StateHasChanged();
    }

    private void HandleRemoveSelect(List<Participator> participators)
    {
        isFormValid = !editContext!.Validate();
        StateHasChanged();
    }

    private void HandleAddSelect(List<Player> players)
    {
        Model!.PlayerIds = players.Select(p => p.Id).ToArray();

        Model!.AddParticipators.RemoveAll(pa => !Model!.PlayerIds.Contains(pa.PlayerId));
        Model!.AddParticipators.AddRange(
        players
        .FindAll(p => !Model.AddParticipators.Select(pa => pa.PlayerId).Contains(p.Id))
        .Select(p => new Participator()
            {
                Id = 0,
                SessionId = 0,
                Player = p,
                PlayerId = p.Id,
                WeaponType = weaponTypes.First(),
                WeaponTypeId = weaponTypes.First().Id,
            })
        );
        Model!.AddParticipators.Sort((lhs, rhs) => lhs.Player!.UserName!.CompareTo(rhs.Player!.UserName));

        StateHasChanged();
    }

    private void HandleFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        if (editContext is not null)
        {
            isFormValid = !editContext.Validate();
            StateHasChanged();
        }
    }

    private async Task Submit() => await ChangeSession();

    private async Task ChangeSession()
    {
        SessionUpdateDTO dto = new SessionUpdateDTO
        {
            UpdatedSession = new Session
            {
                Id = Session.Id,
                Name = Model!.NewName,
                Date = Session.Date,
                DayCount = Model.NewDayCount,
                MaxDays = Model.NewMaxDays
            },
            RemoveParticipators = Model.RemoveParticipators,
            AddParticipators = []
        };

        foreach (var participator in Model.AddParticipators) dto.AddParticipators.Add(participator.Clone());

        try
        {
            await sessionProvider.UpdateSessionAsync(dto);
            await CloseModal.InvokeAsync();
        }
        catch (EntityWasNotFoundException)
        {
            Model.EntityWasNullFlag = true;
            editContext!.Validate();
        }
        catch (UnexpectedResponseException)
        {
            Model.UnexpectedResponseFlag = true;
            editContext!.Validate();
        }
        StateHasChanged();
    }

    public void Dispose()
    {
        if (editContext is not null) editContext.OnFieldChanged -= HandleFieldChanged;
    }
}