@inject NavigationManager NavigationManager
@using MHWApp.Client.Layout.NavMenu.Components
@using MHWApp.Client.Layout.NavMenu.Model
@using static MHWApp.Library.StaticVariables

<nav>
    @* <ul> *@

        @foreach (NavItemBaseModel model in navItems!)
        {
            @* <li> *@
                @if(model is NavDropdownItemModel)
                {
                    <NavDropdownItem Model="model" />
                }
                else if(model is NavSingleLinkItemModel)
                {
                    <NavSingleLinkItem Model="model" />
                }
                else if(model is NavDummyItemModel)
                {
                    <NavDummyItem Model="model" />
                }
            @* </li> *@
        }

        @if (navItemAreLoaded){}
    @* </ul> *@
</nav>

