@using MHWApp.Client.Layout.Model
@inject NavigationManager navigationManager

@if(NavItemModel.HasOptions)
{
    <div id="@NavDropDownID" class="nav__item nav__dropdown">

        @if(NavItemModel.IsLink)
        {
            <div class="nav__tag">
                <a href="@NavItemModel.RedirectPath">@NavItemModel.Title</a>
            </div>
        }
        else
        {
            <p class="nav__tag">@NavItemModel.Title</p>
        }

        <div class="nav__dropdown-menu-outer">
            <ul id="@NavDropDownMenuID" class="nav__dropdown-menu">
                @foreach (NavItemModel navItemModel in NavItemModel.Options)
                {
                    if (navItemModel.IsLink)
                    {
                        <li @onclick="@(() => navigationManager.NavigateTo(navItemModel.RedirectPath!))">@navItemModel.Title</li>
                    }
                    else
                    {
                        <li>@navItemModel.Title</li>
                    }
                }
            </ul>
        </div>
    </div>
}
else
{
    <div class="nav__item">
        @NavItemModel.Title
    </div>
}

@code {
    private bool isOpen = false;

    [Parameter]
    public required NavItemModel NavItemModel { get; set; }

    private string ID => NavItemModel.Title.ToLower().Replace(' ', '-');
    private string NavDropDownID => ID + "-nav-dropdown";
    private string NavDropDownMenuID => ID + "-nav-dropdown-menu";

    /// <summary>
    /// Disables interaction with the select.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }
}