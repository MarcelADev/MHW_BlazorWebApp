@page "/"
@using Microsoft.EntityFrameworkCore
@using MyMHWApp.Components.Models
@using MyMHWApp.Data
@inject InventoryDBContext DbContext

<h3>Inventory</h3>

@if(entries == null || entries.Count == 0){
    <p>List is empty</p>
}
else{
    <ul>
        @foreach (var entry in entries)
        {
            <li>
                <InventoryEntryComponent EntryName="@entry.EntryName" Counter="@entry.Counter"></InventoryEntryComponent>
            </li>
        }
    </ul>
}

@code {
    private List<InventoryEntry> entries = new List<InventoryEntry>();

    protected override async Task OnInitializedAsync()
    {
        entries = await DbContext.InventoryEntries.ToListAsync();
    }
}