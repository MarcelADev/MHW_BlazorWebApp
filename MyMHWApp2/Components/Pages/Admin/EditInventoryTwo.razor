@page "/admin/inventory2"
@using MyMHWApp2.Components.Modals
@using MyMHWApp2.Components.Models
@using MyMHWApp2.Data.Services
@inject EntryServiceTesting entryService

<h3>EditInventoryTwo</h3>

@if(_entries == null || _entries.Count() == 0)
{
	<p>Loading...</p>
}
else
{
	@foreach (Entry entry in _entries)
	{
		<p>@entry.Name</p>
		<button @onclick="EditEntry">Edit</button>
	}
}

<EditEntryModal @ref="editEntryModal"></EditEntryModal>

@code {
	List<Entry> _entries = [];

	private EditEntryModal editEntryModal;

	protected override async Task OnInitializedAsync()
	{
		_entries = await entryService.GetEntriesAsync();
	}

	public void EditEntry(){
		editEntryModal.Show();
	}

	private async Task OnEditConfirmed(Entry entry, string newName){
		entry.Name = newName;
	}
}
